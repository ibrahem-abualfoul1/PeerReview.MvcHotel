            </li>
            <li class="nav-item dropdown">
              <a class="nav-link " href="javascript:void(0)" id="drop1" data-bs-toggle="dropdown" aria-expanded="false">
                +
                </a>
            </li>
          </ul>
          <div class="navbar-collapse justify-content-end align-items-center gap-2 px-0" id="navbarNav">
              <div class="btn-group" role="group" aria-label="Language toggle">
                  <form asp-controller="Language" asp-action="Set" method="post" class="d-inline">
