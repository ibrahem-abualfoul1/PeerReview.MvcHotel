@using Microsoft.AspNetCore.Http
@inject Microsoft.Extensions.Localization.IStringLocalizer<PeerReview.MvcHotel.Resources.SharedResource> L

@{
    var userName = Context.Session.GetString("userName") ?? "";
    var userId = Context.Session.GetInt32("userId") ?? 0;
    var culture = System.Threading.CancellationToken.None; // ignore
    var ci = System.Globalization.CultureInfo.CurrentUICulture;
    var isRtl = ci.TwoLetterISOLanguageName == "ar";
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName" dir="@(isRtl ? "rtl" : "ltr")">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] - @L["AppTitle"]</title>
    <link rel="shortcut icon" type="image/png" href="~/assets/images/logos/logo_1.png" />
  <link rel="stylesheet" href="~/assets/css/styles.min.css" />
    <link rel="stylesheet" href="~/css/theme.css" />
    <style>
        body {
            direction: @(isRtl ? "rtl" : "ltr");
            text-align: @(isRtl ? "right" : "left");
        }

        .nav-link {
            color: white !important;
        }

        #main-wrapper[data-layout=vertical][data-sidebar-position=fixed] .left-sidebar{
            position: fixed;
            top: 1px !important;
        }
        .app-header2{
            position: relative;
            z-index: 50;
            width: 100%;
            background: var(--bs-body-bg);
            padding: 0 10px;
            top: 1px !important;
        }
    </style>
</head>

