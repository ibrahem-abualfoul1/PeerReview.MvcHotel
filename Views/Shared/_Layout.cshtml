                    <i class="ti ti-aperture"></i>
                  </span>
                  <span class="hide-menu">Quastions</span>
                </div>
              </a>
            </li>
            <li class="sidebar-item">
                            <a class="sidebar-link justify-content-between" target="_self"
                href="/Assignments/Index" aria-expanded="false">
                <div class="d-flex align-items-center gap-3">
                  <span class="d-flex">
                    <i class="ti ti-shopping-cart"></i>
                  </span>
                  <span class="hide-menu">Assign</span>
                </div>
              </a>
            </li>
                        <li class="sidebar-item">
                            <a class="sidebar-link justify-content-between" target="_self"
                               href="/Users/Index" aria-expanded="false">
                                <div class="d-flex align-items-center gap-3">
                                    <span class="d-flex">
                                        <i class="ti ti-shopping-cart"></i>
                                    </span>
