@using Microsoft.AspNetCore.Http
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer L

@{
    var userName = Context.Session.GetString("userName") ?? "";
    var userId = Context.Session.GetInt32("userId") ?? 0;
    var role = Context.Session.GetString("role") ?? "";

    var ci = System.Globalization.CultureInfo.CurrentUICulture;
    var isRtl = ci.TwoLetterISOLanguageName == "ar";
    var dir = isRtl ? "rtl" : "ltr";
    var lang = ci.TwoLetterISOLanguageName;
}

<!DOCTYPE html>
<html lang="@lang" dir="@dir" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - @L["AppTitle"]</title>

    <link rel="shortcut icon" type="image/png" href="~/assets/images/logos/logo_1.png" />

    <!-- Bootstrap (لو أنت أصلاً مستخدمه رح يضل شغال بشكل طبيعي) -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <!-- الثيم الجديد -->
    <link rel="stylesheet" href="~/css/peerreview-theme.css" />

    @RenderSection("Styles", required: false)
</head>
<body>
    <div class="app-shell">
        <!-- Sidebar -->
        <aside class="sidebar">
            <div>
                <div class="sidebar-brand">
                    <div class="sidebar-brand-logo">
                        <a href="@Url.Action("Index", "Home")">
                            <img src="~/assets/images/logos/logo_1.png"
                                 alt="Logo"
                                 style="width:100%;height:100%;object-fit:cover;" />
                        </a>
                    </div>
                    <div>
                        <div class="sidebar-brand-title">@L["AppName"]</div>
                        <div class="sidebar-brand-sub">
                            @L["Evaluation & Review System"]
                        </div>
                    </div>
                </div>

                <nav class="sidebar-nav">
                    @if(role == "Admin"){
                    <a class="sidebar-link @(ViewBag.ActiveMenu == "Dashboard" ? "active" : "")"
                       href="@Url.Action("Index", "Home")">
                        <span class="icon">📊</span>
                        <span>@L["Dashboard"]</span>
                    </a>

                    <a class="sidebar-link @(ViewBag.ActiveMenu == "Users" ? "active" : "")"
                       href="@Url.Action("Index", "Users")">
                        <span class="icon">👥</span>
                        <span>@L["Users"]</span>
                    </a>

                    <a class="sidebar-link @(ViewBag.ActiveMenu == "Questions" ? "active" : "")"
                       href="@Url.Action("Index", "Questions")">
                        <span class="icon">❓</span>
                        <span>@L["Questions"]</span>
                    </a>

                    <a class="sidebar-link @(ViewBag.ActiveMenu == "Assignments" ? "active" : "")"
                       href="@Url.Action("Index", "Assignments")">
                        <span class="icon">📝</span>
                        <span>@L["Assignments"]</span>
                    </a>

                    <a class="sidebar-link @(ViewBag.ActiveMenu == "Answers" ? "active" : "")"
                       href="@Url.Action("Mine", "Answers")">
                        <span class="icon">📥</span>
                        <span>@L["Answers"]</span>
                    </a>

                    <a class="sidebar-link @(ViewBag.ActiveMenu == "Scoring" ? "active" : "")"
                       href="@Url.Action("Index", "AnswerScoring")">
                        <span class="icon">⭐</span>
                        <span>@L["Scoring"]</span>
                    </a>

                    <a class="sidebar-link @(ViewBag.ActiveMenu == "Lookups" ? "active" : "")"
                       href="@Url.Action("Index", "Lookups")">
                        <span class="icon">📚</span>
                        <span>@L["Lookups"]</span>
                    </a>

                    }
                    <a class="sidebar-link @(ViewBag.ActiveMenu == "user-questions" ? "active" : "")"
                       href="@Url.Action("Survey", "UserQuestions", new { userId = userId })">
                        <span class="icon">🧾</span>
                        <span>@L["Menu_UserQuestions"]</span>
                    </a>


                    
                </nav>
            </div>

            <!-- bottom: theme + language + user -->
            <div>
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <!-- Theme toggle -->
                    <button type="button" class="btn-pr btn-pr-icon" id="themeToggle" title="@L["Toggle_Theme"]">
                        🌙
                    </button>

                    <!-- Language toggle
                         NOTE: عدّل الروت حسب Controller اللغة عندك (Lang / Language / Culture...) -->
                    <div class="btn-group">
                        <div class="btn-group">
                            <form method="post" asp-controller="Language" asp-action="Set" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="culture" value="ar-SA" />
                                <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                <button type="submit"
                                        class="btn-pr btn-pr-soft @(isRtl ? "active" : "")">
                                    ع
                                </button>
                            </form>

                            <form method="post" asp-controller="Language" asp-action="Set" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="culture" value="en-US" />
                                <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                <button type="submit"
                                        class="btn-pr btn-pr-soft @(!isRtl ? "active" : "")">
                                    EN
                                </button>
                            </form>
                        </div>


                    </div>
                </div>

                <div class="user-pill">
                    <div class="user-pill-avatar">
                        @((!string.IsNullOrEmpty(userName) ? userName[0].ToString().ToUpper() : "U"))
                    </div>
                    <div>
                        <div style="font-size:0.85rem;">@userName</div>
                        <div class="text-muted-soft">@L["Logged in"]</div>
                    </div>
                </div>
            </div>
        </aside>

        <!-- Main -->
        <main class="app-main">
            <!-- Header -->
            <header class="app-header">
                <div>
                    <h1 class="h-page-title mb-0">
                        @ViewData["Title"]
                    </h1>
                    <div class="text-muted-soft mt-1">
                        @RenderSection("PageSubtitle", required: false)
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2">
                    @RenderSection("HeaderActions", required: false)

                    <a href="@Url.Action("Logout", "Auth")"
                       class="btn-pr btn-pr-outline">
                        @L["Logout"]
                    </a>
                </div>
            </header>

            <!-- Content -->
            <section class="app-content mt-2">
                @RenderBody()
            </section>

            <footer class="mt-3 text-center text-muted-soft">
                © @DateTime.Now.Year @L["AppName"]
            </footer>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        (function () {
            const root = document.documentElement;
            const savedTheme = localStorage.getItem("pr-theme") || "dark";
            root.setAttribute("data-theme", savedTheme);

            const btn = document.getElementById("themeToggle");
            if (btn) {
                btn.textContent = savedTheme === "dark" ? "🌙" : "☀️";

                btn.addEventListener("click", function () {
                    const current = root.getAttribute("data-theme") || "dark";
                    const next = current === "dark" ? "light" : "dark";
                    root.setAttribute("data-theme", next);
                    localStorage.setItem("pr-theme", next);
                    btn.textContent = next === "dark" ? "🌙" : "☀️";
                });
            }
        })();
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>
