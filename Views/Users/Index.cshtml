
@inject Microsoft.Extensions.Localization.IStringLocalizer<PeerReview.MvcHotel.Resources.SharedResource> L
@model System.Collections.Generic.List<PeerReview.MvcHotel.Models.User>
@{ ViewData["Title"]=L["Users_Title"]; }
<div class="d-flex justify-content-between align-items-center mb-2">
  <h3 class="m-0">@L["Users_Title"]</h3>
  <a class="btn btn-gold" href="/Users/Create">@L["Users_Add"]</a>
</div>
<table class="table table-hover bg-white card-hotel">
  <thead><tr>
    <th>@L["Users_Col_Id"]</th>
    <th>@L["Users_Col_FullName"]</th>
    <th>@L["Users_Col_UserName"]</th>
    <th>@L["Users_Col_Status"]</th>
    <th>@L["Users_Col_Role"]</th>
    <th>Actions</th>
  </tr></thead>
  <tbody>
  @foreach (var u in Model){
    <tr>
      <td>@u.id</td>
      <td>@u.fullName</td>
      <td>@u.userName</td>
      <td>@(u.isActive ? L["Status_Active"].Value : L["Status_Inactive"].Value)</td>
      <td>@u.roleId</td>
      <td class="text-nowrap">
        <a class="btn btn-sm btn-outline-primary" href="/Users/Edit/@u.id">@L["Users_Action_Edit"]</a>
        <form method="post" action="/Users/Delete/@u.id" style="display:inline" onsubmit="return confirm('Delete?');">
          <button class="btn btn-sm btn-outline-danger">@L["Users_Action_Delete"]</button>
        </form>
        @if(u.isActive){
          <form method="post" action="/Users/Deactivate/@u.id" style="display:inline"><button class="btn btn-sm btn-outline-warning">@L["Users_Action_Deactivate"]</button></form>
        } else {
          <form method="post" action="/Users/Activate/@u.id" style="display:inline"><button class="btn btn-sm btn-outline-success">@L["Users_Action_Activate"]</button></form>
        }
      </td>
    </tr>
  }
  </tbody>
</table>
