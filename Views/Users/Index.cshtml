
@inject Microsoft.Extensions.Localization.IStringLocalizer<PeerReview.MvcHotel.Resources.SharedResource> L
@model System.Collections.Generic.List<PeerReview.MvcHotel.Models.User>
@{ ViewData["Title"]=@SharedResource.Users_Title; }
<div class="d-flex justify-content-between align-items-center mb-2">
  <h3 class="m-0">@SharedResource.Users_Title</h3>
  <a class="btn btn-gold" href="/Users/Create">@SharedResource.Users_Add</a>
</div>
<table class="table table-hover bg-white card-hotel">
  <thead><tr>
    <th>@SharedResource.Users_Col_Id</th>
    <th>@SharedResource.Users_Col_FullName</th>
    <th>@SharedResource.Users_Col_UserName</th>
    <th>@SharedResource.Users_Col_Status</th>
    <th>@SharedResource.Users_Col_Role</th>
    <th>Actions</th>
  </tr></thead>
  <tbody>
  @foreach (var u in Model){
    <tr>
      <td>@u.id</td>
      <td>@u.fullName</td>
      <td>@u.userName</td>
                <td>@(u.isActive ? SharedResource.Status_Active : SharedResource.Status_Inactive)</td>
      <td>@u.RoleName</td>
      <td class="text-nowrap">
        <a class="btn btn-sm btn-outline-primary" href="/Users/Edit/@u.id">@SharedResource.Users_Action_Edit</a>
        <form method="post" action="/Users/Delete/@u.id" style="display:inline" onsubmit="return confirm('Delete?');">
          @Html.AntiForgeryToken()
          <button class="btn btn-sm btn-outline-danger">@SharedResource.Users_Action_Delete</button>
        </form>
        @if(u.isActive){
          <form method="post" action="/Users/Deactivate/@u.id" style="display:inline">
            @Html.AntiForgeryToken()
            <button class="btn btn-sm btn-outline-warning">@SharedResource.Users_Action_Deactivate</button>
          </form>
        } else {
          <form method="post" action="/Users/Activate/@u.id" style="display:inline">
            @Html.AntiForgeryToken()
            <button class="btn btn-sm btn-outline-success">@SharedResource.Users_Action_Activate</button>
          </form>
        }
      </td>
    </tr>
  }
  </tbody>
</table>
