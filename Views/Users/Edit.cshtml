@model UserUpdateDto
@{
    ViewData["Title"] = "تعديل مستخدم";
}

<form method="post" asp-action="Edit" asp-route-id="@(ViewBag.UserId)">
    @Html.AntiForgeryToken()
    <div class="row g-2">
        <div class="col-md-4">
            <label class="form-label">الاسم الكامل</label>
            <input asp-for="fullName" class="form-control" />
        </div>

        <div class="col-md-4">
            <label class="form-label">البريد</label>
            <input asp-for="email" class="form-control" />
        </div>

        <div class="col-md-4">
            <label class="form-label">الحالة</label><br />
            <input asp-for="isActive" class="form-check-input" type="checkbox" />
            <label class="form-check-label" for="isActive">نشط</label>
        </div>

        <div class="col-md-4">
            <label class="form-label">الدور</label>
            <select asp-for="roleId"
                    class="form-select"
                    asp-items="@(new SelectList((IEnumerable<SelectListItem>)ViewBag.Roles, "Value", "Text"))">
                <option value="">-- اختر الدور --</option>
            </select>
            <span asp-validation-for="roleId" class="text-danger"></span>
        </div>
    </div>

    <button class="btn btn-gold mt-2">حفظ</button>
    <a class="btn btn-secondary mt-2" href="/Users">رجوع</a>
</form>
