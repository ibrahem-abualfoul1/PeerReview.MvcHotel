
@model UserUpdateDto
@{ ViewData["Title"]="تعديل مستخدم"; var id = ViewBag.UserId as int? ?? 0; var userName = ViewBag.UserName as string ?? ""; }
<h3>تعديل مستخدم: @userName</h3>
<form method="post" class="card card-hotel p-3">
  <div class="row g-2">
    <div class="col-md-4"><label class="form-label">الاسم الكامل</label><input asp-for="fullName" class="form-control" /></div>
    <div class="col-md-4"><label class="form-label">البريد</label><input asp-for="email" class="form-control" /></div>
    <div class="col-md-2 form-check mt-4"><input asp-for="isActive" class="form-check-input" type="checkbox" /> <label class="form-check-label">نشط</label></div>
    <div class="col-md-4"><label class="form-label">الدور (RoleId)</label><input asp-for="roleId" type="number" class="form-control" /></div>
  </div>
  <button class="btn btn-gold mt-2">حفظ</button> <a class="btn btn-secondary mt-2" href="/Users">رجوع</a>
</form>
