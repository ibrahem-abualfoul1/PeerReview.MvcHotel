@using Microsoft.AspNetCore.Mvc.Localization
@model UserUpdateDto
@inject IViewLocalizer L

@{
    ViewData["Title"] = L["Users_Edit_Title"];
    ViewBag.ActiveMenu = "Users";
}

@section HeaderActions {
    <a href="@Url.Action("Index", "Users")" class="btn-pr btn-pr-outline">
        ← @L["Btn_Back"]
    </a>
}

<div class="row justify-content-center">
    <div class="col-lg-7 col-xl-6">
        <div class="pr-card">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <div class="h-section-title mb-0">@L["Users_Edit_Title"]</div>
                <span class="chip">ID #@ViewBag.UserId</span>
            </div>

            <form method="post" asp-action="Edit" asp-route-id="@(ViewBag.UserId)" class="mt-2">
                @Html.AntiForgeryToken()

                <div class="pr-form-grid">
                    <div class="pr-field">
                        <label class="form-label">@L["Field_FullName"]</label>
                        <input asp-for="fullName" class="form-control" />
                        @Html.ValidationMessageFor(m => m.fullName, "", new { @class = "text-danger small" })
                    </div>

                    <div class="pr-field">
                        <label class="form-label">@L["Field_Email"]</label>
                        <input asp-for="email" class="form-control" type="email" />
                        @Html.ValidationMessageFor(m => m.email, "", new { @class = "text-danger small" })
                    </div>

                    <div class="pr-field">
                        <label class="form-label">@L["Field_Role"]</label>
                        <select asp-for="roleId"
                                class="form-select"
                                asp-items="@(new SelectList((IEnumerable<SelectListItem>)ViewBag.Roles, "Value", "Text"))">
                            <option value="">@L["Field_RolePlaceholder"]</option>
                        </select>
                        @Html.ValidationMessageFor(m => m.roleId, "", new { @class = "text-danger small" })
                    </div>

                    <div class="d-flex align-items-center ps-1">
                        <div class="form-check form-switch">
                            @Html.CheckBoxFor(m => m.isActive, new { @class = "form-check-input", id = "isActive" })
                            <label class="form-check-label" for="isActive">@L["Field_IsActive"]</label>
                        </div>
                    </div>
                </div>

                <div class="pr-form-footer">
                    <a href="@Url.Action("Index", "Users")" class="btn-pr btn-pr-outline">
                        @L["Btn_Back"]
                    </a>
                    <button type="submit" class="btn-pr btn-pr-primary">
                        @L["Btn_Save"]
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
