
@model UserCreateDto
@{ ViewData["Title"]="مستخدم جديد"; }
<h3>مستخدم جديد</h3>
<form method="post" class="card card-hotel p-3">
  <div class="row g-2">
    <div class="col-md-4"><label class="form-label">اسم المستخدم</label><input asp-for="userName" class="form-control" required /></div>
    <div class="col-md-4"><label class="form-label">الاسم الكامل</label><input asp-for="fullName" class="form-control" /></div>
    <div class="col-md-4"><label class="form-label">البريد</label><input asp-for="email" class="form-control" /></div>
    <div class="col-md-4"><label class="form-label">كلمة المرور</label><input asp-for="password" type="password" class="form-control" /></div>
        <div class="col-md-4">
            <label class="form-label">الدور</label>
            <select asp-for="roleId" asp-items="@(new SelectList(ViewBag.Roles, "Value", "Text"))" class="form-select">
                <option value="">-- اختر الدور --</option>
            </select>
        </div>
    </div>
  <button class="btn btn-gold mt-2">حفظ</button> <a class="btn btn-secondary mt-2" href="/Users">رجوع</a>
</form>
