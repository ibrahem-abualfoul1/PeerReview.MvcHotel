@using Microsoft.AspNetCore.Mvc.Localization
@model UserCreateDto
@inject IViewLocalizer L

@{
    ViewData["Title"] = L["Users_Create_Title"];
    ViewBag.ActiveMenu = "Users";
}

@section HeaderActions {
    <a href="@Url.Action("Index", "Users")" class="btn-pr btn-pr-outline">
        ← @L["Btn_Back"]
    </a>
}

<div class="row justify-content-center">
    <div class="col-lg-7 col-xl-6">
        <div class="pr-card">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <div class="h-section-title mb-0">@L["Users_Create_Title"]</div>
                <span class="chip">@L["Users_Col_Status"]: @L["Status_Active"]</span>
            </div>

            <form asp-action="Create" asp-controller="Users" method="post" class="mt-2">
                @Html.AntiForgeryToken()

                <div class="pr-form-grid">
                    <div class="pr-field">
                        <label class="form-label">@L["Field_UserName"]</label>
                        <input asp-for="userName" class="form-control" required />
                        @Html.ValidationMessageFor(m => m.userName, "", new { @class = "text-danger small" })
                    </div>

                    <div class="pr-field">
                        <label class="form-label">@L["Field_FullName"]</label>
                        <input asp-for="fullName" class="form-control" />
                        @Html.ValidationMessageFor(m => m.fullName, "", new { @class = "text-danger small" })
                    </div>

                    <div class="pr-field">
                        <label class="form-label">@L["Field_Email"]</label>
                        <input asp-for="email" class="form-control" type="email" />
                        @Html.ValidationMessageFor(m => m.email, "", new { @class = "text-danger small" })
                    </div>

                    <div class="pr-field">
                        <label class="form-label">@L["Field_Password"]</label>
                        <input asp-for="password" class="form-control" type="password" />
                        @Html.ValidationMessageFor(m => m.password, "", new { @class = "text-danger small" })
                    </div>

                    <div class="pr-field">
                        <label class="form-label">@L["Field_Role"]</label>
                        <select asp-for="roleId"
                                class="form-select"
                                asp-items="@(new SelectList(ViewBag.Roles, "Value", "Text"))">
                            <option value="">@L["Field_RolePlaceholder"]</option>
                        </select>
                        @Html.ValidationMessageFor(m => m.roleId, "", new { @class = "text-danger small" })
                    </div>
                </div>

                <div class="pr-form-footer">
                    <a href="@Url.Action("Index", "Users")" class="btn-pr btn-pr-outline">
                        @L["Btn_Back"]
                    </a>
                    <button type="submit" class="btn-pr btn-pr-primary">
                        @L["Btn_Save"]
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
