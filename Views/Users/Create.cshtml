@using Microsoft.AspNetCore.Mvc.Localization
@model UserCreateDto
@inject IViewLocalizer L

@{
    ViewData["Title"] = L["Users_Create_Title"];
    ViewBag.ActiveMenu = "Users";
}

@section HeaderActions {
    <a href="@Url.Action("Index", "Users")" class="btn-pr btn-pr-outline">
        ← @L["Btn_Back"]
    </a>
}

<div class="row justify-content-center">
    <div class="col-lg-7 col-xl-6">
        <div class="pr-card">
            <div class="h-section-title mb-3">
                @L["Users_Create_Title"]
            </div>

            <form asp-action="Create" asp-controller="Users" method="post">
                @Html.AntiForgeryToken()

                <div class="pr-field">
                    <input asp-for="userName" placeholder=" " required />
                    <label>@L["Field_UserName"]</label>
                    @Html.ValidationMessageFor(m => m.userName, "", new { @class = "text-danger small" })
                </div>

                <div class="pr-field">
                    <input asp-for="fullName" placeholder=" " />
                    <label>@L["Field_FullName"]</label>
                    @Html.ValidationMessageFor(m => m.fullName, "", new { @class = "text-danger small" })
                </div>

                <div class="pr-field">
                    <input asp-for="email" placeholder=" " type="email" />
                    <label>@L["Field_Email"]</label>
                    @Html.ValidationMessageFor(m => m.email, "", new { @class = "text-danger small" })
                </div>

                <div class="pr-field">
                    <input asp-for="password" placeholder=" " type="password" />
                    <label>@L["Field_Password"]</label>
                    @Html.ValidationMessageFor(m => m.password, "", new { @class = "text-danger small" })
                </div>

                <div class="pr-field">
                    <select asp-for="roleId"
                            class="form-select"
                            asp-items="@(new SelectList(ViewBag.Roles, "Value", "Text"))">
                        <option value="">@L["Field_RolePlaceholder"]</option>
                    </select>
                    <label>@L["Field_Role"]</label>
                    @Html.ValidationMessageFor(m => m.roleId, "", new { @class = "text-danger small" })
                </div>

                <div class="d-flex justify-content-end gap-2 mt-3">
                    <a href="@Url.Action("Index", "Users")" class="btn-pr btn-pr-outline">
                        @L["Btn_Back"]
                    </a>
                    <button type="submit" class="btn-pr btn-pr-primary">
                        @L["Btn_Save"]
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
