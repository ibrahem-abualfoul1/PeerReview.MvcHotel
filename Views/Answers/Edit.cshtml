@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer L
@model PeerReview.MvcHotel.Models.AnswerUpdateDto

@{
    ViewData["Title"] = L["Answers_Edit_Title"];
    ViewBag.ActiveMenu = "Answers";
}

<div class="row justify-content-center">
    <div class="col-xl-6 col-lg-7">
        <div class="pr-card">
            <div class="d-flex justify-content-between align-items-start mb-2 flex-wrap gap-2">
                <div>
                    <div class="h-section-title mb-0">@L["Answers_Edit_Title"]</div>
                    <p class="text-muted-soft mb-0">@L["Dashboard_Activity_PlaceholderText"]</p>
                </div>
                <span class="pill-badge">@L["Field_Value"]</span>
            </div>

            <form method="post" class="pr-form-grid">
                @Html.AntiForgeryToken()

                <div class="pr-field">
                    <input asp-for="value" placeholder=" " />
                    <label>@L["Field_Value"]</label>
                </div>

                <div class="pr-form-actions mt-1">
                    <a class="btn-pr btn-pr-outline" href="/Answers/Mine">@L["Btn_Back"]</a>
                    <button class="btn-pr btn-pr-primary" type="submit">@L["Btn_Save"]</button>
                </div>
            </form>
        </div>
    </div>
</div>
