@using Microsoft.Extensions.Configuration
@inject IConfiguration Config
@using System.Collections.Generic
@using PeerReview.MvcHotel.Models
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer L
@model List<PeerReview.MvcHotel.Models.Answer>

@{
    ViewData["Title"] = L["Answers_Title"];
    ViewBag.ActiveMenu = "Answers";
    var api = Config["ApiBaseUrl"];
}

@functions {
    public static string Trunc(string? text, int maxLen)
    {
        if (string.IsNullOrWhiteSpace(text)) return "";
        return text!.Length <= maxLen ? text : text.Substring(0, maxLen) + "...";
    }
}

@section Styles {
    <style>
        .answers-header-note {
            font-size: 0.85rem;
            color: var(--text-muted, #9ca3af);
        }

        .answers-table td.text-clip {
            max-width: 260px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .answers-table td.text-clip-wide {
            max-width: 320px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .answers-file-btn {
            font-size: 0.8rem;
            border-radius: 999px;
            padding-inline: .75rem;
            margin-bottom: .15rem;
        }

        .answers-badge-type {
            font-size: 0.75rem;
            border-radius: 999px;
            padding: .15rem .5rem;
            border: 1px solid var(--border-soft, rgba(148,163,184,0.4));
            opacity: 0.85;
        }

        .dt-buttons .btn {
            border-radius: 999px;
            font-size: .8rem;
            padding-inline: .75rem;
        }
    </style>
}

<div class="pr-card">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div>
            <div class="h-section-title mb-1">
                @L["Answers_Title"]
            </div>
            <div class="answers-header-note">
                @L["Answers_Add"]
            </div>
        </div>
        <span class="answers-badge-type">
            @L["Answers_Action_Delete"]
        </span>
    </div>

    <div class="table-responsive mt-2">
        <table id="answersMineTable" class="pr-table table table-hover table-striped answers-table align-middle w-100">
            <thead>
                <tr>
                    <th>#</th>
                    <th>@L["Answers_Col_Question"]</th>
                    <th>@L["Answers_Col_Item"]</th>
                    <th>@L["Answers_Col_Value"]</th>
                    <th>@L["Answers_Col_Date"]</th>
                    <th class="text-center">@L["Upload_File_File"]</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Count > 0)
                {
                    var i = 1;
                    foreach (var a in Model)
                    {
                        var qTitle = a.question?.TitleEn;
                        var itemText = a.questionItem?.TextEn;
                        var val = a.value ?? "";

                        var isFileUpload = a.questionItem?.Type == 7;

                        // قائمة ملفات الإجابة (إن وجدت)
                        var fileItems = isFileUpload
                        ? (a.Files?
                        .Where(f => f.File != null && !string.IsNullOrWhiteSpace(f.File.Path))
                        .ToList()
                        ?? new List<AnswerFileDto>())
                        : new List<AnswerFileDto>();

                        var hasFiles = fileItems.Any();

                        string firstFileName = "";
                        int extraFilesCount = 0;

                        if (hasFiles)
                        {
                            firstFileName = fileItems[0].File?.FileName ?? "";
                            extraFilesCount = fileItems.Count - 1;
                        }

                        <tr>
                            <td>@i</td>

                            <td class="text-clip" title="@qTitle">
                                @Trunc(qTitle, 70)
                            </td>

                            <td class="text-clip" title="@itemText">
                                @Trunc(itemText, 60)
                            </td>

                            @* خانة القيمة *@
                            @if (isFileUpload)
                            {
                                if (hasFiles)
                                {
                                    var displayName = firstFileName;
                                    if (string.IsNullOrWhiteSpace(displayName))
                                        displayName = L["Upload_File_File"].Value;

                                    if (extraFilesCount > 0)
                                        displayName += $" (+{extraFilesCount})";

                                    <td class="text-clip-wide text-muted" title="@firstFileName">
                                        @Trunc(displayName, 80)
                                    </td>
                                }
                                else
                                {
                                    <td class="text-clip-wide text-muted">
                                        @L["Upload_File_File"]
                                    </td>
                                }
                            }
                            else
                            {
                                <td class="text-clip-wide" title="@val">
                                    @Trunc(val, 80)
                                </td>
                            }

                            <td>
                                @(a.submittedAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")
                            </td>

                            <td class="text-center">
                                @if (hasFiles)
                                {
                                    <div class="d-inline-flex flex-column align-items-center">
                                        @foreach (var f in fileItems)
                                        {
                                            var path = f.File!.Path?.TrimStart('/') ?? "";
                                            var baseUrl = api?.TrimEnd('/') ?? "";
                                            var fileUrl = $"{baseUrl}/{path}";
                                            var fileName = f.File.FileName ?? "";

                                            <a href="@fileUrl"
                                               class="btn-pr btn-pr-sm btn-pr-soft answers-file-btn"
                                               target="_blank"
                                               download="@fileName">
                                                <i class="bi bi-file-earmark-arrow-down me-1"></i>
                                                @(string.IsNullOrWhiteSpace(fileName)
                                                                                ? L["Upload_File_File"].Value
                                                                                : Trunc(fileName, 40))
                            </a>
                                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted-soft" style="font-size:0.8rem;">
                                        @L["Upload_File_File"]
                                    </span>
                                }
                            </td>
                        </tr>
                        i++;
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/jquery.dataTables.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />

    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>

    <script>
        $(function () {
            const isRtl = document.documentElement.dir === 'rtl';

            $('#answersMineTable').DataTable({
                order: [[4, 'desc']],   // ترتيب حسب التاريخ
                pageLength: 10,
                language: isRtl ? {
                    search: "بحث:",
                    lengthMenu: "إظهار _MENU_ سجل",
                    info: "إظهار _START_ إلى _END_ من أصل _TOTAL_ سجل",
                    paginate: {
                        first: "الأولى",
                        last: "الأخيرة",
                        next: "التالي",
                        previous: "السابق"
                    },
                    zeroRecords: "لا توجد بيانات",
                    infoEmpty: "لا توجد سجلات",
                    infoFiltered: "(تمت التصفية من إجمالي _MAX_ سجلات)"
                } : {}
            });
        });
    </script>
}
