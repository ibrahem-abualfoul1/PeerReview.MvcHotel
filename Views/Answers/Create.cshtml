
@model PeerReview.MvcHotel.Models.AnswerCreateDto
@inject Microsoft.Extensions.Localization.IStringLocalizer<PeerReview.MvcHotel.Resources.SharedResource> L

@{ ViewData["Title"]=L["Answers_Create_Title"]; }
<h3>@L["Answers_Create_Title"]</h3>
<form method="post" class="card card-hotel p-3">
  <div class="row g-2">
    <div class="col-md-4"><label class="form-label">@L["Field_QuestionId"]</label><input asp-for="questionId" class="form-control" type="number" required /></div>
    <div class="col-md-4"><label class="form-label">@L["Field_QuestionItemId"]</label><input asp-for="questionItemId" class="form-control" type="number" /></div>
    <div class="col-md-12"><label class="form-label">@L["Field_Value"]</label><input asp-for="value" class="form-control" /></div>
  </div>
  <button class="btn btn-gold mt-2">@L["Btn_Save"]</button> <a class="btn btn-secondary mt-2" href="/Answers/Mine">@L["Btn_Back"]</a>
</form>
