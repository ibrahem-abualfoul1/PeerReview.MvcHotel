@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer L
@model PeerReview.MvcHotel.Models.QuestionDto

@{
    ViewData["Title"] = Model?.TitleEn ?? "Form";
    var qid = (int)(ViewBag.QuestionId ?? 0);
    ViewBag.ActiveMenu = "Answers";
}

<div class="row justify-content-center">
    <div class="col-xxl-10 col-xl-10">
        <div class="pr-card">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                <div>
                    <div class="h-section-title mb-1">@Model?.TitleEn</div>
                    @if (!string.IsNullOrWhiteSpace(Model?.DescriptionEn))
                    {
                        <p class="text-muted-soft mb-0">@Model.DescriptionEn</p>
                    }
                </div>
                <a class="btn-pr btn-pr-outline" href="/Answers/Mine">@L["Btn_Back"]</a>
            </div>

            <form id="dynForm" class="pr-form-grid mt-3">
                @Html.AntiForgeryToken()
                <input type="hidden" id="questionId" value="@qid" />

                <div class="row g-3">
                    @foreach (var it in Model?.Items ?? new List<PeerReview.MvcHotel.Models.QuestionItemDto>())
                    {
                        var required = it.IsRequired ? "required" : "";

                        <div class="col-12 item" id="item-@it.Id">
                            <div class="pr-field-block">
                                <label>
                                    @it.TextEn
                                    @if (it.IsRequired)
                                    {
                                        <span class="text-danger">*</span>
                                    }
                                </label>

                                @if (it.Type == 7)
                                {
                                    <input class="pr-form-control" type="file" name="file_@it.Id" />
                                }
                                else if (it.Type == 6)
                                {
                                    <input class="pr-form-control" type="date" name="i_@it.Id" @required />
                                }
                                else if (it.Type == 5)
                                {
                                    <input class="pr-form-control" type="number" step="any" name="i_@it.Id" @required />
                                }
                                else if (it.Type == 4)
                                {
                                    <select class="pr-form-control" multiple name="i_@it.Id">
                                        @foreach (var opt in (it.OptionsCsvEn ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries))
                                        {
                                            var o = opt.Trim();
                                            <option value="@o">@o</option>
                                        }
                                    </select>
                                }
                                else if (it.Type == 3)
                                {
                                    <select class="pr-form-control" name="i_@it.Id" @required>
                                        <option value="">—</option>
                                        @foreach (var opt in (it.OptionsCsvEn ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries))
                                        {
                                            var o = opt.Trim();
                                            <option value="@o">@o</option>
                                        }
                                    </select>
                                }
                                else if (it.Type == 2)
                                {
                                    <select class="pr-form-control" name="i_@it.Id" @required>
                                        <option value="">—</option>
                                        <option value="Yes">@L["Yes"]</option>
                                        <option value="No">@L["No"]</option>
                                    </select>
                                }
                                else
                                {
                                    <input class="pr-form-control" type="text" name="i_@it.Id" @required />
                                }
                            </div>
                        </div>
                    }
                </div>

                <div class="pr-form-actions mt-2">
                    <a class="btn-pr btn-pr-outline" href="/Answers/Mine">@L["Btn_Back"]</a>
                    <button class="btn-pr btn-pr-primary" type="submit">@L["Btn_Save"]</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function(){
          // parse items dependencies
          const items = Array.from(document.querySelectorAll('.item'));
          const indexById = {};
          const antiForgeryToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
          items.forEach(d => {
            const id = parseInt(d.id.replace('item-',''));
            indexById[id] = d;
          });

          function getValue(div){
            const inp = div.querySelector('input, select, textarea');
            if (!inp) return '';
            if (inp.tagName === 'SELECT' && inp.multiple) {
              return Array.from(inp.selectedOptions).map(o=>o.value).filter(Boolean).join(',');
            }
            if (inp.type === 'checkbox') return inp.checked ? 'true' : 'false';
            return inp.value ?? '';
          }

          function evaluate(){
            items.forEach(d => {
              const parent = d.dataset.parent;
              const showVal = d.dataset.show;
              if (!parent) { d.style.display=''; return; }
              const pDiv = indexById[parseInt(parent)];
              if (!pDiv) { d.style.display=''; return; }
              const pv = getValue(pDiv);
              if (pv && showVal!=null && pv.toString().trim() === showVal.toString().trim()){
                d.style.display='';
              } else {
                d.style.display='none';
                const inp = d.querySelector('input,select,textarea');
                if (inp) inp.value='';
              }
            });
          }

          // bind change on all inputs
          items.forEach(d => {
            const inp = d.querySelector('input, select, textarea');
            if (inp) inp.addEventListener('change', evaluate);
          });
          evaluate();

          // submit -> POST to /Answers/SaveSet
          document.getElementById('dynForm').addEventListener('submit', async function(e){
            e.preventDefault();
            const qid = parseInt(document.getElementById('questionId').value);
            const items = Array.from(document.querySelectorAll('.item'));
            const body = { questionId: qid, values: {} };
            const files = []; // {itemId, file}

            items.forEach(d => {
              if (d.style.display === 'none') return;
              const id = parseInt(d.id.replace('item-',''));
              const fileInput = d.querySelector('input[type="file"]');
              if (fileInput && fileInput.files && fileInput.files.length > 0){
                files.push({ itemId: id, file: fileInput.files[0] });
                return; // file items handled separately
              }
              const inp = d.querySelector('input, select, textarea');
              if (!inp) return;
              let val;
              if (inp.tagName === 'SELECT' && inp.multiple) {
                val = Array.from(inp.selectedOptions).map(o=>o.value).filter(Boolean).join(',');
              } else if (inp.type === 'checkbox') {
                val = inp.checked ? 'true' : 'false';
              } else {
                val = inp.value ?? '';
              }
              if (val !== '') body.values[id] = val;
            });

            // First save non-file values
            await fetch('/Answers/SaveSet', {
                method:'POST',
                headers:{
                    'Content-Type':'application/json',
                    'RequestVerificationToken': antiForgeryToken
                },
                body: JSON.stringify(body)
            });

            // Then upload file answers (one by one)
            for (const f of files){
              const fd = new FormData();
              fd.append('questionId', String(qid));
              fd.append('questionItemId', String(f.itemId));
              fd.append('file', f.file);
              await fetch('/Answers/Upload', {
                  method:'POST',
                  headers:{ 'RequestVerificationToken': antiForgeryToken },
                  body: fd
              });
            }

            location.href = '/Answers/Mine';
          });
        })();
    </script>
}
