@model PeerReview.MvcHotel.Models.SurveyViewModel
@using System.Text.Json
@using System.Text.Encodings.Web

@{
    ViewData["Title"] = Model?.HeaderTitle ?? "استطلاع";

    var groups = Model?.Groups ?? new List<QuestionGroup>(); // نفس النوع
    var json = JsonSerializer.Serialize(
        groups,
        new JsonSerializerOptions
        {
            PropertyNamingPolicy = null,
            Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping
        });
}


<!DOCTYPE html>
<html >
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>استطلاع الفنادق</title>
    <style>

        .container {
            max-width: 800px;
            width: 100%;
            background: white;
            border-radius: 24px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            overflow: hidden;
            animation: slideIn 0.5s ease-out;
        }

  

        .header {
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
            color: white;
            padding: 40px 30px;
            text-align: center;
        }

            .header h1 {
                font-size: 2em;
                margin-bottom: 10px;
                font-weight: 700;
            }

            .header p {
                font-size: 1.1em;
                opacity: 0.95;
            }

        .progress-container {
            background: rgba(255, 255, 255, 0.2);
            height: 8px;
            border-radius: 10px;
            margin-top: 20px;
            overflow: hidden;
        }

        .progress-bar {
            height: 100%;
            background: white;
            border-radius: 10px;
            transition: width 0.4s ease;
            box-shadow: 0 0 10px rgba(255, 255, 255, 0.5);
        }

        .progress-text {
            margin-top: 10px;
            font-size: 0.9em;
            opacity: 0.9;
        }

        .content {
            padding: 40px 30px;
        }

        .group-title {
            font-size: 1.8em;
            color: #333;
            margin-bottom: 10px;
            font-weight: 700;
        }

        .group-description {
            color: #666;
            margin-bottom: 30px;
            font-size: 1.05em;
            line-height: 1.6;
        }

        .question {
            margin-bottom: 35px;
            animation: fadeIn 0.3s ease-out;
        }


        .question-text {
            font-size: 1.15em;
            color: #333;
            margin-bottom: 15px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .required {
            color: #e74c3c;
            font-size: 1.2em;
        }

        .input-field {
            width: 100%;
            padding: 14px 18px;
            border: 2px solid #e0e0e0;
            border-radius: 12px;
            font-size: 1em;
            transition: all 0.3s ease;
            font-family: inherit;
        }

            .input-field:focus {
                outline: none;
                border-color: #2a5298;
                box-shadow: 0 0 0 4px rgba(42, 82, 152, 0.1);
            }

        textarea.input-field {
            min-height: 120px;
            resize: vertical;
        }

        .options-container {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .option-label {
            display: flex;
            align-items: center;
            padding: 16px 20px;
            border: 2px solid #e0e0e0;
            border-radius: 12px;
            cursor: pointer;
            transition: all 0.3s ease;
            background: white;
        }

            .option-label:hover {
                border-color: #2a5298;
                background: rgba(42, 82, 152, 0.05);
                transform: translateX(-5px);
            }

            .option-label input {
                margin-left: 12px;
                cursor: pointer;
                width: 20px;
                height: 20px;
                accent-color: #2a5298;
            }

            .option-label.selected {
                border-color: #2a5298;
                background: rgba(42, 82, 152, 0.1);
                font-weight: 600;
            }

        .file-upload {
            border: 2px dashed #2a5298;
            border-radius: 12px;
            padding: 30px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s ease;
            background: rgba(42, 82, 152, 0.05);
        }

            .file-upload:hover {
                background: rgba(42, 82, 152, 0.1);
                transform: scale(1.02);
            }

            .file-upload input {
                display: none;
            }

        .file-upload-text {
            color: #2a5298;
            font-weight: 600;
            font-size: 1.05em;
        }

        .file-name {
            margin-top: 10px;
            color: #666;
            font-size: 0.95em;
        }

        .buttons {
            display: flex;
            justify-content: space-between;
            gap: 15px;
            margin-top: 40px;
            padding-top: 30px;
            border-top: 2px solid #f0f0f0;
        }

        .btn {
            padding: 14px 32px;
            border: none;
            border-radius: 12px;
            font-size: 1.05em;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            font-family: inherit;
        }

        .btn-primary {
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
            color: white;
            flex: 1;
        }

            .btn-primary:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 20px rgba(42, 82, 152, 0.4);
            }

        .btn-secondary {
            background: #f0f0f0;
            color: #333;
        }

            .btn-secondary:hover {
                background: #e0e0e0;
                transform: translateY(-2px);
            }

        .btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            transform: none !important;
        }

        .error-message {
            color: #e74c3c;
            font-size: 0.9em;
            margin-top: 8px;
            display: none;
            animation: shake 0.3s ease;
        }



        .success-screen {
            text-align: center;
            padding: 60px 30px;
            display: none;
        }

        .success-icon {
            font-size: 5em;
            margin-bottom: 20px;
            animation: bounceIn 0.6s ease;
        }


        .success-title {
            font-size: 2em;
            color: #333;
            margin-bottom: 15px;
            font-weight: 700;
        }

        .success-message {
            color: #666;
            font-size: 1.1em;
            line-height: 1.6;
        }

        @@keyframes slideIn {
            from {
                opacity: 0;
                transform: translateY(30px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateX(-20px);
            }

            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        @@keyframes shake {
            0%, 100% {
                transform: translateX(0);
            }

            25% {
                transform: translateX(-10px);
            }

            75% {
                transform: translateX(10px);
            }
        }

        @@keyframes bounceIn {
            0% {
                transform: scale(0);
            }

            50% {
                transform: scale(1.2);
            }

            100% {
                transform: scale(1);
            }
        }

    </style>
</head>

<body>
    <div class="container">
        <div class="header">
            <h1>@(Model?.HeaderTitle ?? "استطلاع الفنادق")</h1>
            <p id="headerDescription">@(Model?.HeaderDescription ?? "مساعدتك في تحسين خدماتنا")</p>
            <div class="progress-container">
                <div class="progress-bar" id="progressBar"></div>
            </div>
            <div class="progress-text" id="progressText">صفحة 1 من 1</div>
        </div>

        <div class="content" id="surveyContent"></div>

        <div class="success-screen" id="successScreen" style="display:none">
            <div class="success-icon">✓</div>
            <h2 class="success-title">شكراً لك!</h2>
            <p class="success-message">تم إرسال إجاباتك بنجاح. نقدر وقتك ومساهمتك في تحسين خدماتنا.</p>
        </div>
    </div>

    <script>
        // ===== بيانات قادمة من السيرفر (Controller → ViewModel) =====
        // نتوقع أن Model.Groups = array of groups: [{ id, title, description, items: [{ id, text, type, isRequired, optionsCsv }] }]
        const surveyData = @Html.Raw(json);

        // ===== الحالة العامة =====
        let currentGroupIndex = 0;
        // التخزين: answers[questionId] = { questionId, type, value }
        let answers = {};

        // ===== تخزين/استرجاع محلي =====
        function loadAnswers() {
          try {
            const saved = localStorage.getItem('surveyAnswers');
            if (saved) answers = JSON.parse(saved) || {};
          } catch {
            answers = {};
          }
        }
        function saveAnswers() {
          localStorage.setItem('surveyAnswers', JSON.stringify(answers));
        }

        // العثور على عنصر السؤال بالـ id
        debugger
        function findItemById(id) {
          for (const g of surveyData || []) {
            for (const it of (g.Items || [])) 
            if (it.Id === id) 
            return {...it, qId : g.Id};
          }
          debugger
          return {id, type: 1 };
        }

        // setter موحّد: يخزّن بصيغة {questionId,type,value}
        function setAnswer(item, value) {
          answers[item.Id] = { questionId: item.Id, type: item.Type, value };
          saveAnswers();
          hideError(item.Id);
        }

        // getter يرجّع value فقط (ويدعم تخزين قديم إن وجد)
        function getStoredValue(item) {
          const a = answers[item.Id];
          if (!a) return undefined;
          return (typeof a === 'object' && a !== null && 'value' in a) ? a.value : a;
        }

        // ===== التقدّم =====
        function updateProgress() {
          const total = Math.max(1, (surveyData || []).length);
          const progress = ((currentGroupIndex + 1) / total) * 100;
          const bar = document.getElementById('progressBar');
          if (bar) bar.style.width = progress + '%';
          const txt = document.getElementById('progressText');
          if (txt) txt.textContent = `صفحة ${currentGroupIndex + 1} من ${total}`;
        }

        // ===== الرسم =====
        function renderGroup() {
          const group = (surveyData || [])[currentGroupIndex];
          const content = document.getElementById('surveyContent');

          if (!group) {
            content.innerHTML = '<div class="group-description">لا توجد أسئلة متاحة.</div>';
            updateProgress();
            return;
          }
          
          let html = '';
          html += `<div class="group-title">${group.Title   ?? ''}</div>`;
          html += `<div class="group-description">${group.Description ?? ''}</div>`;

          (group.Items ?? []).forEach(item => { html += renderQuestion(item); });

          html += `
            <div class="buttons">
              <button class="btn btn-secondary" id="prevBtn" ${currentGroupIndex === 0 ? 'disabled' : ''}>السابق</button>
              <button class="btn btn-primary" id="nextBtn">${currentGroupIndex === (surveyData?.length ?? 1) - 1 ? 'إرسال' : 'التالي'}</button>
            </div>
          `;

          content.innerHTML = html;
          updateProgress();
          attachEventListeners();
          restoreAnswers();
        }

        function renderQuestion(item) {
          const required = item.IsRequired ? '<span class="required">*</span>' : '';
          const v = getStoredValue(item);
          const id = item.Id;
          let html = `
            <div class="question" data-id="${id}">
              <div class="question-text">${item.Text ?? ''} ${required}</div>
          `;

          const csv = (item.OptionsCsv ?? '')
            .toString()
            .split(',')
            .map(s => s.trim())
            .filter(Boolean);

          switch (item.Type) {
            case 1: // نص
              html += `<textarea class="input-field" data-id="${id}" placeholder="اكتب إجابتك هنا...">${v ?? ''}</textarea>`;
              break;

            case 2: // نعم/لا
            case 3: // اختيار واحد
              html += '<div class="options-container">';
              csv.forEach(option => {
                const checked = v === option ? 'checked' : '';
                const selected = v === option ? 'selected' : '';
                html += `
                  <label class="option-label ${selected}">
                    <span>${option}</span>
                    <input type="radio" name="q${id}" value="${option}" data-id="${id}" ${checked}>
                  </label>`;
              });
              html += '</div>';
              break;

            case 4: // اختيارات متعددة
              html += '<div class="options-container">';
              const arr = Array.isArray(v) ? v : [];
              csv.forEach(option => {
                const checked = arr.includes(option) ? 'checked' : '';
                const selected = arr.includes(option) ? 'selected' : '';
                html += `
                  <label class="option-label ${selected}">
                    <span>${option}</span>
                    <input type="checkbox" name="q${id}" value="${option}" data-id="${id}" ${checked}>
                  </label>`;
              });
              html += '</div>';
              break;

            case 5: // رقم
              html += `<input type="number" class="input-field" data-id="${id}" placeholder="أدخل رقماً..." value="${v ?? ''}">`;
              break;

            case 6: // تاريخ
              html += `<input type="date" class="input-field" data-id="${id}" value="${v ?? ''}">`;
              break;

            case 7: // ملف (نخزّن Base64 فقط)
              const hasFile = !!v; // v = base64 أو undefined
              const fileLabel = hasFile ? 'تم اختيار ملف' : '';
              html += `
                <div class="file-upload" onclick="document.getElementById('file${id}').click()">
                  <input type="file" id="file${id}" data-id="${id}" accept="image/*">
                  <div class="file-upload-text">📁 اضغط لرفع ملف</div>
                  <div class="file-name" id="fileName${id}">${fileLabel}</div>
                </div>`;
              break;
          }

          html += `<div class="error-message" id="error${id}">هذا الحقل مطلوب</div></div>`;
          return html;
        }

        // ===== الأحداث =====
        function attachEventListeners() {
          // نص/رقم/تاريخ
          document.querySelectorAll('.input-field').forEach(input => {
            input.addEventListener('input', (e) => {
              const id = parseInt(e.target.dataset.id);
              const item = findItemById(id);
              setAnswer(item, e.target.value);
            });
          });

          // راديو
          document.querySelectorAll('input[type="radio"]').forEach(radio => {
            radio.addEventListener('change', (e) => {
              const id = parseInt(e.target.dataset.id);
              const item = findItemById(id);
              setAnswer(item, e.target.value);

              const labels = e.target.closest('.options-container')?.querySelectorAll('.option-label') || [];
              labels.forEach(l => l.classList.remove('selected'));
              e.target.closest('.option-label')?.classList.add('selected');
            });
          });

          // تشيك بوكس
          document.querySelectorAll('input[type="checkbox"]').forEach(checkbox => {
            checkbox.addEventListener('change', (e) => {
              const id = parseInt(e.target.dataset.id);
              const item = findItemById(id);
              const allChecked = document.querySelectorAll(`input[name="q${id}"]:checked`);
              const arr = Array.from(allChecked).map(c => c.value);
              setAnswer(item, arr);

              e.target.closest('.option-label')?.classList.toggle('selected', e.target.checked);
            });
          });

          // ملف — حفظ Base64 فقط
          document.querySelectorAll('input[type="file"]').forEach(fileInput => {
            fileInput.addEventListener('change', (e) => {
              const id = parseInt(e.target.dataset.id);
              const item = findItemById(id);
              const file = e.target.files?.[0];
              if (!file) return;

              const reader = new FileReader();
              reader.onload = (ev) => {
                // value = Base64 فقط
                setAnswer(item, ev.target.result);
                const nameEl = document.getElementById(`fileName${id}`);
                if (nameEl) nameEl.textContent = 'تم اختيار ملف';
              };
              reader.readAsDataURL(file);
            });
          });

          // تنقّل
          document.getElementById('prevBtn')?.addEventListener('click', () => {
            if (currentGroupIndex > 0) { currentGroupIndex--; renderGroup(); }
          });
          document.getElementById('nextBtn')?.addEventListener('click', () => {
            if (validateCurrentGroup()) {
              if (currentGroupIndex < (surveyData?.length ?? 1) - 1) {
                currentGroupIndex++;
                renderGroup();
              } else {
                submitSurvey();
              }
            }
          });
        }

        // ===== استرجاع/تحقق =====
        function restoreAnswers() {
          const group = (surveyData || [])[currentGroupIndex];
          (group?.Items ?? []).forEach(item => {
            const v = getStoredValue(item);
            if (v === undefined) return;

            if (item.Type === 4 && Array.isArray(v)) {
              v.forEach(value => {
                const checkbox = document.querySelector(`input[name="q${item.Id}"][value="${value}"]`);
                if (checkbox) {
                  checkbox.checked = true;
                  checkbox.closest('.option-label')?.classList.add('selected');
                }
              });
            }

            if (item.Type === 7 && v) {
              const el = document.getElementById(`fileName${item.Id}`);
              if (el) el.textContent = 'تم اختيار ملف';
            }
          });
        }

        function validateCurrentGroup() {
          const group = (surveyData || [])[currentGroupIndex];
          let isValid = true;

          (group?.Items ?? []).forEach(item => {
            if (!item.IsRequired) return;
            const val = getStoredValue(item);
            const empty =
              val === undefined || val === null ||
              (Array.isArray(val) && val.length === 0) ||
              (typeof val === 'string' && val.trim() === '');
            if (empty) { showError(item.Id); isValid = false; }
          });

          return isValid;
        }

        function showError(id) {
          const el = document.getElementById(`error${id}`);
          if (el) el.style.display = 'block';
        }
        function hideError(id) {
          const el = document.getElementById(`error${id}`);
          if (el) el.style.display = 'none';
        }

        // ===== تكوين Payload وإرساله =====
        function toArrayPayload() {
          const out = [];
          for (const g of (surveyData || [])) {
            for (const it of (g.Items || [])) {
              const v = getStoredValue(it);
              out.push({ questionId: g.Id, questionItemId: it.Id, value: v ?? null });
            }
          }
          return out;
        }

                // بدل toArrayPayload كلّها بهذا
        // function toDictionaryPayload() {
        //   const dict = {};
        //   for (const g of (surveyData || [])) {
        //     for (const it of (g.Items || [])) {
        //       const v = getStoredValue(it);         
        //       dict[it.Id] = (v ?? null);              
        //     }
        //   }
        //   return dict;
        // }


            async function submitSurvey() {
                debugger
          const payload = toArrayPayload();

          try {
            const res = await fetch('@Url.Action("Submit", "UserQuestions")', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload)            // يطابق Dictionary<int, object?>
            });
            if (!res.ok) throw new Error('Failed to submit');
          } catch (e) {
            console.error(e);
          }

          localStorage.removeItem('surveyAnswers');
          document.getElementById('surveyContent').style.display = 'none';
          document.getElementById('successScreen').style.display = 'block';
          const hdr = document.querySelector('.header');
          if (hdr && hdr.style) hdr.style.display = 'none';
        }


        // ===== تشغيل أولي =====
        loadAnswers();
        renderGroup();
    </script>


</body>

</html>