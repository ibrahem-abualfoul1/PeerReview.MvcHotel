@model PeerReview.MvcHotel.Models.SurveyViewModel
@using System.Text.Json
@using System.Text.Encodings.Web

@{
    ViewData["Title"] = Model?.HeaderTitle ?? L["Survey_DefaultTitle"];
    var groups = Model?.Groups ?? new List<QuestionGroup>();

    var json = JsonSerializer.Serialize(
        groups,
        new JsonSerializerOptions
        {
            PropertyNamingPolicy = null,
            Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping
        });

    var ci = System.Globalization.CultureInfo.CurrentUICulture;
    var isRtl = ci.TwoLetterISOLanguageName == "ar";
    var totalGroups = Math.Max(1, groups.Count);
    var progressTemplate = L["Survey_Progress_Template"].Value ?? "Page {current} of {total}";
    var initialProgressText = progressTemplate
        .Replace("{current}", "1")
        .Replace("{total}", totalGroups.ToString());
    var surveyTexts = new
    {
        Badge = L["Survey_Badge"].Value,
        ProgressFormat = progressTemplate,
        NoQuestions = L["Survey_NoQuestions"].Value,
        ButtonPrevious = L["Survey_Button_Previous"].Value,
        ButtonNext = L["Survey_Button_Next"].Value,
        ButtonSubmit = L["Survey_Button_Submit"].Value,
        TextareaPlaceholder = L["Survey_Textarea_Placeholder"].Value,
        NumberPlaceholder = L["Survey_Number_Placeholder"].Value,
        FileUploadPrompt = L["Survey_FileUpload_Prompt"].Value,
        FileSelected = L["Survey_FileSelected"].Value,
        RequiredError = L["Survey_Error_Required"].Value,
        SubmitError = L["Survey_Submit_Error"].Value
    };
    var surveyTextsJson = JsonSerializer.Serialize(
        surveyTexts,
        new JsonSerializerOptions
        {
            PropertyNamingPolicy = JsonNamingPolicy.CamelCase
        });
}

@section Styles {
    <style>
        .survey-shell {
            max-width: 880px;
            margin: 0 auto;
        }

        .survey-card {
            background: var(--panel);
            border-radius: 24px;
            box-shadow: 0 24px 60px rgba(15, 23, 42, 0.55);
            overflow: hidden;
            border: 1px solid rgba(148,163,184,0.3);
            animation: sv-slide-in 0.4s ease-out;
        }

        .survey-header {
            background: radial-gradient(circle at top left, rgba(201,162,39,0.18) 0, rgba(15,23,42,0.95) 40%, rgba(15,23,42,1) 100%);
            color: #f9fafb;
            padding: 32px 28px 26px;
            position: relative;
        }

            .survey-header h1 {
                font-size: 1.5rem;
                margin-bottom: 0.35rem;
                font-weight: 700;
            }

            .survey-header p {
                font-size: 0.95rem;
                opacity: 0.9;
                margin: 0;
            }

        .sv-header-badge {
            position: absolute;
            inset-inline-end: 24px;
            top: 24px;
            padding: .2rem .7rem;
            border-radius: 999px;
            font-size: .75rem;
            background: rgba(15,23,42,0.8);
            border: 1px solid rgba(148,163,184,0.35);
            display: inline-flex;
            align-items: center;
            gap: .35rem;
        }

            .sv-header-badge span {
                opacity: .85;
            }

        .progress-container {
            background: rgba(15,23,42,0.5);
            height: 7px;
            border-radius: 999px;
            margin-top: 18px;
            overflow: hidden;
        }

        .progress-bar {
            height: 100%;
            background: linear-gradient(90deg, #c9a227, #facc15);
            border-radius: 999px;
            transition: width 0.35s ease;
            box-shadow: 0 0 14px rgba(250, 204, 21, 0.7);
        }

        .progress-text {
            margin-top: 8px;
            font-size: 0.8rem;
            opacity: 0.88;
        }

        .survey-body {
            padding: 26px 26px 22px;
            background: radial-gradient(circle at top, rgba(15,23,42,0.65) 0, rgba(2,6,23,1) 34%, rgba(2,6,23,1) 100%);
            color: var(--text-main,#e5e7eb);
        }

        .group-title {
            font-size: 1.25rem;
            margin-bottom: 6px;
            font-weight: 700;
        }

        .group-description {
            color: var(--text-muted,#9ca3af);
            margin-bottom: 20px;
            font-size: 0.9rem;
            line-height: 1.6;
        }

        .question {
            margin-bottom: 22px;
            padding: 16px 16px 14px;
            border-radius: 18px;
            background: radial-gradient(circle at top left, rgba(15,23,42,0.9) 0, rgba(15,23,42,0.95) 60%, rgba(15,23,42,1) 100%);
            border: 1px solid rgba(31,41,55,0.9);
            box-shadow: 0 10px 25px rgba(15,23,42,0.7);
            animation: sv-fade-in 0.25s ease-out;
        }

        .question-text {
            font-size: 0.98rem;
            margin-bottom: 10px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .required {
            color: #f97373;
            font-size: 1.1em;
        }

        .input-field {
            width: 100%;
            padding: 10px 12px;
            border-radius: 12px;
            font-size: 0.95rem;
            border: 1px solid rgba(148,163,184,0.4);
            background: rgba(15,23,42,0.85);
            color: #e5e7eb;
            font-family: inherit;
            transition: all 0.25s ease;
        }

            .input-field:focus {
                outline: none;
                border-color: rgba(201,162,39,0.9);
                box-shadow: 0 0 0 1px rgba(201,162,39,0.65);
                background: rgba(15,23,42,0.9);
            }

        textarea.input-field {
            min-height: 110px;
            resize: vertical;
        }

        .options-container {
            display: flex;
            flex-direction: column;
            gap: 8px;
            margin-top: 4px;
        }

        .option-label {
            display: flex;
            align-items: center;
            padding: 10px 12px;
            border-radius: 12px;
            border: 1px solid rgba(55,65,81,0.95);
            cursor: pointer;
            transition: all 0.2s ease;
            background: rgba(15,23,42,0.9);
            gap: 8px;
        }

            .option-label span {
                font-size: 0.92rem;
            }

            .option-label:hover {
                border-color: rgba(201,162,39,0.9);
                background: rgba(24,31,51,1);
                transform: translateX( @(isRtl ? "5px" : "-5px") );
            }

            .option-label input {
                cursor: pointer;
                width: 18px;
                height: 18px;
                accent-color: #c9a227;
            }

            .option-label.selected {
                border-color: rgba(201,162,39,1);
                background: radial-gradient(circle at top left, rgba(201,162,39,0.25) 0, rgba(15,23,42,1) 55%);
                font-weight: 600;
            }

        .file-upload {
            border-radius: 14px;
            padding: 20px;
            text-align: center;
            cursor: pointer;
            transition: all 0.25s ease;
            background: rgba(15,23,42,0.95);
            border: 1.5px dashed rgba(201,162,39,0.7);
        }

            .file-upload:hover {
                background: radial-gradient(circle at top, rgba(201,162,39,0.22) 0, rgba(15,23,42,1) 45%);
                transform: translateY(-1px);
            }

            .file-upload input {
                display: none;
            }

        .file-upload-text {
            color: #facc15;
            font-weight: 600;
            font-size: 0.95rem;
        }

        .file-name {
            margin-top: 6px;
            color: #9ca3af;
            font-size: 0.85rem;
        }

        .buttons {
            display: flex;
            justify-content: space-between;
            gap: 10px;
            margin-top: 18px;
            padding-top: 18px;
            border-top: 1px solid rgba(31,41,55,0.85);
        }

        .btn-sv {
            padding: 10px 22px;
            border-radius: 999px;
            font-size: 0.95rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
            font-family: inherit;
            border: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: .35rem;
        }

        .btn-sv-primary {
            background: linear-gradient(135deg,#c9a227,#facc15);
            color: #111827;
            flex: 1;
        }

            .btn-sv-primary:hover {
                filter: brightness(1.05);
                box-shadow: 0 8px 22px rgba(250,204,21,0.35);
                transform: translateY(-1px);
            }

        .btn-sv-secondary {
            background: rgba(15,23,42,0.9);
            color: #e5e7eb;
            border: 1px solid rgba(148,163,184,0.5);
            min-width: 120px;
        }

            .btn-sv-secondary:hover {
                background: rgba(31,41,55,1);
                transform: translateY(-1px);
            }

        .btn-sv:disabled {
            opacity: 0.45;
            cursor: not-allowed;
            box-shadow: none;
            transform: none;
        }

        .error-message {
            color: #fb7185;
            font-size: 0.8rem;
            margin-top: 6px;
            display: none;
        }

        .success-screen {
            text-align: center;
            padding: 40px 26px 30px;
            display: none;
        }

        .success-icon {
            font-size: 3.5rem;
            margin-bottom: 14px;
            color: #22c55e;
        }

        .success-title {
            font-size: 1.4rem;
            margin-bottom: 8px;
            font-weight: 700;
        }

        .success-message {
            color: #9ca3af;
            font-size: 0.95rem;
            line-height: 1.7;
        }

        @@keyframes sv-slide-in {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes sv-fade-in {
            from {
                opacity: 0;
                transform: translateY(8px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@media (max-width: 768px) {
            .survey-card {
                border-radius: 18px;
            }

            .survey-header {
                padding: 22px 18px 18px;
            }

            .survey-body {
                padding: 20px 16px 16px;
            }

            .sv-header-badge {
                position: static;
                margin-top: 8px;
            }

            .buttons {
                flex-direction: column-reverse;
            }
        }
    </style>
}

<div class="survey-shell">
    <form id="afTokenForm" class="d-none">@Html.AntiForgeryToken()</form>

    <div class="survey-card">
        <div class="survey-header header">
            <div>
                <h1>@(Model?.HeaderTitle ?? L["Survey_DefaultTitle"])</h1>
                <p id="headerDescription">
                    @(Model?.HeaderDescription ?? L["Survey_DefaultDescription"])
                </p>
            </div>

            <div class="sv-header-badge">
                <span>🧾</span>
                <span>@L["Survey_Badge"]</span>
            </div>

            <div class="progress-container mt-3">
                <div class="progress-bar" id="progressBar"></div>
            </div>
            <div class="progress-text" id="progressText">
                @initialProgressText
            </div>
        </div>

        <div class="survey-body" id="surveyContent">
            @* تُملأ بالـ JS *@
        </div>

        <div class="success-screen" id="successScreen">
            <div class="success-icon">✓</div>
            <h2 class="success-title">@L["Survey_Success_Title"]</h2>
            <p class="success-message">
                @L["Survey_Success_Message"]
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // ===== بيانات من السيرفر =====
        const surveyData = @Html.Raw(json);
        const surveyTexts = @Html.Raw(surveyTextsJson);

        // ===== الحالة العامة =====
        const antiForgeryToken =
            document.querySelector('#afTokenForm input[name="__RequestVerificationToken"]')?.value || '';

        let currentGroupIndex = 0;
        // answers[itemId] = { questionId, type, value }
        let answers = {};

        function formatProgress(current, total) {
            const template = surveyTexts.progressFormat || 'Page {current} of {total}';
            return template
                .replace('{current}', current)
                .replace('{total}', total);
        }

        // ===== تخزين/تحميل محلي =====
        function loadAnswers() {
            try {
                const saved = localStorage.getItem('surveyAnswers');
                if (saved) answers = JSON.parse(saved) || {};
            } catch {
                answers = {};
            }
        }
        function saveAnswers() {
            localStorage.setItem('surveyAnswers', JSON.stringify(answers));
        }

        function findItemById(id) {
            for (const g of surveyData || []) {
                for (const it of (g.Items || [])) {
                    if (it.Id === id) return { ...it, qId: g.Id };
                }
            }
            return { Id: id, Type: 1 };
        }

        function setAnswer(item, value) {
            answers[item.Id] = { questionId: item.Id, type: item.Type, value };
            saveAnswers();
            hideError(item.Id);
        }

        function getStoredValue(item) {
            const a = answers[item.Id];
            if (!a) return undefined;
            return (typeof a === 'object' && a !== null && 'value' in a) ? a.value : a;
        }

        // ===== التقدم =====
        function updateProgress() {
            const total = Math.max(1, (surveyData || []).length);
            const progress = ((currentGroupIndex + 1) / total) * 100;
            const bar = document.getElementById('progressBar');
            if (bar) bar.style.width = progress + '%';

            const txt = document.getElementById('progressText');
            if (txt) txt.textContent = formatProgress(currentGroupIndex + 1, total);
        }

        // ===== الرسم =====
        function renderGroup() {
            const group = (surveyData || [])[currentGroupIndex];
            const content = document.getElementById('surveyContent');

            if (!group) {
                content.innerHTML = `<div class="group-description">${surveyTexts.noQuestions}</div>`;
                updateProgress();
                return;
            }

            let html = '';
            html += `<div class="group-title">${group.Title ?? ''}</div>`;
            html += `<div class="group-description">${group.Description ?? ''}</div>`;

            (group.Items ?? []).forEach(item => { html += renderQuestion(item); });

            html += `
                <div class="buttons">
                    <button type="button"
                            class="btn-sv btn-sv-secondary"
                            id="prevBtn"
                            ${(currentGroupIndex === 0) ? 'disabled' : ''}>
                        ${surveyTexts.buttonPrevious}
                    </button>
                    <button type="button"
                            class="btn-sv btn-sv-primary"
                            id="nextBtn">
                        ${currentGroupIndex === Math.max(1, (surveyData?.length ?? 1)) - 1
                            ? surveyTexts.buttonSubmit
                            : surveyTexts.buttonNext}
                    </button>
                </div>`;

            content.innerHTML = html;
            updateProgress();
            attachEventListeners();
            restoreAnswers();
        }

        function renderQuestion(item) {
            const required = item.IsRequired ? '<span class="required">*</span>' : '';
            const v = getStoredValue(item);
            const id = item.Id;
            let html = `
                <div class="question" data-id="${id}">
                    <div class="question-text">${item.Text ?? ''} ${required}</div>`;

            const csv = (item.OptionsCsv ?? '')
                .toString()
                .split(',')
                .map(s => s.trim())
                .filter(Boolean);

            switch (item.Type) {
                case 1: // نص
                    html += `<textarea class="input-field"
                                       data-id="${id}"
                                       placeholder="${surveyTexts.textareaPlaceholder}">${v ?? ''}</textarea>`;
                    break;

                case 2: // نعم/لا
                case 3: // اختيار واحد
                    html += '<div class="options-container">';
                    csv.forEach(option => {
                        const checked = v === option ? 'checked' : '';
                        const selected = v === option ? 'selected' : '';
                        html += `
                            <label class="option-label ${selected}">
                                <input type="radio"
                                       name="q${id}"
                                       value="${option}"
                                       data-id="${id}"
                                       ${checked} />
                                <span>${option}</span>
                            </label>`;
                    });
                    html += '</div>';
                    break;

                case 4: // اختيارات متعددة
                    html += '<div class="options-container">';
                    const arr = Array.isArray(v) ? v : [];
                    csv.forEach(option => {
                        const checked = arr.includes(option) ? 'checked' : '';
                        const selected = arr.includes(option) ? 'selected' : '';
                        html += `
                            <label class="option-label ${selected}">
                                <input type="checkbox"
                                       name="q${id}"
                                       value="${option}"
                                       data-id="${id}"
                                       ${checked} />
                                <span>${option}</span>
                            </label>`;
                    });
                    html += '</div>';
                    break;

                case 5: // رقم
                    html += `<input type="number"
                                    class="input-field"
                                    data-id="${id}"
                                    placeholder="${surveyTexts.numberPlaceholder}"
                                    value="${v ?? ''}">`;
                    break;

                case 6: // تاريخ
                    html += `<input type="date"
                                    class="input-field"
                                    data-id="${id}"
                                    value="${v ?? ''}">`;
                    break;

                case 7: // ملف
                    const hasFile = !!v;
                    const fileLabel = hasFile ? surveyTexts.fileSelected : '';
                    html += `
                        <div class="file-upload"
                             onclick="document.getElementById('file${id}').click()">
                            <input type="file"
                                   id="file${id}"
                                   data-id="${id}"
                                   accept="image/*,application/pdf">
                            <div class="file-upload-text">${surveyTexts.fileUploadPrompt}</div>
                            <div class="file-name" id="fileName${id}">${fileLabel}</div>
                        </div>`;
                    break;
            }

            html += `<div class="error-message" id="error${id}">${surveyTexts.requiredError}</div></div>`;
            return html;
        }

        // ===== الأحداث =====
        function attachEventListeners() {
            document.querySelectorAll('.input-field').forEach(input => {
                input.addEventListener('input', (e) => {
                    const id = parseInt(e.target.dataset.id);
                    const item = findItemById(id);
                    setAnswer(item, e.target.value);
                });
            });

            document.querySelectorAll('input[type="radio"]').forEach(radio => {
                radio.addEventListener('change', (e) => {
                    const id = parseInt(e.target.dataset.id);
                    const item = findItemById(id);
                    setAnswer(item, e.target.value);

                    const labels = e.target.closest('.options-container')?.querySelectorAll('.option-label') || [];
                    labels.forEach(l => l.classList.remove('selected'));
                    e.target.closest('.option-label')?.classList.add('selected');
                });
            });

            document.querySelectorAll('input[type="checkbox"]').forEach(chk => {
                chk.addEventListener('change', (e) => {
                    const id = parseInt(e.target.dataset.id);
                    const item = findItemById(id);
                    const allChecked = document.querySelectorAll(`input[name="q${id}"]:checked`);
                    const arr = Array.from(allChecked).map(c => c.value);
                    setAnswer(item, arr);

                    e.target.closest('.option-label')?.classList
                        .toggle('selected', e.target.checked);
                });
            });

            document.querySelectorAll('input[type="file"]').forEach(fileInput => {
                fileInput.addEventListener('change', (e) => {
                    const id = parseInt(e.target.dataset.id);
                    const item = findItemById(id);
                    const file = e.target.files?.[0];
                    if (!file) return;

                    const reader = new FileReader();
                    reader.onload = (ev) => {
                        setAnswer(item, ev.target.result);
                        const nameEl = document.getElementById(`fileName${id}`);
                        if (nameEl) nameEl.textContent = surveyTexts.fileSelected;
                    };
                    reader.readAsDataURL(file);
                });
            });

            document.getElementById('prevBtn')?.addEventListener('click', () => {
                if (currentGroupIndex > 0) {
                    currentGroupIndex--;
                    renderGroup();
                }
            });

            document.getElementById('nextBtn')?.addEventListener('click', () => {
                if (validateCurrentGroup()) {
                    if (currentGroupIndex < (surveyData?.length ?? 1) - 1) {
                        currentGroupIndex++;
                        renderGroup();
                    } else {
                        submitSurvey();
                    }
                }
            });
        }

        function restoreAnswers() {
            const group = (surveyData || [])[currentGroupIndex];
            (group?.Items ?? []).forEach(item => {
                const v = getStoredValue(item);
                if (v === undefined) return;

                if (item.Type === 4 && Array.isArray(v)) {
                    v.forEach(value => {
                        const checkbox = document
                            .querySelector(`input[name="q${item.Id}"][value="${value}"]`);
                        if (checkbox) {
                            checkbox.checked = true;
                            checkbox.closest('.option-label')?.classList.add('selected');
                        }
                    });
                }

                if (item.Type === 7 && v) {
                    const el = document.getElementById(`fileName${item.Id}`);
                    if (el) el.textContent = surveyTexts.fileSelected;
                }
            });
        }

        function validateCurrentGroup() {
            const group = (surveyData || [])[currentGroupIndex];
            let isValid = true;

            (group?.Items ?? []).forEach(item => {
                if (!item.IsRequired) return;
                const val = getStoredValue(item);
                const empty =
                    val === undefined || val === null ||
                    (Array.isArray(val) && val.length === 0) ||
                    (typeof val === 'string' && val.trim() === '');
                if (empty) {
                    showError(item.Id);
                    isValid = false;
                }
            });

            return isValid;
        }

        function showError(id) {
            const el = document.getElementById(`error${id}`);
            if (el) el.style.display = 'block';
        }

        function hideError(id) {
            const el = document.getElementById(`error${id}`);
            if (el) el.style.display = 'none';
        }

        function toArrayPayload() {
            const out = [];
            for (const g of (surveyData || [])) {
                for (const it of (g.Items || [])) {
                    const v = getStoredValue(it);
                    out.push({
                        questionId: g.Id,
                        questionItemId: it.Id,
                        value: v ?? null
                    });
                }
            }
            return out;
        }

        async function submitSurvey() {
            const payload = toArrayPayload();

            try {
                const res = await fetch('@Url.Action("Submit", "UserQuestions")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': antiForgeryToken
                    },
                    body: JSON.stringify(payload)
                });
                if (!res.ok) throw new Error(surveyTexts.submitError || 'Failed to submit');
            } catch (e) {
                console.error(e);
            }

            localStorage.removeItem('surveyAnswers');
            document.getElementById('surveyContent').style.display = 'none';
            document.getElementById('successScreen').style.display = 'block';

            const hdr = document.querySelector('.survey-header');
            if (hdr && hdr.style) hdr.style.display = 'none';
        }

        // تشغيل أولي
        loadAnswers();
        renderGroup();
    </script>
}
