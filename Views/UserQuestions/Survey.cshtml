@model PeerReview.MvcHotel.Models.SurveyViewModel
@using Microsoft.AspNetCore.Mvc.Localization
@using System.Text.Json
@using System.Text.Encodings.Web
@inject IViewLocalizer L

@{
    var fallbackTitle = L["Survey_DefaultTitle"].Value;
    var fallbackDescription = L["Survey_DefaultDescription"].Value;
    ViewData["Title"] = Model?.HeaderTitle ?? fallbackTitle;
    var headerTitle = Model?.HeaderTitle ?? fallbackTitle;
    var headerDescription = Model?.HeaderDescription ?? fallbackDescription;
    var groups = Model?.Groups ?? new List<QuestionGroup>();

    var json = JsonSerializer.Serialize(
        groups,
        new JsonSerializerOptions
        {
            PropertyNamingPolicy = null,
            Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping
        });

    var ci = System.Globalization.CultureInfo.CurrentUICulture;
    var isRtl = ci.TwoLetterISOLanguageName == "ar";
    var progressTemplate = L["Survey_Progress_Template"].Value;
    var initialProgressText = progressTemplate.Replace("{current}", "1").Replace("{total}", "1");
    var jsEncoder = JavaScriptEncoder.Default;
    var jsNoQuestions = jsEncoder.Encode(L["Survey_NoQuestions"].Value);
    var jsPrev = jsEncoder.Encode(L["Survey_Previous"].Value);
    var jsNext = jsEncoder.Encode(L["Survey_Next"].Value);
    var jsSubmit = jsEncoder.Encode(L["Survey_Submit"].Value);
    var jsTextPlaceholder = jsEncoder.Encode(L["Survey_TextPlaceholder"].Value);
    var jsNumberPlaceholder = jsEncoder.Encode(L["Survey_NumberPlaceholder"].Value);
    var jsUploadPrompt = jsEncoder.Encode(L["Survey_FileUploadPrompt"].Value);
    var jsFileSelected = jsEncoder.Encode(L["Survey_FileSelected"].Value);
    var jsFieldRequired = jsEncoder.Encode(L["Survey_FieldRequired"].Value);
    var jsSubmitLoading = jsEncoder.Encode(L["Survey_Submitting"].Value);
    var jsSaveDraft = jsEncoder.Encode(L["Survey_SaveDraft"].Value);
}

@section Styles {
    <style>
        .survey-shell {
            max-width: 880px;
            margin: 0 auto;
        }

        .survey-card {
            background: var(--bg-panel);
            border-radius: 24px;
            box-shadow: 0 28px 70px rgba(234, 88, 12, 0.18);
            overflow: hidden;
            border: 1px solid var(--border-color);
            animation: sv-slide-in 0.4s ease-out;
        }

        .survey-header {
            background: radial-gradient(circle at 20% 20%, rgba(255, 205, 170, 0.35) 0, rgba(255, 240, 225, 0.92) 40%, rgba(255, 255, 255, 0.95) 100%);
            color: var(--text-main);
            padding: 32px 28px 26px;
            position: relative;
        }

            .survey-header h1 {
                font-size: 1.5rem;
                margin-bottom: 0.35rem;
                font-weight: 700;
            }

            .survey-header p {
                font-size: 0.95rem;
                opacity: 0.9;
                margin: 0;
            }

        .sv-header-badge {
            position: absolute;
            inset-inline-end: 24px;
            top: 24px;
            padding: .2rem .7rem;
            border-radius: 999px;
            font-size: .75rem;
            background: var(--bg-muted);
            border: 1px solid var(--border-color);
            display: inline-flex;
            align-items: center;
            gap: .35rem;
        }

            .sv-header-badge span {
                opacity: .85;
            }

        .progress-container {
            background: var(--bg-muted);
            height: 7px;
            border-radius: 999px;
            margin-top: 18px;
            overflow: hidden;
        }

        .progress-bar {
            height: 100%;
            background: linear-gradient(90deg, #c9a227, #facc15);
            border-radius: 999px;
            transition: width 0.35s ease;
            box-shadow: 0 0 14px rgba(250, 204, 21, 0.7);
        }

        .progress-text {
            margin-top: 8px;
            font-size: 0.8rem;
            color: var(--text-muted);
        }

        .survey-body {
            padding: 26px 26px 22px;
            background: linear-gradient(180deg, rgba(255, 244, 235, 0.85), rgba(255, 255, 255, 0.95));
            color: var(--text-main);
        }

        .group-title {
            font-size: 1.25rem;
            margin-bottom: 6px;
            font-weight: 700;
        }

        .group-description {
            color: var(--text-muted);
            margin-bottom: 20px;
            font-size: 0.9rem;
            line-height: 1.6;
        }

        .question {
            margin-bottom: 22px;
            padding: 16px 16px 14px;
            border-radius: 18px;
            background: linear-gradient(145deg, rgba(255, 244, 235, 0.9), rgba(255, 230, 210, 0.9));
            border: 1px solid var(--border-color);
            box-shadow: 0 18px 38px rgba(234, 88, 12, 0.16);
            animation: sv-fade-in 0.25s ease-out;
        }

        .question-text {
            font-size: 0.98rem;
            margin-bottom: 10px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .required {
            color: #f97373;
            font-size: 1.1em;
        }

        .input-field {
            width: 100%;
            padding: 10px 12px;
            border-radius: 12px;
            font-size: 0.95rem;
            border: 1px solid var(--border-color);
            background: var(--bg-panel);
            color: var(--text-main);
            font-family: inherit;
            transition: all 0.25s ease;
        }

            .input-field:focus {
                outline: none;
                border-color: rgba(249, 115, 22, 0.55);
                box-shadow: 0 0 0 3px rgba(249, 115, 22, 0.15);
                background: #fff;
            }

        textarea.input-field {
            min-height: 110px;
            resize: vertical;
        }

        .options-container {
            display: flex;
            flex-direction: column;
            gap: 8px;
            margin-top: 4px;
        }

        .option-label {
            display: flex;
            align-items: center;
            padding: 10px 12px;
            border-radius: 12px;
            border: 1px solid var(--border-color);
            cursor: pointer;
            transition: all 0.2s ease;
            background: var(--bg-muted);
            gap: 8px;
        }

            .option-label span {
                font-size: 0.92rem;
            }

            .option-label:hover {
                border-color: rgba(249, 115, 22, 0.4);
                background: rgba(249, 115, 22, 0.08);
                transform: translateX( @(isRtl ? "5px" : "-5px") );
            }

            .option-label input {
                cursor: pointer;
                width: 18px;
                height: 18px;
                accent-color: #c9a227;
            }

            .option-label.selected {
                border-color: rgba(249, 115, 22, 0.55);
                background: linear-gradient(135deg, rgba(255, 230, 210, 0.9), rgba(255, 244, 235, 1));
                font-weight: 600;
            }

        .file-upload {
            border-radius: 14px;
            padding: 20px;
            text-align: center;
            cursor: pointer;
            transition: all 0.25s ease;
            background: var(--bg-muted);
            border: 1.5px dashed rgba(249, 115, 22, 0.55);
        }

            .file-upload:hover {
                background: radial-gradient(circle at top, rgba(249, 115, 22, 0.12) 0, rgba(255, 255, 255, 0.95) 45%);
                transform: translateY(-1px);
            }

            .file-upload input {
                display: none;
            }

        .file-upload-text {
            color: var(--color-primary);
            font-weight: 600;
            font-size: 0.95rem;
        }

        .file-name {
            margin-top: 6px;
            color: var(--text-muted);
            font-size: 0.85rem;
        }

        .buttons {
            display: flex;
            justify-content: space-between;
            gap: 10px;
            margin-top: 18px;
            padding-top: 18px;
            border-top: 1px solid var(--border-color);
        }

        .btn-sv {
            padding: 10px 22px;
            border-radius: 999px;
            font-size: 0.95rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
            font-family: inherit;
            border: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: .35rem;
        }

        .btn-sv-primary {
            background: linear-gradient(135deg,#c9a227,#facc15);
            color: #111827;
            flex: 1;
        }

            .btn-sv-primary:hover {
                filter: brightness(1.05);
                box-shadow: 0 8px 22px rgba(250,204,21,0.35);
                transform: translateY(-1px);
            }

        .btn-sv-secondary {
            background: var(--bg-muted);
            color: var(--text-main);
            border: 1px solid var(--border-color);
            min-width: 120px;
        }

            .btn-sv-secondary:hover {
                background: rgba(249, 115, 22, 0.1);
                transform: translateY(-1px);
            }

        .btn-sv:disabled {
            opacity: 0.45;
            cursor: not-allowed;
            box-shadow: none;
            transform: none;
        }

        .btn-sv-xs {
            padding: 4px 10px;
            font-size: 0.8rem;
        }

        .error-message {
            color: #fb7185;
            font-size: 0.8rem;
            margin-top: 6px;
            display: none;
        }

        .success-screen {
            text-align: center;
            padding: 40px 26px 30px;
            display: none;
        }

        .success-icon {
            font-size: 3.5rem;
            margin-bottom: 14px;
            color: #22c55e;
        }

        .success-title {
            font-size: 1.4rem;
            margin-bottom: 8px;
            font-weight: 700;
        }

        .success-message {
            color: var(--text-muted);
            font-size: 0.95rem;
            line-height: 1.7;
        }

        .file-list {
            margin-top: 8px;
            padding-left: 0;
            list-style: none;
        }

            .file-list li a {
                font-size: 0.9rem;
            }

        /* overlay FULL SCREEN */
        .sv-loading-overlay {
            position: fixed;
            inset: 0;
            background: rgba(15, 23, 42, 0.45);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 9999;
        }

        .sv-loading-inner {
            background: rgba(255, 255, 255, 0.96);
            border-radius: 18px;
            padding: 16px 22px;
            box-shadow: 0 18px 40px rgba(15, 23, 42, 0.4);
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
            min-width: 220px;
        }

        .sv-loading-text {
            font-size: 0.9rem;
            color: var(--text-main);
        }

        @@keyframes sv-slide-in {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes sv-fade-in {
            from {
                opacity: 0;
                transform: translateY(8px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@media (max-width: 768px) {
            .survey-card {
                border-radius: 18px;
            }

            .survey-header {
                padding: 22px 18px 18px;
            }

            .survey-body {
                padding: 20px 16px 16px;
            }

            .sv-header-badge {
                position: static;
                margin-top: 8px;
            }

            .buttons {
                flex-direction: column-reverse;
            }
        }
    </style>
}

<div class="survey-shell">
    <form id="afTokenForm" class="d-none">@Html.AntiForgeryToken()</form>

    <div class="survey-card">
        <div class="survey-header header">
            <div>
                <h1>@headerTitle</h1>
                <p id="headerDescription">
                    @headerDescription
                </p>
            </div>

            <div class="sv-header-badge">
                <span>🧾</span>
                <span>@L["Survey_Badge_Label"]</span>
            </div>

            <div class="progress-container mt-3">
                <div class="progress-bar" id="progressBar"></div>
            </div>
            <div class="progress-text" id="progressText" data-template="@progressTemplate">
                @initialProgressText
            </div>
        </div>

        <div class="survey-body" id="surveyContent">
            @* تُملأ بالـ JS *@
        </div>

        <div class="success-screen" id="successScreen">
            <div class="success-icon">✓</div>
            <h2 class="success-title">@L["Survey_Success_Title"]</h2>
            <p class="success-message">
                @L["Survey_Success_Message"]
            </p>
        </div>
    </div>
</div>

<!-- FULL SCREEN Loader Overlay -->
<div class="sv-loading-overlay" id="surveyLoading">
    <div class="sv-loading-inner">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <div class="sv-loading-text">
            @L["Survey_Submitting"]
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // ===== بيانات من السيرفر =====
        const surveyData = @Html.Raw(json);
        const progressTextEl = document.getElementById('progressText');
        const progressTemplateText = progressTextEl?.dataset.template || '';
        const noQuestionsText = '@jsNoQuestions';
        const prevLabel = '@jsPrev';
        const nextLabel = '@jsNext';
        const submitLabel = '@jsSubmit';
        const textPlaceholder = '@jsTextPlaceholder';
        const numberPlaceholder = '@jsNumberPlaceholder';
        const uploadPromptText = '@jsUploadPrompt';
        const fileSelectedText = '@jsFileSelected';
        const fieldRequiredText = '@jsFieldRequired';
        const submitLoadingText = '@jsSubmitLoading';
        const saveDraftLabel = '@jsSaveDraft';

        // ===== الحالة العامة =====
        const antiForgeryToken =
            document.querySelector('#afTokenForm input[name="__RequestVerificationToken"]')?.value || '';

        let currentGroupIndex = 0;

        // answers[key] = { questionId, questionItemId, type, value }
        // key = `${groupId}_${itemId}`
        const answers = {};

        // files[key] = [ { answerFileId, fileName, fileUrl } ]
        const uploadedFiles = {};

        function makeKey(groupId, itemId) {
            return `${groupId}_${itemId}`;
        }

        // ===== البحث عن Item حسب (groupId, itemId) =====
        function findItem(groupId, itemId) {
            const g = (surveyData || []).find(x => x.Id === groupId);
            if (!g) return { Id: itemId, Type: 1, qId: groupId };
            const it = (g.Items || []).find(x => x.Id === itemId) || { Id: itemId, Type: 1 };
            return { ...it, qId: groupId };
        }

        function setAnswer(item, groupId, value) {
            const key = makeKey(groupId, item.Id);
            answers[key] = {
                questionId: groupId,       // Question (Group)
                questionItemId: item.Id,   // Item
                type: item.Type,
                value
            };
            hideError(groupId, item.Id);
        }

        function getStoredValue(item, groupId) {
            const key = makeKey(groupId, item.Id);
            const a = answers[key];
            if (!a) return undefined;
            return (typeof a === 'object' && a !== null && 'value' in a) ? a.value : a;
        }

        // ===== التقدم =====
        function updateProgress() {
            const total = Math.max(1, (surveyData || []).length);
            const progress = ((currentGroupIndex + 1) / total) * 100;
            const bar = document.getElementById('progressBar');
            if (bar) bar.style.width = progress + '%';

            const txt = document.getElementById('progressText');
            if (txt) {
                if (progressTemplateText) {
                    txt.textContent = progressTemplateText
                        .replace('{current}', `${currentGroupIndex + 1}`)
                        .replace('{total}', `${total}`);
                } else {
                    txt.textContent = `${currentGroupIndex + 1} / ${total}`;
                }
            }
        }

        // ===== رسم قائمة الملفات لسؤال معيّن =====
        function renderFileList(groupId, itemId) {
            const key = makeKey(groupId, itemId);
            const listEl = document.getElementById(`fileList_${key}`);
            if (!listEl) return;

            const arr = uploadedFiles[key] || [];
            if (arr.length === 0) {
                listEl.innerHTML = '';
                return;
            }

            listEl.innerHTML = arr.map(f => `
                <li class="d-flex align-items-center justify-content-between mb-1" data-afid="${f.answerFileId}">
                    <a href="${f.fileUrl}" target="_blank">
                        ${f.fileName}
                    </a>
                    <button type="button"
                            class="btn-sv btn-sv-secondary btn-sv-xs"
                            onclick="deleteUploadedFile(${groupId}, ${itemId}, ${f.answerFileId})">
                        ✕
                    </button>
                </li>
            `).join('');
        }

        // ===== الرسم =====
        function renderGroup() {
            const group = (surveyData || [])[currentGroupIndex];
            const content = document.getElementById('surveyContent');

            if (!group) {
                content.innerHTML = `<div class="group-description">${noQuestionsText}</div>`;
                updateProgress();
                return;
            }

            let html = '';
            html += `<div class="group-title">${group.Title ?? ''}</div>`;
            html += `<div class="group-description">${group.Description ?? ''}</div>`;

            (group.Items ?? []).forEach(item => { html += renderQuestion(item, group.Id); });

            html += `
                <div class="buttons">
                    <button type="button"
                            class="btn-sv btn-sv-secondary"
                            id="prevBtn"
                            ${(currentGroupIndex === 0) ? 'disabled' : ''}>
                        ${prevLabel}
                    </button>

                    <button type="button"
                            class="btn-sv btn-sv-secondary"
                            id="saveDraftBtn">
                        ${saveDraftLabel}
                    </button>

                    <button type="button"
                            class="btn-sv btn-sv-primary"
                            id="nextBtn">
                        ${currentGroupIndex === (surveyData?.length ?? 1) - 1
                            ? submitLabel
                            : nextLabel}
                    </button>
                </div>`;

            content.innerHTML = html;
            updateProgress();
            attachEventListeners();
            restoreAnswers();
        }

        function renderQuestion(item, groupId) {
            const required = item.IsRequired ? '<span class="required">*</span>' : '';
            const v = getStoredValue(item, groupId);
            const id = item.Id;
            const key = makeKey(groupId, id);

            let html = `
                <div class="question" data-gid="${groupId}" data-id="${id}">
                    <div class="question-text">${item.Text ?? ''} ${required}</div>`;

            const csv = (item.OptionsCsv ?? '')
                .toString()
                .split(',')
                .map(s => s.trim())
                .filter(Boolean);

            switch (item.Type) {
                case 1: // نص
                    html += `<textarea class="input-field"
                                       data-gid="${groupId}"
                                       data-id="${id}"
                                       placeholder="${textPlaceholder}">${v ?? ''}</textarea>`;
                    break;

                case 2: // نعم/لا
                case 3: // اختيار واحد
                    html += '<div class="options-container">';
                    csv.forEach(option => {
                        const checked = v === option ? 'checked' : '';
                        const selected = v === option ? 'selected' : '';
                        html += `
                            <label class="option-label ${selected}">
                                <input type="radio"
                                       name="q${key}"
                                       value="${option}"
                                       data-gid="${groupId}"
                                       data-id="${id}"
                                       ${checked} />
                                <span>${option}</span>
                            </label>`;
                    });
                    html += '</div>';
                    break;

                case 4: // اختيارات متعددة
                    html += '<div class="options-container">';
                    const arr = Array.isArray(v) ? v : [];
                    csv.forEach(option => {
                        const checked = arr.includes(option) ? 'checked' : '';
                        const selected = arr.includes(option) ? 'selected' : '';
                        html += `
                            <label class="option-label ${selected}">
                                <input type="checkbox"
                                       name="q${key}"
                                       value="${option}"
                                       data-gid="${groupId}"
                                       data-id="${id}"
                                       ${checked} />
                                <span>${option}</span>
                            </label>`;
                    });
                    html += '</div>';
                    break;

                case 5: // رقم
                    html += `<input type="number"
                                    class="input-field"
                                    data-gid="${groupId}"
                                    data-id="${id}"
                                    placeholder="${numberPlaceholder}"
                                    value="${v ?? ''}">`;
                    break;

                case 6: // تاريخ
                    html += `<input type="date"
                                    class="input-field"
                                    data-gid="${groupId}"
                                    data-id="${id}"
                                    value="${v ?? ''}">`;
                    break;

                case 7: // ملف (multi-file)
                    const hasFile = !!v;
                    const fileLabel = hasFile ? fileSelectedText : '';
                    html += `
                        <div class="file-upload"
                             onclick="document.getElementById('file_${key}').click()">
                            <input type="file"
                                   id="file_${key}"
                                   data-gid="${groupId}"
                                   data-id="${id}"
                                   multiple
                                   accept="image/*,application/pdf">
                            <div class="file-upload-text">📁 ${uploadPromptText}</div>
                            <div class="file-name" id="fileName_${key}">${fileLabel}</div>
                        </div>
                        <ul class="file-list" id="fileList_${key}"></ul>
                    `;
                    break;
            }

            html += `<div class="error-message" id="error_${key}">${fieldRequiredText}</div></div>`;
            return html;
        }

        // ===== الأحداث =====
        function attachEventListeners() {
            document.querySelectorAll('.input-field').forEach(input => {
                input.addEventListener('input', (e) => {
                    const gid = parseInt(e.target.dataset.gid);
                    const id = parseInt(e.target.dataset.id);
                    const item = findItem(gid, id);
                    setAnswer(item, gid, e.target.value);
                });
            });

            document.querySelectorAll('input[type="radio"]').forEach(radio => {
                radio.addEventListener('change', (e) => {
                    const gid = parseInt(e.target.dataset.gid);
                    const id = parseInt(e.target.dataset.id);
                    const item = findItem(gid, id);
                    setAnswer(item, gid, e.target.value);

                    const key = makeKey(gid, id);
                    const labels = document.querySelectorAll(`input[name="q${key}"]`) ?? [];
                    labels.forEach(r => r.closest('.option-label')?.classList.remove('selected'));
                    e.target.closest('.option-label')?.classList.add('selected');
                });
            });

            document.querySelectorAll('input[type="checkbox"]').forEach(chk => {
                chk.addEventListener('change', (e) => {
                    const gid = parseInt(e.target.dataset.gid);
                    const id = parseInt(e.target.dataset.id);
                    const item = findItem(gid, id);
                    const key = makeKey(gid, id);

                    const allChecked = document.querySelectorAll(
                        `input[type="checkbox"][name="q${key}"]:checked`
                    );
                    const arr = Array.from(allChecked).map(c => c.value);
                    setAnswer(item, gid, arr);

                    e.target.closest('.option-label')?.classList
                        .toggle('selected', e.target.checked);
                });
            });

            // ====== MULTI FILE UPLOAD ======
            document.querySelectorAll('input[type="file"]').forEach(fileInput => {
                fileInput.addEventListener('change', async (e) => {
                    const gid = parseInt(e.target.dataset.gid);
                    const id = parseInt(e.target.dataset.id);
                    const item = findItem(gid, id);
                    const key = makeKey(gid, id);

                    const files = Array.from(e.target.files || []);
                    if (!files.length) return;

                    const nameEl = document.getElementById(`fileName_${key}`);
                    if (nameEl) nameEl.textContent = '... Uploading';

                    let successCount = 0;
                    if (!uploadedFiles[key]) uploadedFiles[key] = [];

                    try {
                        for (const file of files) {
                            const formData = new FormData();
                            formData.append('questionId', item.qId);
                            formData.append('questionItemId', item.Id);
                            formData.append('file', file);

                            const res = await fetch('/user-questions/upload', {
                                method: 'POST',
                                headers: {
                                    'RequestVerificationToken': antiForgeryToken
                                },
                                body: formData
                            });

                            if (!res.ok) {
                                console.error('Upload failed: ', res.status);
                                continue;
                            }

                            const data = await res.json();
                            successCount++;

                            uploadedFiles[key].push({
                                answerFileId: data.answerFileId || data.AnswerFileId,
                                fileName: data.fileName || data.FileName || file.name,
                                fileUrl: data.fileUrl || data.FileUrl || ''
                            });
                        }

                        if (successCount > 0) {
                            // اعتبر السؤال متجاوب عليه (فيه ملفات مرفوعة)
                            setAnswer(item, gid, '__uploaded__');

                            if (nameEl) {
                                nameEl.textContent =
                                    successCount === 1
                                        ? fileSelectedText
                                        : `${fileSelectedText} (${uploadedFiles[key].length})`;
                            }

                            renderFileList(gid, id);
                        } else {
                            if (nameEl) nameEl.textContent = 'Upload failed';
                            delete answers[key];
                        }
                    } catch (err) {
                        console.error(err);
                        if (nameEl) nameEl.textContent = 'Upload failed';
                        delete answers[key];
                    }
                });
            });

            document.getElementById('prevBtn')?.addEventListener('click', () => {
                if (currentGroupIndex > 0) {
                    currentGroupIndex--;
                    renderGroup();
                }
            });

            document.getElementById('nextBtn')?.addEventListener('click', () => {
                if (validateCurrentGroup()) {
                    if (currentGroupIndex < (surveyData?.length ?? 1) - 1) {
                        currentGroupIndex++;
                        renderGroup();
                    } else {
                        submitSurvey();
                    }
                }
            });

            document.getElementById('saveDraftBtn')?.addEventListener('click', () => {
                saveDraft();
            });
        }

        // حذف ملف واحد
        async function deleteUploadedFile(groupId, itemId, answerFileId) {
            const key = makeKey(groupId, itemId);

            try {
                const res = await fetch(`/user-questions/delete-file/${answerFileId}`, {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': antiForgeryToken
                    }
                });

                if (!res.ok) {
                    console.error('Delete failed: ', res.status);
                    alert('Failed to delete file');
                    return;
                }

                uploadedFiles[key] = (uploadedFiles[key] || [])
                    .filter(f => f.answerFileId !== answerFileId);

                if (!uploadedFiles[key].length) {
                    // لو السؤال Required، نخليه بدون قيمة عشان الفاليديشن يمسكه
                    delete answers[key];
                } else {
                    const item = findItem(groupId, itemId);
                    setAnswer(item, groupId, '__uploaded__');
                }

                renderFileList(groupId, itemId);
            }
            catch (e) {
                console.error(e);
                alert('Failed to delete file');
            }
        }

        function restoreAnswers() {
            const group = (surveyData || [])[currentGroupIndex];
            const gid = group?.Id;
            if (!gid) return;

            (group.Items || []).forEach(item => {
                const v = getStoredValue(item, gid);
                const key = makeKey(gid, item.Id);

                if (v === undefined) {
                    if (item.Type === 7) {
                        renderFileList(gid, item.Id);
                    }
                    return;
                }

                if ((item.Type === 2 || item.Type === 3)) {
                    const radios = document.querySelectorAll(`input[type="radio"][name="q${key}"]`);
                    radios.forEach(r => {
                        r.checked = (r.value === v);
                        r.closest('.option-label')?.classList
                            .toggle('selected', r.checked);
                    });
                }

                if (item.Type === 4 && Array.isArray(v)) {
                    const checkboxes = document.querySelectorAll(`input[type="checkbox"][name="q${key}"]`);
                    checkboxes.forEach(c => {
                        c.checked = v.includes(c.value);
                        c.closest('.option-label')?.classList
                            .toggle('selected', c.checked);
                    });
                }

                if (item.Type === 1 || item.Type === 5 || item.Type === 6) {
                    const input = document.querySelector(
                        `.input-field[data-gid="${gid}"][data-id="${item.Id}"]`
                    );
                    if (input) input.value = v ?? '';
                }

                if (item.Type === 7) {
                    const el = document.getElementById(`fileName_${key}`);
                    if (el && v) el.textContent = fileSelectedText;
                    renderFileList(gid, item.Id);
                }
            });
        }

        function validateCurrentGroup() {
            const group = (surveyData || [])[currentGroupIndex];
            if (!group) return true;

            const gid = group.Id;
            let isValid = true;

            (group.Items ?? []).forEach(item => {
                if (!item.IsRequired) return;

                const val = getStoredValue(item, gid);
                const empty =
                    val === undefined || val === null ||
                    (Array.isArray(val) && val.length === 0) ||
                    (typeof val === 'string' && val.trim() === '');

                if (empty) {
                    showError(gid, item.Id);
                    isValid = false;
                }
            });

            return isValid;
        }

        function showError(groupId, itemId) {
            const key = makeKey(groupId, itemId);
            const el = document.getElementById(`error_${key}`);
            if (el) el.style.display = 'block';
        }

        function hideError(groupId, itemId) {
            const key = makeKey(groupId, itemId);
            const el = document.getElementById(`error_${key}`);
            if (el) el.style.display = 'none';
        }

        // ===== فحص القيمة الفارغة =====
        function isValueEmpty(v) {
            return v === undefined || v === null ||
                (Array.isArray(v) && v.length === 0) ||
                (typeof v === 'string' && v.trim() === '');
        }

        // ===== تحويل الإجابات إلى Payload =====
        // onlyAnswered = true → نرجع فقط الأسئلة اللي عليها إجابة (للـ Save Draft)
        function toArrayPayload(onlyAnswered = false) {
            const out = [];
            for (const g of (surveyData || [])) {
                const gid = g.Id;
                for (const it of (g.Items || [])) {
                    // لا نرسل الأسئلة من نوع ملف (Type 7) هنا
                    if (it.Type === 7) continue;

                    const v = getStoredValue(it, gid);

                    if (onlyAnswered && isValueEmpty(v)) {
                        continue;
                    }

                    out.push({
                        questionId: gid,
                        questionItemId: it.Id,
                        value: v ?? null
                    });
                }
            }
            return out;
        }

        // ===== حفظ جزئي: نرسل فقط الأسئلة المجاوَب عليها =====
                       // ===== حفظ جزئي: نرسل فقط الأسئلة المجاوَب عليها =====
        async function saveDraft() {
            const payload = toArrayPayload(true); // فقط المجاب عليها
            const json = JSON.stringify(payload);

            const btn = document.getElementById('saveDraftBtn');
            if (!btn) return;

            const originalLabel = btn.dataset.originalLabel || btn.textContent;
            btn.dataset.originalLabel = originalLabel;

            btn.disabled = true;
            btn.textContent = saveDraftLabel + '...';

            try {
                const res = await fetch('/user-questions/submit', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': antiForgeryToken
                    },
                    body: json
                });

                if (!res.ok) {
                    throw new Error('Failed to save draft: ' + res.status);
                }

                console.log('Draft saved');

                // نفس حركة submitSurvey تقريباً
                const content = document.getElementById('surveyContent');
                const success = document.getElementById('successScreen');
                const hdr = document.querySelector('.survey-header');

                if (content) content.style.display = 'none';
                if (hdr && hdr.style) hdr.style.display = 'none';

                if (success) {
                    // لو حاب تستخدم نفس نص الزر كعنوان
                    const titleEl = success.querySelector('.success-title');
                    if (titleEl) {
                        titleEl.textContent = saveDraftLabel; // مثلاً: "Save draft"
                    }

                    // ممكن تخلي الرسالة كما هي أو تعدلها لاحقًا من الـ resx
                    success.style.display = 'block';
                }

                // بعد ما يشوف الرسالة الحلوة -> ريفريش للصفحة
                setTimeout(() => {
                    window.location.reload();
                }, 1500); // 1.5 ثانية مثلاً

            } catch (e) {
                console.error(e);
                alert('Failed to save draft, please try again.');
            } finally {
                btn.disabled = false;
                btn.textContent = btn.dataset.originalLabel || saveDraftLabel;
            }
        }



        // ===== حالة الـ submit (loader + تعطيل الأزرار) =====
        function setSubmitting(isSubmitting) {
            const overlay = document.getElementById('surveyLoading');
            const nextBtn = document.getElementById('nextBtn');
            const prevBtn = document.getElementById('prevBtn');

            if (overlay) {
                overlay.style.display = isSubmitting ? 'flex' : 'none';
            }

            if (nextBtn) {
                if (isSubmitting) {
                    if (!nextBtn.dataset.originalLabel) {
                        nextBtn.dataset.originalLabel = nextBtn.innerHTML;
                    }
                    nextBtn.disabled = true;
                    nextBtn.innerHTML = `
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        ${submitLoadingText}
                    `;
                } else {
                    nextBtn.disabled = false;
                    if (nextBtn.dataset.originalLabel) {
                        nextBtn.innerHTML = nextBtn.dataset.originalLabel;
                    }
                }
            }

            if (prevBtn) {
                prevBtn.disabled = isSubmitting;
            }
        }

        async function submitSurvey() {
            const payload = toArrayPayload(); // كل الأسئلة (مجاوب/فاضي)
            const json = JSON.stringify(payload);

            console.log('JSON length (approx bytes):', json.length);

            setSubmitting(true);

            try {
                const res = await fetch('/user-questions/submit', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': antiForgeryToken
                    },
                    body: json
                });
                if (!res.ok)
                    throw new Error('Failed to submit: ' + res.status);

                setSubmitting(false);

                document.getElementById('surveyContent').style.display = 'none';
                document.getElementById('successScreen').style.display = 'block';
                const hdr = document.querySelector('.survey-header');
                if (hdr && hdr.style)
                    hdr.style.display = 'none';
            } catch (e) {
                console.error(e);
                setSubmitting(false);
                alert('Failed to submit, please try again.');
            }
        }

        // تشغيل أولي
        renderGroup();
    </script>
}
