@model PeerReview.MvcHotel.Models.SubLookupUpdateDto
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer L

@{
    ViewData["Title"] = L["EditSubLookup"];
}

<div class="container mt-4">
    <h3>@L["EditSubLookup"]</h3>

    <form asp-action="EditSub" method="post" class="mt-3">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        
        <div class="mb-3">
            <label asp-for="NameEn" class="form-label">@L["NameEn"]</label>
            <input asp-for="NameEn" class="form-control" />
            <span asp-validation-for="NameEn" class="text-danger"></span>
        </div>
       
       

        <button type="submit" class="btn btn-primary">@L["Save"]</button>
        <a asp-action="Index" class="btn btn-secondary">@L["Cancel"]</a>
    </form>
</div>
