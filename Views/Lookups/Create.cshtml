@model PeerReview.MvcHotel.Models.LookupCreateDto
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer L

@{
    ViewData["Title"] = L["AddLookup"];
    ViewBag.ActiveMenu = "Lookups";
}

@section Styles {
    <style>
        .lk-create-header-note {
            font-size: 0.85rem;
            color: var(--text-muted, #9ca3af);
        }

        .lk-create-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 1rem 1.25rem;
        }

        .pr-field span.field-hint {
            font-size: 0.75rem;
            color: var(--text-muted, #9ca3af);
            margin-top: 0.15rem;
            display: block;
        }
    </style>
}

<div class="pr-card">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <div class="h-section-title mb-1">
                @L["AddLookup"]
            </div>
            <div class="lk-create-header-note">
                @L["Lookups_Create_Hint"]
            </div>
        </div>

        <a asp-action="Index" class="btn-pr btn-pr-soft">
            <i class="bi bi-arrow-90deg-left me-1"></i>@L["Back"]
        </a>
    </div>

    <!-- Form -->
    <form asp-action="Create" method="post" class="mt-1">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

        <div class="lk-create-grid">
            <!-- Code -->
            <div>
                <div class="pr-field">
                    <input asp-for="Code" placeholder=" " />
                    <label asp-for="Code">@L["Code"]</label>
                    <span asp-validation-for="Code" class="text-danger small"></span>
                </div>
                <span class="field-hint">
                    @L["Lookup_Code_Hint"]
                </span>
            </div>

            <!-- NameEn -->
            <div>
                <div class="pr-field">
                    <input asp-for="NameEn" placeholder=" " />
                    <label asp-for="NameEn">@L["NameEn"]</label>
                    <span asp-validation-for="NameEn" class="text-danger small"></span>
                </div>
                <span class="field-hint">
                    @L["Lookup_NameEn_Hint"]
                </span>
            </div>

            
            <!-- TypeEn -->
            <div>
                <div class="pr-field">
                    <input asp-for="TypeEn" placeholder=" " />
                    <label asp-for="TypeEn">@L["TypeEn"]</label>
                    <span asp-validation-for="TypeEn" class="text-danger small"></span>
                </div>
                <span class="field-hint">
                    @L["Lookup_TypeEn_Hint"]
                </span>
            </div>

            

        <!-- Actions -->
        <div class="d-flex justify-content-end gap-2 mt-4">
            <button type="button"
                    class="btn-pr btn-pr-outline"
                    onclick="window.location='@Url.Action("Index", "Lookups")'">
                @L["Cancel"]
            </button>

            <button type="submit" class="btn-pr btn-pr-primary">
                <i class="bi bi-check2-circle me-1"></i>@L["Save"]
            </button>
        </div>
    </form>
</div>
