@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.AspNetCore.Mvc.Rendering
@inject IViewLocalizer L
@{
    
    var users = ViewBag.Users as List<User> ?? new();
    var qs = ViewBag.Questions as List<QuestionDto> ?? new();
}


<div class="modal fade" id="assignmentUpsertModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <form id="assignmentUpsertForm">
                @Html.AntiForgeryToken()

                <div class="modal-header">
                    <h5 class="modal-title">@L["Modal_Title"]</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["Btn_Close"]"></button>
                </div>

                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">@L["Field_QuestionsLabel"]</label>

                            <select id="questionIds" name="questionIds" class="form-select" multiple size="8">
                                @foreach (var q in qs)
                                {
                                    <option value="@q.Id">@( q.TitleEn)</option>
                                }
                            </select>
                            <div class="form-text">@L["Field_Questions_Hint"]</div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">@L["Field_UsersLabel"]</label>
                            <select id="userIds" name="userIds" class="form-select" multiple size="8">
                                @foreach (var u in users)
                                {
                                    <option value="@u.id">@u.fullName (@u.userName)</option>
                                }
                            </select>
                            <div class="form-text">@L["Field_Users_Hint"]</div>
                        </div>
                    </div>

                    <div id="upsertAlert" class="alert alert-danger mt-3 d-none"></div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@L["Btn_Cancel"]</button>
                    <button type="submit" class="btn btn-primary">@L["Btn_Save"]</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function(){
          $(document).off('submit', '#assignmentUpsertForm').on('submit', '#assignmentUpsertForm', function(e){
            e.preventDefault();

            const qSel = Array.from(document.querySelectorAll('#questionIds option:checked')).map(o => Number(o.value));
            const uSel = Array.from(document.querySelectorAll('#userIds option:checked')).map(o => Number(o.value));

            const alertBox = document.getElementById('upsertAlert');
            const showErr = (msg)=>{ alertBox.textContent = msg; alertBox.classList.remove('d-none'); };

            if (!qSel.length){ return showErr('@L["Alert_SelectQuestions"]'); }
            if (!uSel.length){ return showErr('@L["Alert_SelectUsers"]'); }
            alertBox.classList.add('d-none');

            const af = document.querySelector('#afTokenForm input[name="__RequestVerificationToken"]')?.value
                    || document.querySelector('#assignmentUpsertForm input[name="__RequestVerificationToken"]')?.value;
            fetch('/Assignments/Upsert', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': af
              },
              body: JSON.stringify({ questionIds: qSel, userIds: uSel })
            })
            .then(r => r.json())
            .then(j => {
              if (j && j.ok){
                bootstrap.Modal.getInstance(document.getElementById('assignmentUpsertModal')).hide();
                if (window.reloadAssignmentsTable) window.reloadAssignmentsTable(); // إعادة تحميل الجدول فقط
              } else {
                showErr(j?.message || '@L["Alert_SaveFailed"]');
              }
            })
            .catch(() => showErr('@L["Alert_SaveError"]'));
          });
        })();
    </script>
}
