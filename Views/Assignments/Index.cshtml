@using System.Collections.Generic
@using PeerReview.MvcHotel.Models
@inject Microsoft.Extensions.Localization.IStringLocalizer<PeerReview.MvcHotel.Resources.SharedResource> L
@model List<AssignmentDto>

@{
    ViewData["Title"] = L["Assignments_Title"];
    ViewBag.ActiveMenu = "Assignments";

    var users = ViewBag.Users as List<User> ?? new();
    var qs = ViewBag.Questions as List<QuestionDto> ?? new();
}

@section Styles {
    <style>
        .badge-active {
            background: #eaf6ed;
            color: #137333;
            border: 1px solid #cfe9d6;
            padding: .25rem .6rem;
            border-radius: 999px;
            font-size: .75rem;
        }

        .badge-inactive {
            background: #fff4e5;
            color: #8a5a00;
            border: 1px solid #ffe3bf;
            padding: .25rem .6rem;
            border-radius: 999px;
            font-size: .75rem;
        }

        .row-inactive {
            opacity: .6;
        }

        .dt-buttons .btn {
            border-radius: 999px;
            font-size: .8rem;
            padding-inline: .75rem;
        }

        .assign-filter-label {
            font-size: 0.8rem;
            color: var(--text-muted, #9ca3af);
            margin-bottom: 0.15rem;
        }

        /* 🔹 Multi-select dropdown شيك */
        .pr-multi {
            position: relative;
        }

        .pr-multi-toggle {
            width: 100%;
            border-radius: 999px;
            border: 1px solid var(--border-soft, rgba(148,163,184,0.35));
            background: rgba(15,23,42,0.7);
            padding: .45rem .85rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: .5rem;
            font-size: .85rem;
            cursor: pointer;
        }

            .pr-multi-toggle span {
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            .pr-multi-toggle .pr-multi-placeholder {
                opacity: .7;
            }

        .pr-multi-menu {
            position: absolute;
            inset-inline: 0;
            margin-top: .4rem;
            background: var(--panel, #020617);
            border-radius: 1rem;
            border: 1px solid var(--border-soft, rgba(148,163,184,0.35));
            box-shadow: 0 18px 45px rgba(15,23,42,.7);
            overflow: hidden;
            max-height: 260px;
            display: none;
            z-index: 1080;
        }

        .pr-multi.open .pr-multi-menu {
            display: block;
        }

        .pr-multi-header {
            padding: .45rem .85rem;
            border-bottom: 1px solid var(--border-soft, rgba(148,163,184,0.35));
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: .5rem;
            font-size: .8rem;
        }

            .pr-multi-header label {
                cursor: pointer;
                display: flex;
                align-items: center;
                gap: .35rem;
                margin: 0;
            }

        .pr-multi-list {
            max-height: 210px;
            overflow: auto;
            padding: .25rem .85rem .6rem;
        }

        .pr-multi-item {
            display: flex;
            align-items: flex-start;
            gap: .5rem;
            padding: .2rem 0;
            font-size: .85rem;
            cursor: pointer;
        }

            .pr-multi-item input[type="checkbox"] {
                margin-top: .2rem;
            }

            .pr-multi-item span {
                flex: 1;
            }

        .pr-multi-count {
            font-size: .75rem;
            opacity: .7;
        }

        /* تقصير النص في جدول الإسنادات */
        #assignTable td:nth-child(2) {
            max-width: 260px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
    </style>
}

<div class="row g-3">

    <!-- 🔹 Bulk Assignment -->
    <div class="col-lg-4">
        <div class="pr-card h-100">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <div class="h-section-title mb-0">
                    <span class="me-1">⚡</span>
                    @L["Assignments_Bulk_Title"]
                </div>
                <span class="badge-pill badge-soft">
                    @L["Assignments_Action_Activate"]
                </span>
            </div>

            <p class="text-muted-soft mb-3" style="font-size:0.85rem;">
                @L["Assignments_Bulk_Hint"]
            </p>

            <form id="bulkForm" class="mt-1">
                <!-- أسئلة -->
                <div class="mb-3">
                    <div class="assign-filter-label">@L["Assignments_Bulk_QuestionIds"]</div>

                    <div class="pr-multi"
                         data-placeholder="@L["Assignments_Bulk_Questions_Placeholder", "اختر الأسئلة"]"
                         data-group="questions">
                        <button type="button" class="pr-multi-toggle">
                            <span class="pr-multi-label pr-multi-placeholder">
                                @L["Assignments_Bulk_Questions_Placeholder", "اختر الأسئلة"]
                            </span>
                            <span class="pr-multi-count"></span>
                        </button>
                        <div class="pr-multi-menu">
                            <div class="pr-multi-header">
                                <label>
                                    <input type="checkbox" class="pr-multi-selectall" data-group="questions" />
                                    <span>@L["SelectAll", "تحديد الكل"]</span>
                                </label>
                            </div>
                            <div class="pr-multi-list">
                                @foreach (var q in qs)
                                {
                                    var text = string.IsNullOrWhiteSpace(q.TitleAr) ? q.TitleEn : q.TitleAr;
                                    <label class="pr-multi-item">
                                        <input type="checkbox"
                                               name="questionIds"
                                               value="@q.Id"
                                               data-group="questions" />
                                        <span>@text</span>
                                    </label>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="form-text">@L["Assignments_Bulk_Questions_Hint", L["Answers_Add"].Value]</div>
                </div>

                <!-- مستخدمون -->
                <div class="mb-3">
                    <div class="assign-filter-label">@L["Assignments_Bulk_UserIds"]</div>

                    <div class="pr-multi"
                         data-placeholder="@L["Assignments_Bulk_Users_Placeholder", "اختر المستخدمين"]"
                         data-group="users">
                        <button type="button" class="pr-multi-toggle">
                            <span class="pr-multi-label pr-multi-placeholder">
                                @L["Assignments_Bulk_Users_Placeholder", "اختر المستخدمين"]
                            </span>
                            <span class="pr-multi-count"></span>
                        </button>
                        <div class="pr-multi-menu">
                            <div class="pr-multi-header">
                                <label>
                                    <input type="checkbox" class="pr-multi-selectall" data-group="users" />
                                    <span>@L["SelectAll", "تحديد الكل"]</span>
                                </label>
                            </div>
                            <div class="pr-multi-list">
                                @foreach (var u in users)
                                {
                                    <label class="pr-multi-item">
                                        <input type="checkbox"
                                               name="userIds"
                                               value="@u.id"
                                               data-group="users" />
                                        <span>@u.fullName (@u.userName)</span>
                                    </label>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="form-text">@L["Assignments_Bulk_Users_Hint", L["Answers_Add"].Value]</div>
                </div>

                <div class="mt-2 d-flex gap-2">
                    <button type="submit" class="btn-pr btn-pr-primary flex-grow-1">
                        <i class="bi bi-check2-circle me-1"></i>
                        @L["Assignments_Bulk_Execute"]
                    </button>
                    <button type="reset" class="btn-pr btn-pr-outline">
                        <i class="bi bi-x-lg"></i>
                        @L["Btn_Reset", "Reset"]
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- 🔹 قائمة الإسنادات -->
    <div class="col-lg-8">
        <div class="pr-card mb-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <div class="h-section-title mb-0">
                    @L["Assignments_Title_List", L["Assignments_Title"].Value]
                </div>
                <span class="text-muted-soft" style="font-size:0.8rem;">
                    @L["Assignments_Subtitle", "إدارة الإسنادات الحالية"]
                </span>
            </div>

            <div id="assignTableWrap" class="mt-2">
                <partial name="_AssignmentsTable" model="Model" />
            </div>
        </div>
    </div>
</div>

<!-- حاوية المودال -->
<div id="assignUpsertHost"></div>

<!-- توكن مضاد للتزوير للاستعمال في طلبات AJAX -->
<form id="afTokenForm" class="d-none">@Html.AntiForgeryToken()</form>

@section Scripts {
    <!-- Icons + jQuery + DataTables -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <link rel="stylesheet" href="https://cdn.datatables.net/2.0.7/css/dataTables.dataTables.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/3.0.2/css/buttons.dataTables.min.css" />
    <script src="https://cdn.datatables.net/2.0.7/js/dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.0.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.0.2/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.0.2/js/buttons.print.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        const getAfToken = () =>
            document.querySelector('#afTokenForm input[name="__RequestVerificationToken"]').value;

        function initDataTable() {
            const $tbl = $('#assignTable');
            if (!$tbl.length) return;

            const isRtl = document.documentElement.dir === 'rtl';

            if ($.fn.dataTable.isDataTable($tbl)) {
                $tbl.DataTable().destroy();
            }

            $tbl.DataTable({
                dom: "<'row mb-2'<'col-sm-12 col-md-6'l><'col-sm-12 col-md-6 text-md-end'B>>" +
                     "<'row'<'col-sm-12'tr>>" +
                     "<'row mt-2'<'col-sm-12 col-md-5'i><'col-sm-12 col-md-7'p>>",
                buttons: [
                    { extend: 'copyHtml5',  text: '<i class="bi bi-clipboard"></i> Copy' },
                    { extend: 'excelHtml5', text: '<i class="bi bi-filetype-xlsx"></i> Excel' },
                    { extend: 'pdfHtml5',   text: '<i class="bi bi-filetype-pdf"></i> PDF', orientation: 'landscape', pageSize: 'A4' }
                ],
                pageLength: 10,
                order: [],
                language: isRtl ? {
                    search: "بحث:",
                    lengthMenu: "إظهار _MENU_ سجل",
                    info: "إظهار _START_ إلى _END_ من أصل _TOTAL_ سجل",
                    paginate: {
                        first: "الأولى",
                        last: "الأخيرة",
                        next: "التالي",
                        previous: "السابق"
                    },
                    zeroRecords: "لا توجد بيانات",
                    infoEmpty: "لا توجد سجلات",
                    infoFiltered: "(تمت التصفية من إجمالي _MAX_ سجلات)"
                } : {}
            });
        }

        function reloadAssignmentsTable() {
            const url = '/Assignments/Table';
            $('#assignTableWrap').load(url, function () {
                initDataTable();
            });
        }

        $(function () {
            initDataTable();
            initMultiSelects();
        });

        // 🔹 Multi-select behavior (checkbox + select all)
        function initMultiSelects() {
            document.querySelectorAll('.pr-multi').forEach(ms => {
                const toggle = ms.querySelector('.pr-multi-toggle');
                const menu = ms.querySelector('.pr-multi-menu');
                const labelEl = ms.querySelector('.pr-multi-label');
                const countEl = ms.querySelector('.pr-multi-count');
                const placeholder = ms.getAttribute('data-placeholder') || '';
                const group = ms.getAttribute('data-group');
                const allCheckbox = ms.querySelector('.pr-multi-selectall');
                const itemCheckboxes = ms.querySelectorAll('input[type="checkbox"][data-group="' + group + '"]');

                function updateState() {
                    const checked = Array.from(itemCheckboxes).filter(c => c.checked);
                    if (checked.length === 0) {
                        labelEl.textContent = placeholder;
                        labelEl.classList.add('pr-multi-placeholder');
                        countEl.textContent = '';
                    } else {
                        labelEl.textContent = checked.length === 1
                            ? checked[0].nextElementSibling?.textContent.trim()
                            : `${checked.length} @L["Selected", "محدد"]`;
                        labelEl.classList.remove('pr-multi-placeholder');
                        countEl.textContent = checked.length > 1 ? '✓' : '';
                    }

                    if (allCheckbox) {
                        allCheckbox.checked = checked.length === itemCheckboxes.length;
                    }
                }

                if (toggle) {
                    toggle.addEventListener('click', function (e) {
                        e.stopPropagation();
                        ms.classList.toggle('open');
                    });
                }

                if (allCheckbox) {
                    allCheckbox.addEventListener('change', function () {
                        const checked = this.checked;
                        itemCheckboxes.forEach(c => c.checked = checked);
                        updateState();
                    });
                }

                itemCheckboxes.forEach(c => {
                    c.addEventListener('change', updateState);
                });

                document.addEventListener('click', function (e) {
                    if (!ms.contains(e.target)) {
                        ms.classList.remove('open');
                    }
                });

                updateState();
            });
        }

        // Bulk عبر AJAX
        $('#bulkForm').on('submit', function (e) {
            e.preventDefault();
            const fd = new FormData(this);

            const qs = (fd.getAll('questionIds') || []).map(Number).filter(x => !isNaN(x));
            const us = (fd.getAll('userIds') || []).map(Number).filter(x => !isNaN(x));

            if (!qs.length || !us.length) {
                Swal.fire({
                    icon: 'warning',
                    title: '@L["Swal_Warning_Title", "تنبيه"]',
                    text: '@L["Assignments_Bulk_Validation_SelectBoth", "يرجى اختيار الأسئلة والمستخدمين قبل التنفيذ"]'
                });
                return;
            }

            fetch('/Assignments/Bulk', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': getAfToken()
                },
                body: JSON.stringify({ questionIds: qs, userIds: us })
            })
            .then(r => r.json())
            .then(j => {
                if (j.ok) {
                    const msg = (typeof j.message === 'object'
                                    ? j.message.value
                                    : j.message)
                                || '@L["Assignments_Bulk_Success_Default", "تم توزيع الأسئلة على المستخدمين"]';

                    Swal.fire({
                        icon: 'success',
                        title: '@L["Swal_Success_Title", "تمت العملية بنجاح"]',
                        text: msg,
                        timer: 2000,
                        showConfirmButton: false
                    });

                    reloadAssignmentsTable();
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: '@L["Swal_Error_Title", "فشل التنفيذ"]',
                        text: '@L["Assignments_Bulk_Error", "حدث خطأ أثناء الإسناد"]'
                    });
                }
            })
            .catch(() =>
                Swal.fire({
                    icon: 'error',
                    title: '@L["Swal_Error_Title", "خطأ"]',
                    text: '@L["Assignments_Bulk_Error_Generic", "حدث خطأ في تنفيذ العملية"]'
                })
            );
        });

        // تفعيل/تعطيل
        $(document).on('click', '.js-activate, .js-deactivate', function (e) {
            e.preventDefault();
            const id = $(this).data('id');
            const isAct = $(this).hasClass('js-activate');
            const url = (isAct ? '/Assignments/Activate/' : '/Assignments/Deactivate/') + id;

            fetch(url, {
                method: 'POST',
                headers: { 'RequestVerificationToken': getAfToken() }
            })
            .then r => r.json())
            .then(j => {
                if (j.ok) {
                    reloadAssignmentsTable();
                } else {
                    alert('@L["Assignments_Toggle_Failed", "فشل العملية"]');
                }
            })
            .catch(() => alert('@L["Assignments_Toggle_Error", "خطأ أثناء التنفيذ"]'));
        });
    </script>
}
