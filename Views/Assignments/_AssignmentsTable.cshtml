@using Microsoft.AspNetCore.Mvc.Localization
@using PeerReview.MvcHotel.Models
@model List<AssignmentDto>
@inject IViewLocalizer L

<table id="assignTable" class="pr-table table table-hover table-striped align-middle w-100">
    <thead>
        <tr>
            <th>#</th>
            <th>@L["Column_Question"]</th>
            <th>@L["Column_User"]</th>
            <th>@L["Column_Date"]</th>
            <th>@L["Column_Status"]</th>
            @* <th class="text-center">@L["Column_Actions"]</th> *@
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Count > 0)
        {
            var i = 1;
            foreach (var a in Model)
            {
                var title = a.question?.TitleEn ?? "";
                <tr class="@(a.isActive ? "" : "row-inactive")">
                    <td>@i</td>
                    <td title="@title">
                        @(title?.Length > 60 ? title.Substring(0, 60) + "..." : title)
                    </td>
                    <td>@a.userId</td>
                    <td>@a.assignedAt</td>
                    <td>
                        @if (a.isActive)
                        {
                            <span class="badge-active">@L["Status_Active"]</span>
                        }
                        else
                        {
                            <span class="badge-inactive">@L["Status_Inactive"]</span>
                        }
                    </td>
                    @* <td class="text-center">
                        @if (a.isActive)
                        {
                            <button class="btn-pr btn-pr-sm btn-pr-outline js-deactivate" data-id="@a.id">
                                @L["Btn_Deactivate"]
                            </button>
                        }
                        else
                        {
                            <button class="btn-pr btn-pr-sm btn-pr-soft js-activate" data-id="@a.id">
                                @L["Btn_Activate"]
                            </button>
                        }
                    </td> *@
                </tr>
                i++;
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center text-muted-soft">@L["NoAssignments"]</td>
            </tr>
        }
    </tbody>
</table>
