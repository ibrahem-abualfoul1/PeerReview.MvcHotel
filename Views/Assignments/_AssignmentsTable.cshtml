@using PeerReview.MvcHotel.Models
@model List<AssignmentDto>
@inject Microsoft.Extensions.Localization.IStringLocalizer<PeerReview.MvcHotel.Resources.SharedResource> L

<table id="assignTable" class="pr-table align-middle">
    <thead>
        <tr>
            <th>#</th>
            <th>@L["Assignments_Table_Question"]</th>
            <th>@L["Assignments_Table_User"]</th>
            <th>@L["Assignments_Table_Date"]</th>
            <th>@L["Assignments_Table_Status"]</th>
            <th class="text-center">@L["Assignments_Table_Actions"]</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Count > 0)
        {
            var i = 1;
            foreach (var a in Model)
            {
                var title = LocalizationExtensions.Localize(
                    a.question?.TitleAr,
                    a.question?.TitleEn);
                <tr class="@(a.isActive ? "" : "row-inactive")">
                    <td>@i</td>
                    <td title="@title">
                        @(title?.Length > 60 ? title.Substring(0, 60) + "..." : title)
                    </td>
                    <td>@a.userId</td>
                    <td>@a.assignedAt</td>
                    <td>
                        @if (a.isActive)
                        {
                            <span class="badge-active">@L["Assignments_Table_StatusActive"]</span>
                        }
                        else
                        {
                            <span class="badge-inactive">@L["Assignments_Table_StatusInactive"]</span>
                        }
                    </td>
                    <td class="text-center">
                        @if (a.isActive)
                        {
                            <button class="btn-pr btn-pr-sm btn-pr-outline js-deactivate" data-id="@a.id">
                                @L["Assignments_Table_Deactivate"]
                            </button>
                        }
                        else
                        {
                            <button class="btn-pr btn-pr-sm btn-pr-soft js-activate" data-id="@a.id">
                                @L["Assignments_Table_Activate"]
                            </button>
                        }
                    </td>
                </tr>
                i++;
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center text-muted-soft">@L["NoData"]</td>
            </tr>
        }
    </tbody>
</table>
