@using Microsoft.AspNetCore.Mvc.Localization
@using System.Globalization
@inject IViewLocalizer L
@model PeerReview.MvcHotel.Models.LoginRequest

@{
    ViewData["Title"] = L["Login_Title"];
    Layout = null;
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    var theme = Context.Request.Cookies["theme"] ?? "dark";
}
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName" dir="@(isRtl ? "rtl" : "ltr")" data-theme="@theme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - @L["AppName"]</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/peerreview-theme.css" />
</head>
<body class="auth-body">
    <div class="auth-shell">
        <div class="auth-backdrop"></div>
        <div class="auth-card">
            <div class="auth-media">
                <img src="~/data/qatar.png" alt="@L["HotelImageAlt"]" />
                <div class="auth-media-overlay">
                    <div class="auth-pill">@L["AppName"]</div>
                    <div class="auth-media-title">@L["Login_Header"]</div>
                    <div class="auth-media-text">@L["Login_Title"]</div>
                    <div class="auth-highlight-grid">
                        <div class="auth-highlight">@L["AppTitle"]</div>
                        <div class="auth-highlight">@L["Evaluation & Review System"]</div>
                    </div>
                </div>
            </div>

            <div class="auth-form">
                <div class="auth-head">
                    <div class="auth-brand">
                        <div class="auth-brand-icon">
                            <img src="~/assets/images/logos/logo_1.png" alt="Logo" />
                        </div>
                        <div>
                            <div class="auth-brand-title">@L["AppTitle"]</div>
                            <div class="auth-brand-sub">@L["PeerReview"]</div>
                        </div>
                    </div>
                    <div class="auth-locale-switch">
                        <a class="btn-pr btn-pr-soft btn-pr-sm" href="?culture=ar&ui-culture=ar">AR</a>
                        <a class="btn-pr btn-pr-soft btn-pr-sm" href="?culture=en&ui-culture=en">EN</a>
                    </div>
                </div>

                <div class="auth-title-block">
                    <div class="auth-pill subtle">@L["Login_Title"]</div>
                    <h1>@L["Login_Header"]</h1>
                    <p class="text-muted-soft">@L["Evaluation & Review System"]</p>
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger auth-alert" role="alert">
                        @L["Login_Failed"]
                    </div>
                }

                <form asp-action="Login" asp-controller="Auth" method="post" class="auth-fields">
                    @Html.AntiForgeryToken()

                    <div class="pr-field">
                        <input asp-for="userName" type="text" placeholder=" " autocomplete="username" required />
                        <label>@L["Login_UserName"]</label>
                        <span asp-validation-for="userName" class="text-danger small"></span>
                    </div>

                    <div class="pr-field">
                        <input asp-for="password" type="password" placeholder=" " autocomplete="current-password" required />
                        <label>@L["Login_Password"]</label>
                        <span asp-validation-for="password" class="text-danger small"></span>
                    </div>

                    <div class="auth-meta">
                        <span class="text-muted-soft">@L["AppName"]</span>
                        <span class="auth-chip">@L["PeerReview"]</span>
                    </div>

                    <button type="submit" class="btn-pr btn-pr-primary w-100 mt-1">
                        @L["Login_Submit"]
                    </button>
                </form>

                <div class="auth-footer">
                    <div class="auth-quick">
                        <span>@L["Login_Header"]</span>
                        <span class="text-muted-soft">@L["Login_Title"]</span>
                    </div>
                    <small class="text-muted-soft">© @DateTime.UtcNow.Year @L["AppName"]</small>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
