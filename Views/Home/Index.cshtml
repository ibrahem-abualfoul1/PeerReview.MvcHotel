
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer L
@{ ViewData["Title"] = L["Menu_Dashboard"]; var users = (int)(ViewBag.UsersCount ?? 0); var questions = (int)(ViewBag.QuestionsCount ?? 0); }
<div class="row g-3">
  <div class="col-md-3">
    <div class="card card-hotel p-3">
      <div class="text-muted">@L["Dashboard_Users"]</div>
      <div class="h3 fw-bold">@users</div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card card-hotel p-3">
      <div class="text-muted">@L["Dashboard_Questions"]</div>
      <div class="h3 fw-bold">@questions</div>
    </div>
  </div>
</div>
