@using Microsoft.Extensions.Configuration
@inject IConfiguration Config
@model List<PeerReview.MvcHotel.Models.AnswerForScoringDto>
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer L

@{
    ViewData["Title"] = L["ScoredAnswers_Title"];
    ViewBag.ActiveMenu = "Scoring";

    var ci = System.Globalization.CultureInfo.CurrentUICulture;
    var isRtl = ci.TwoLetterISOLanguageName == "ar";
    var api = Config["ApiBaseUrl"];

}

@section Styles {
    <style>
        .score-question {
            font-weight: 600;
        }

        .score-meta {
            font-size: .75rem;
            opacity: .8;
        }

        .score-answer-cell {
            max-width: 320px;
            white-space: pre-wrap;
            word-break: break-word;
        }

        .score-input {
            max-width: 110px;
        }
    </style>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <div class="h-section-title mb-1">
            @ViewData["Title"]
        </div>
        <div class="text-muted-soft" style="font-size:0.85rem;">
            @L["ScoredAnswers_Hint"]
        </div>
    </div>
    <a class="btn-pr btn-pr-outline" href="@Url.Action("Index", "AnswerScoring")">
        ← @L["Btn_Back"]
    </a>
</div>

@if (Model?.Any() != true)
{
    <div class="pr-card">
        <div class="pr-empty">
            <strong>@L["NoScoredAnswers"]</strong>
        </div>
    </div>
}
else
{
    <form method="post"
          action="~/AnswerScoring/update-form"
          class="pr-card">

        <input type="hidden" name="UserId" value="@ViewBag.UserId" />
        @Html.AntiForgeryToken()

        <div class="table-responsive-sm mt-1">
            <table class="pr-table table table-hover table-striped align-middle w-100 mb-0">
                <thead>
                    <tr>
                        <th style="width:50px;">#</th>
                        <th style="min-width:220px;">@L["Column_Question"]</th>
                        <th style="min-width:180px;">@L["Column_Item"]</th>
                        <th style="min-width:240px;">@L["Column_Answer"]</th>
                        <th style="width:140px">@L["Column_Score"]</th>
                        <th style="min-width:180px;">@L["Column_Notes"]</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < Model.Count; i++)
                    {
                        var a = Model[i];
                        <tr>
                            <td>@(i + 1)</td>

                            <!-- Question -->
                            <td>
                                <div class="score-question">
                                    @{
                                        var q = a.question;
                                        string qText;

                                        qText = q?.TitleEn
                                        ?? q?.DescriptionEn
                                        ?? $"Q#{a.QuestionId}";
                                    }
                                    @qText
                                </div>
                                <div class="score-meta text-muted">
                                    @string.Format(L["QuestionId_Label"].Value, a.QuestionId)
                                </div>
                            </td>

                            <!-- Item -->
                            <td>
                                <div>
                                    @(isRtl? a.ItemTextEn: a.ItemTextEn)
                                </div>
                                <div class="score-meta text-muted">
                                    @string.Format(L["ItemId_Label"].Value, a.QuestionItemId)
                                </div>
                            </td>

                            <!-- Answer -->
                            <td class="score-answer-cell">
                                @if (a.questionItem?.Type == 7)  // File upload
                                {
                                    // 1) أولوية: ملف فعلي من File.Path
                                    if (a.File != null && !string.IsNullOrWhiteSpace(a.File.Path))
                                    {
                                        @* var fileUrl = Url.Content("~/" + a.File.Path.TrimStart('/')); *@
                                        var fileUrl = (Config["ApiBaseUrl"] + a.File!.Path);

                                        <a href="@fileUrl"
                                           target="_blank"
                                           class="btn-pr btn-pr-sm btn-pr-soft">
                                            <i class="bi bi-file-earmark-arrow-down me-1"></i>
                                            @L["ViewFile"]
                                        </a>
                                    }
                                    // 2) دعم للحالات القديمة اللي فيها Base64 في Value
                                    else if (!string.IsNullOrWhiteSpace(a.Value))
                                    {
                                        <button type="button"
                                                class="btn-pr btn-pr-sm btn-pr-soft"
                                                onclick="openBase64File('@a.Value')">
                                            <i class="bi bi-file-earmark-arrow-down me-1"></i>
                                            @L["ViewFile"]
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="text-muted">@L["NoFile"]</span>
                                    }
                                }
                                else
                                {
                                    @a.Value
                                }
                            </td>

                            <!-- Score -->
                            <td>
                                <input type="hidden"
                                       name="Items[@i].AnswerId"
                                       value="@a.AnswerId" />

                                <input type="number"
                                       class="form-control form-control-sm score-input"
                                       name="Items[@i].Score"
                                       step="0.5"
                                       min="0"
                                       max="1"
                                       placeholder="—"
                                       value="@a.Score" />
                            </td>

                            <!-- Notes -->
                            <td>
                                <input type="text"
                                       class="form-control form-control-sm"
                                       name="Items[@i].Notes"
                                       placeholder="—"
                                       value="@a.Notes" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-3">
            <button type="submit" class="btn-pr btn-pr-primary">
                @L["Btn_Update"]
            </button>
            <a class="btn-pr btn-pr-outline" href="@Url.Action("Index", "AnswerScoring")">
                @L["Btn_Cancel"]
            </a>
        </div>
    </form>
}

<script>
    // Fallback لو لسه في إجابات قديمة مخزّنة كـ Base64 في Value
    function openBase64File(base64String) {
        let base64 = base64String;
        let mime = "";

        if (base64String.includes("base64,")) {
            mime = base64String.substring(
                base64String.indexOf(":") + 1,
                base64String.indexOf(";")
            );
            base64 = base64String.split("base64,")[1];
        } else {
            mime = "application/octet-stream";
        }

        try {
            const byteCharacters = atob(base64);
            const byteNumbers = new Array(byteCharacters.length);

            for (let i = 0; i < byteCharacters.length; i++) {
                byteNumbers[i] = byteCharacters.charCodeAt(i);
            }

            const byteArray = new Uint8Array(byteNumbers);
            const blob = new Blob([byteArray], { type: mime });

            const blobUrl = URL.createObjectURL(blob);
            window.open(blobUrl, "_blank");
        } catch {
            alert('@L["FileOpenError"]');
        }
    }
</script>
