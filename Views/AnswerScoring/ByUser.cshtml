@model ScorePostVm
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "تقييم إجابات المستخدم";
}

<h3 class="mb-3">تقييم إجابات المستخدم (ID: @Model.UserId)</h3>

<form asp-action="AddScores" asp-controller="AnswerScoring" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="UserId" value="@Model.UserId" />

    <div class="table-responsive">
        <table class="table table-bordered align-middle">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>السؤال/العنصر</th>
                    <th>القيمة المُقدَّمة</th>
                    <th>تاريخ التقديم</th>
                    <th style="width:120px;">الدرجة</th>
                    <th>ملاحظات</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.Items.Count; i++)
                {
                    var row = Model.Items[i];
                    <tr>
                        <td>@(i + 1)</td>
                        <td>
                            <div class="small text-muted">QID: @row.QuestionId, QItemID: @(row.QuestionItemId?.ToString() ?? "-")</div>
                            <div>@(string.IsNullOrWhiteSpace(row.ItemTextAr) ? row.ItemTextEn : row.ItemTextAr)</div>
                        </td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(row.Value))
                            {
                                <div class="text-break">@row.Value</div>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>@(row.SubmittedAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                        <td>
                            <input type="hidden" name="Items[@i].AnswerId" value="@row.AnswerId" />
                            <input type="number" class="form-control" name="Items[@i].Score" value="@row.Score" min="0" max="100" />
                        </td>
                        <td>
                            <textarea class="form-control" name="Items[@i].Notes" rows="2" placeholder="ملاحظات (اختياري)">@row.Notes</textarea>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-between">
        <a class="btn btn-outline-secondary" href="@Url.Action("Index", "AnswerScoring")">رجوع</a>
        <button type="submit" class="btn btn-primary">حفظ التقييمات</button>
    </div>
</form>
