@model List<AllScoresDto>

@{
    ViewData["Title"] = "جميع الدرجات";
}

<h3 class="mb-3">جميع الدرجات</h3>

<table class="table table-bordered table-striped align-middle">
    <thead>
        <tr>
            <th>#</th>
            <th>الاسم</th>
            <th>اسم المستخدم</th>
            <th>عدد الإجابات</th>
            <th>مجموع الدرجات</th>
            <th>المعدل</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            var i = 1;
            foreach (var row in Model)
            {
                <tr>
                    <td>@i</td>
                    <td>@row.FullName</td>
                    <td>@row.UserName</td>
                    <td>@row.AnswersCount</td>
                    <td>@row.TotalScore</td>
                    <td>@(row.AnswersCount > 0 ? ((decimal)row.TotalScore / row.AnswersCount).ToString("0.00") : "-")</td>
                </tr>
                i++;
            }
        }
        else
        {
            <tr><td colspan="6" class="text-center text-muted">لا توجد بيانات</td></tr>
        }
    </tbody>
</table>
