@using Microsoft.Extensions.Configuration
@inject IConfiguration Config
@model List<PeerReview.MvcHotel.Models.AnswerForScoringDto>
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer L

@{
    ViewData["Title"] = L["UnscoredAnswers_Title"];
    var ci = System.Globalization.CultureInfo.CurrentUICulture;
    var isRtl = ci.TwoLetterISOLanguageName == "ar";
    var api = Config["ApiBaseUrl"];
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <div class="h-section-title mb-1">@ViewData["Title"]</div>
        <div class="text-muted-soft" style="font-size:0.9rem;">@L["Scoring_Prompt"]</div>
    </div>
    <a class="btn-pr btn-pr-outline" href="@Url.Action("Index", "AnswerScoring")">
        ← @L["Btn_Back"]
    </a>
</div>

@if (Model?.Any() != true)
{
    <div class="pr-card">
        <div class="pr-empty">
            <strong>@L["NoUnscoredAnswers"]</strong>
        </div>
    </div>
}
else
{
    <form method="post"
          action="@Url.Action("Add", "AnswerScoring")"
          class="pr-card">
        @Html.AntiForgeryToken()

        <div class="card-body p-0">
            <div class="table-responsive-sm">
                <table class="pr-table table table-hover table-striped align-middle w-100 mb-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>@L["Column_Question"]</th>
                            <th>@L["Column_Item"]</th>
                            <th>@L["Column_Answer"]</th>
                            <th style="width:140px">@L["Column_Score"]</th>
                            <th>@L["Column_Notes"]</th>
                        </tr>
                    </thead>

                    <tbody>
                        @for (var i = 0; i < Model.Count; i++)
                        {
                            var a = Model[i];
                            <tr>
                                <td>@(i + 1)</td>

                                <!-- Question -->
                                <td>
                                    <div class="fw-semibold">
                                        @{
                                            var q = a.question;
                                            string qText = q?.TitleEn
                                            ?? q?.DescriptionEn
                                            ?? $"Q#{a.QuestionId}";
                                        }
                                        @qText
                                    </div>
                                    <div class="small text-muted">
                                        @string.Format(L["QuestionId_Label"].Value, a.QuestionId)
                                    </div>
                                </td>

                                <!-- Item -->
                                <td>
                                    <div>@a.ItemTextEn</div>
                                    <div class="small text-muted">
                                        @string.Format(L["ItemId_Label"].Value, a.QuestionItemId)
                                    </div>
                                </td>

                                <!-- Answer -->
                                <td>
                                    @if (a.questionItem?.Type == 7)  // FILE UPLOAD
                                    {
                                        // قائمة الملفات من الـ API
                                        var fileItems = a.Files?
                                        .Where(f => f.File != null && !string.IsNullOrWhiteSpace(f.File.Path))
                                        .ToList()
                                        ?? new List<PeerReview.MvcHotel.Models.AnswerFileDto>();

                                        if (fileItems.Any())
                                        {
                                            <ul class="list-unstyled mb-0">
                                                @foreach (var f in fileItems)
                                                {
                                                    var path = f.File!.Path?.TrimStart('/') ?? "";
                                                    var baseUrl = api?.TrimEnd('/') ?? "";
                                                    var fileUrl = $"{baseUrl}/{path}";
                                                    var filename = string.IsNullOrWhiteSpace(f.File.FileName)
                                                    ? L["ViewFile"].Value
                                                    : f.File.FileName;

                                                    <li class="mb-1">
                                                        <a href="@fileUrl"
                                                           target="_blank"
                                                           class="btn btn-sm btn-outline-primary">
                                                            <i class="bi bi-file-earmark-arrow-down"></i>
                                                            @filename
                                                        </a>
                                                    </li>
                                                }
                                            </ul>
                                        }
                                        else if (!string.IsNullOrWhiteSpace(a.Value))   // Fallback للبيانات القديمة
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-primary"
                                                    onclick="openBase64File('@a.Value')">
                                                <i class="bi bi-file-earmark-arrow-down"></i>
                                                @L["ViewFile"]
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="text-muted">@L["NoFile"]</span>
                                        }
                                    }
                                    else
                                    {
                                        <div style="white-space:pre-wrap;">
                                            @a.Value
                                        </div>
                                    }
                                </td>

                                <!-- Score -->
                                <td>
                                    <input type="hidden"
                                           name="Items[@i].AnswerId"
                                           value="@a.AnswerId" />

                                    <input type="number"
                                           lang="en"
                                           class="form-control form-control-sm score-input"
                                           name="Items[@i].Score"
                                           step="0.5"
                                           min="0"
                                           max="1"
                                           required />
                                </td>

                                <!-- Notes -->
                                <td>
                                    <input type="text"
                                           class="form-control form-control-sm"
                                           name="Items[@i].Notes"
                                           placeholder="—" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card-footer d-flex justify-content-end gap-2">
            <button type="submit" class="btn btn-primary">
                @L["Btn_Save"]
            </button>
        </div>
    </form>
}

<script>
    // Base64 fallback
    function openBase64File(base64String) {
        let base64 = base64String;
        let mime = "";

        if (base64String.includes("base64,")) {
            mime = base64String.substring(
                base64String.indexOf(":") + 1,
                base64String.indexOf(";")
            );
            base64 = base64String.split("base64,")[1];
        } else {
            mime = "application/octet-stream";
        }

        const byteCharacters = atob(base64);
        const byteNumbers = Array.from(byteCharacters).map(c => c.charCodeAt(0));
        const byteArray = new Uint8Array(byteNumbers);
        const blob = new Blob([byteArray], { type: mime });

        const blobUrl = URL.createObjectURL(blob);
        window.open(blobUrl, "_blank");
    }
</script>
