@model PeerReview.MvcHotel.Models.ReviewerUsersOverviewDto
@using Microsoft.AspNetCore.Mvc.Localization
@using System.Globalization
@inject IViewLocalizer L

@{
    ViewData["Title"] = L["AnswerScoring_Title"];
    ViewBag.ActiveMenu = "Scoring";

    var scored = Model?.Scored ?? new List<PeerReview.MvcHotel.Models.ReviewerUserRowDto>();
    var unscored = Model?.Unscored ?? new List<PeerReview.MvcHotel.Models.ReviewerUserRowDto>();

    var totalUsers = scored.Select(x => x.UserId)
                           .Concat(unscored.Select(x => x.UserId))
                           .Distinct()
                           .Count();
}

@section Styles {
    <style>
        .score-layout-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 1rem;
            margin-bottom: 0.75rem;
        }

        .score-pill-small {
            font-size: 0.78rem;
            border-radius: 999px;
            padding: .2rem .8rem;
            border: 1px solid var(--border-color);
            color: var(--text-muted);
            background: var(--bg-muted);
            box-shadow: 0 6px 22px rgba(249, 115, 22, 0.08);
        }

        .score-stats-row {
            display: flex;
            flex-wrap: wrap;
            gap: .75rem;
            margin-bottom: .75rem;
        }

        .score-stat-card {
            border-radius: 999px;
            padding: .5rem 1rem;
            background: linear-gradient(120deg, rgba(255, 244, 235, 0.9), rgba(255, 225, 204, 0.72));
            border: 1px solid rgba(249, 115, 22, 0.25);
            display: inline-flex;
            align-items: center;
            gap: .6rem;
            font-size: .85rem;
            color: var(--text-main);
            box-shadow: 0 16px 34px rgba(234, 88, 12, 0.12);
        }

        .score-stat-number {
            font-weight: 800;
            font-size: 1rem;
        }

        .score-stat-label {
            opacity: .85;
        }

        .nav-score-tabs {
            border-bottom: 1px solid var(--border-color);
            padding-inline: .75rem;
        }

            .nav-score-tabs .nav-link {
                border: none;
                border-bottom: 2px solid transparent;
                border-radius: 0;
                padding-inline: .9rem;
                padding-block: .55rem;
                font-size: .92rem;
                font-weight: 600;
                color: var(--text-muted);
                display: flex;
                align-items: center;
                gap: .45rem;
                background: transparent;
            }

                .nav-score-tabs .nav-link .badge-tab-count {
                    border-radius: 999px;
                    padding: .15rem .6rem;
                    font-size: .78rem;
                    background: var(--bg-muted);
                    border: 1px solid var(--border-color);
                    color: var(--text-main);
                }

                .nav-score-tabs .nav-link.active {
                    color: var(--text-main);
                    border-bottom-color: var(--color-primary);
                }

                    .nav-score-tabs .nav-link.active .badge-tab-count {
                        background: rgba(249, 115, 22, 0.12);
                        border-color: rgba(249, 115, 22, 0.45);
                        color: var(--text-main);
                    }

        .score-badge-unscored {
            background: #fff7ed;
            color: #b45309;
            padding: .25rem .65rem;
            border-radius: 999px;
            font-size: 0.8rem;
            border: 1px solid rgba(249, 115, 22, 0.28);
        }

        .score-badge-scored {
            background: #ecfdf3;
            color: #15803d;
            padding: .25rem .65rem;
            border-radius: 999px;
            font-size: 0.8rem;
            border: 1px solid rgba(34, 197, 94, 0.26);
        }

        .score-user-name {
            font-weight: 600;
        }

        .pr-table td.text-clip {
            max-width: 240px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .score-empty-row {
            height: 72px;
        }
    </style>
}

<div class="pr-card">
    <!-- Header -->
    <div class="score-layout-header">
        <div>
            <div class="h-section-title mb-1">
                @ViewData["Title"]
            </div>
            <div class="text-muted-soft" style="font-size:0.85rem;">
                @L["AnswerScoring_Overview_Hint"]
            </div>
        </div>

        <div class="d-flex flex-column flex-sm-row align-items-sm-center gap-2">
            <span class="score-pill-small">
                @L["TotalReviewUsers"]: @totalUsers
            </span>
            <span class="score-pill-small">
                @L["ReviewerId_Label"]: @Model?.ReviewerId
            </span>
        </div>
    </div>

    <!-- Small stats -->
    <div class="score-stats-row">
        <div class="score-stat-card">
            <div>
                <div class="score-stat-label">@L["UnscoredUsers"]</div>
                <div class="score-stat-number">@unscored.Count</div>
            </div>
        </div>

        <div class="score-stat-card">
            <div>
                <div class="score-stat-label">@L["ScoredUsers"]</div>
                <div class="score-stat-number">@scored.Count</div>
            </div>
        </div>

        <div class="score-stat-card">
            <div>
                <div class="score-stat-label">@L["AnswerScoring_Progress"]</div>
                @{
                    var totalAnswers = scored.Sum(x => x.TotalAnswers) + unscored.Sum(x => x.TotalAnswers);
                    var totalScored = scored.Sum(x => x.ScoredCount);
                    var pct = totalAnswers > 0 ? (int)Math.Round((double)totalScored * 100 / totalAnswers) : 0;
                }
                <div class="score-stat-number">@pct%</div>
            </div>
        </div>
    </div>

    <!-- Tabs -->
    <ul class="nav nav-tabs nav-score-tabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active"
                    data-bs-toggle="tab"
                    data-bs-target="#tab-unscored"
                    type="button">
                <span>@L["UnscoredUsers"]</span>
                <span class="badge-tab-count">@unscored.Count</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link"
                    data-bs-toggle="tab"
                    data-bs-target="#tab-scored"
                    type="button">
                <span>@L["ScoredUsers"]</span>
                <span class="badge-tab-count">@scored.Count</span>
            </button>
        </li>
    </ul>

    <!-- Content -->
    <div class="tab-content card-body px-0 pb-0 pt-2">
        <!-- Unscored -->
        <div class="tab-pane fade show active" id="tab-unscored">
            <div class="table-responsive">
                <table class="pr-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>@L["Column_UserName"]</th>
                            <th>@L["Column_FullName"]</th>
                            <th class="text-center">@L["Column_TotalAnswers"]</th>
                            <th class="text-center">@L["Column_Unscored"]</th>
                            <th class="text-center">@L["Column_Scored"]</th>
                            <th>@L["Column_LastUpdated"]</th>
                            <th class="text-center">@L["Column_Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (unscored.Any())
                        {
                            var i = 1;
                            foreach (var u in unscored)
                            {
                                <tr>
                                    <td>@i</td>
                                    <td class="text-clip">
                                        <div class="score-user-name">@u.UserName</div>
                                    </td>
                                    <td class="text-clip">@u.FullName</td>
                                    <td class="text-center">@u.TotalAnswers</td>
                                    <td class="text-center">
                                        <span class="score-badge-unscored">@u.UnscoredCount</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="score-badge-scored">@u.ScoredCount</span>
                                    </td>
                                    <td>
                                        @(u.LastScoredAt?.ToString("yyyy-MM-dd HH:mm", CultureInfo.CurrentUICulture) ?? "—")
                                    </td>
                                    <td class="text-center">
                                        <div class="d-flex justify-content-center gap-1 flex-wrap">
                                            <a class="btn-pr btn-pr-sm btn-pr-primary"
                                               href="@Url.Action("ByUserUnscored", "AnswerScoring", new { userId = u.UserId })">
                                                @L["ReviewUnscored"]
                                            </a>
                                            <a class="btn-pr btn-pr-sm btn-pr-soft"
                                               href="@Url.Action("ByUserScored", "AnswerScoring", new { userId = u.UserId })">
                                                @L["ViewScored"]
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                                i++;
                            }
                        }
                        else
                        {
                            <tr class="score-empty-row">
                                <td colspan="8" class="text-center text-muted-soft">
                                    @L["NoData"]
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Scored -->
        <div class="tab-pane fade" id="tab-scored">
            <div class="table-responsive">
                <table class="pr-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>@L["Column_UserName"]</th>
                            <th>@L["Column_FullName"]</th>
                            <th class="text-center">@L["Column_TotalAnswers"]</th>
                            <th class="text-center">@L["Column_Scored"]</th>
                            <th class="text-center">@L["Column_Unscored"]</th>
                            <th>@L["Column_LastUpdated"]</th>
                            <th class="text-center">@L["Column_Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (scored.Any())
                        {
                            var i = 1;
                            foreach (var u in scored)
                            {
                                <tr>
                                    <td>@i</td>
                                    <td class="text-clip">
                                        <div class="score-user-name">@u.UserName</div>
                                    </td>
                                    <td class="text-clip">@u.FullName</td>
                                    <td class="text-center">@u.TotalAnswers</td>
                                    <td class="text-center">
                                        <span class="score-badge-scored">@u.ScoredCount</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="score-badge-unscored">@u.UnscoredCount</span>
                                    </td>
                                    <td>
                                        @(u.LastScoredAt?.ToString("yyyy-MM-dd HH:mm", CultureInfo.CurrentUICulture) ?? "—")
                                    </td>
                                    <td class="text-center">
                                        <div class="d-flex justify-content-center gap-1 flex-wrap">
                                            <a class="btn-pr btn-pr-sm btn-pr-soft"
                                               href="@Url.Action("ByUserScored", "AnswerScoring", new { userId = u.UserId })">
                                                @L["ViewScored"]
                                            </a>
                                            <a class="btn-pr btn-pr-sm btn-pr-primary"
                                               href="@Url.Action("ByUserUnscored", "AnswerScoring", new { userId = u.UserId })">
                                                @L["ReviewUnscored"]
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                                i++;
                            }
                        }
                        else
                        {
                            <tr class="score-empty-row">
                                <td colspan="8" class="text-center text-muted-soft">
                                    @L["NoData"]
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
