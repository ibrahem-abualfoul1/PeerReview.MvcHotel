@model List<WithUnScoredAnswersDto>

@{
    ViewData["Title"] = "Answer Scoring - Users";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>المستخدمون ذوو الإجابات غير المقيّمة</h3>
</div>

@if (TempData["Ok"] != null)
{
    <div class="alert alert-success">@TempData["Ok"]</div>
}
@if (TempData["Err"] != null)
{
    <div class="alert alert-danger">@TempData["Err"]</div>
}

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <th>#</th>
            <th>الاسم</th>
            <th>اسم المستخدم</th>
            <th>البريد</th>
            <th>الحالة</th>
            <th class="text-center">غير مُقيّم</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            var i = 1;
            foreach (var u in Model.OrderByDescending(x => x.UnscoredCount ?? 0))
            {
                <tr>
                    <td>@i</td>
                    <td>@u.FullName</td>
                    <td>@u.UserName</td>
                    <td>@u.Email</td>
                    <td>
                        @if (u.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                    </td>
                    <td class="text-center">
                        <span class="badge bg-warning text-dark">@((u.UnscoredCount ?? 0))</span>
                    </td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-primary"
                           href="@Url.Action("ByUser", "AnswerScoring", new { userId = u.Id })">
                            تقييم الإجابات
                        </a>
                    </td>
                </tr>
                i++;
            }
        }
        else
        {
            <tr><td colspan="7" class="text-center text-muted">لا توجد بيانات</td></tr>
        }
    </tbody>
</table>
