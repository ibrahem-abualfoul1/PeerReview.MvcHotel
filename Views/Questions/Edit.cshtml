
@inject Microsoft.Extensions.Localization.IStringLocalizer<PeerReview.MvcHotel.Resources.SharedResource> L
@model PeerReview.MvcHotel.Models.QuestionUpdateDto
@{ ViewData["Title"]=@SharedResource.Questions_Edit_Title; var id = ViewBag.QuestionId as int? ?? 0; }
<h3>@SharedResource.Questions_Edit_Title #@id</h3>
<form method="post" class="card card-hotel p-3">
  <div class="row g-2">
    <div class="col-md-6"><label class="form-label">@SharedResource.Field_Title</label><input asp-for="TitleEn" class="form-control" /></div>
    <div class="col-md-6"><label class="form-label">@SharedResource.Field_Description</label><input asp-for="DescriptionEn" class="form-control" /></div>
    <div class="col-md-4"><label class="form-label">@SharedResource.Field_Category</label><input asp-for="CategoryId" type="number" class="form-control" /></div>
  </div>
  <button class="btn btn-gold mt-2">@SharedResource.Btn_Save</button> <a class="btn btn-secondary mt-2" href="/Questions">@SharedResource.Btn_Back</a>
</form>
