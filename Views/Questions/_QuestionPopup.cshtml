@model QuestionCreateDto
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.AspNetCore.Mvc.Rendering
@inject IViewLocalizer L

@{
    var id = ViewBag.Id as int?;
    var isEdit = id.HasValue && id.Value > 0;

    var types = ViewBag.QuestionTypes as SelectList
                ?? new SelectList(Enumerable.Empty<SelectListItem>());
    var categories = ViewBag.Categorys as SelectList
                ?? new SelectList(Enumerable.Empty<SelectListItem>());
    var questionItems = ViewBag.QuestionItems as SelectList
                ?? new SelectList(Enumerable.Empty<SelectListItem>());
    var selectedItems = Model?.Items ?? new List<int>();

    string url = isEdit
        ? Url.Action("Edit", "Questions", new { id = id!.Value })!
        : Url.Action("Create", "Questions")!;
}

<style>
    /* تحسين المظهر العام للمودال */
    #questionUpsertModal .modal-content {
        background: linear-gradient(135deg, rgba(244, 246, 248, 0.9), rgba(232, 236, 241, 0.95));
        border: 1px solid rgba(0, 0, 0, 0.04);
        font-family: 'Segoe UI', 'Noto Sans Arabic', system-ui, -apple-system, sans-serif;
    }

    #questionUpsertModal .modal-header,
    #questionUpsertModal .modal-footer {
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(6px);
    }

    #questionUpsertModal .pr-card {
        background: rgba(255, 255, 255, 0.9);
        border-radius: 18px;
        border: 1px solid rgba(0, 0, 0, 0.04);
        box-shadow: 0 8px 30px rgba(15, 23, 42, 0.08);
    }

    #questionUpsertModal .pr-field input,
    #questionUpsertModal .pr-field textarea,
    #questionUpsertModal .pr-field select {
        background: #f8fafc;
        border-radius: 12px;
        border: 1px solid rgba(15, 23, 42, 0.08);
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }

    #questionUpsertModal .pr-field input:focus,
    #questionUpsertModal .pr-field textarea:focus,
    #questionUpsertModal .pr-field select:focus {
        border-color: #3b82f6;
        box-shadow: 0 0 0 0.15rem rgba(59, 130, 246, 0.15);
    }

    #questionUpsertModal .dropdown-toggle {
        background: #fff;
        border-radius: 12px;
        border: 1px solid rgba(15, 23, 42, 0.08);
        padding: 0.75rem 1rem;
        color: #0f172a;
        box-shadow: 0 4px 14px rgba(15, 23, 42, 0.06);
    }

    #questionUpsertModal .dropdown-menu {
        border-radius: 14px;
        border: 1px solid rgba(15, 23, 42, 0.06);
        box-shadow: 0 12px 40px rgba(15, 23, 42, 0.12);
    }

    #questionUpsertModal .badge-soft {
        background: #e0e7ff;
        color: #1e3a8a;
        border: 1px solid rgba(59, 130, 246, 0.16);
        padding: 0.5rem 0.7rem;
        border-radius: 999px;
        font-weight: 600;
    }

    #questionUpsertModal .muted-note {
        color: #6b7280;
        font-size: 0.9rem;
    }
</style>

<div class="modal fade" id="questionUpsertModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content shadow-lg" style="border-radius:1rem; overflow:hidden;">

            <!-- Header -->
            <div class="modal-header border-0" style="background:var(--panel);">
                <h5 class="modal-title fw-bold text-body">
                    @(isEdit ? L["Questions_Edit"] : L["Questions_Add"])
                </h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>

            <!-- Form -->
            <form id="questionUpsertForm" method="post" action="@url">
                @Html.AntiForgeryToken()
                @if (isEdit)
                {
                    <input type="hidden" name="Id" value="@id" />
                }

                <div class="modal-body" style="background:var(--app-bg);">
                    <div class="pr-card mb-0">
                        <div class="h-section-title mb-3">
                            @L["Questions_Details"]
                        </div>

                        <div class="row g-3">
                            <!-- Title EN -->
                            <div class="col-md-6">
                                <div class="pr-field">
                                    <input asp-for="TitleEn" placeholder=" " required />
                                    <label>@L["Questions_TitleEn"]</label>
                                    <span class="text-danger small" asp-validation-for="TitleEn"></span>
                                </div>
                            </div>

                            <!-- Title AR -->
                            <div class="col-md-6">
                                <div class="pr-field">
                                    <input asp-for="TitleAr" placeholder=" " required />
                                    <label>@L["Questions_TitleAr"]</label>
                                    <span class="text-danger small" asp-validation-for="TitleAr"></span>
                                </div>
                            </div>

                            <!-- Description EN -->
                            <div class="col-md-6">
                                <div class="pr-field">
                                    <textarea asp-for="DescriptionEn" rows="3" placeholder=" " required></textarea>
                                    <label>@L["Questions_DescEn"]</label>
                                    <span class="text-danger small" asp-validation-for="DescriptionEn"></span>
                                </div>
                            </div>

                            <!-- Description AR -->
                            <div class="col-md-6">
                                <div class="pr-field">
                                    <textarea asp-for="DescriptionAr" rows="3" placeholder=" " required></textarea>
                                    <label>@L["Questions_DescAr"]</label>
                                    <span class="text-danger small" asp-validation-for="DescriptionAr"></span>
                                </div>
                            </div>

                            <!-- Category -->
                            <div class="col-md-6">
                                <div class="pr-field">
                                    <select asp-for="CategoryId"
                                            class="form-select"
                                            asp-items="categories">
                                        <option value="">— @L["Select_Category"] —</option>
                                    </select>
                                    <label>@L["Questions_Category"]</label>
                                    <span class="text-danger small" asp-validation-for="CategoryId"></span>
                                </div>
                                <small class="text-muted-soft d-block">
                                    @L["Questions_Category_Help"]
                                </small>
                            </div>

                            <!-- SubCategory (جاهزة لو حاب تفعلها لاحقاً) -->
                            @* 
                            <div class="col-md-6">
                                <div class="pr-field">
                                    <select asp-for="SubCategoryId"
                                            class="form-select"
                                            asp-items="ViewBag.SubCategories as SelectList">
                                        <option value="">— @L["Select_SubCategory"] —</option>
                                    </select>
                                    <label>@L["Questions_SubCategory"]</label>
                                    <span class="text-danger small" asp-validation-for="SubCategoryId"></span>
                                </div>
                            </div>
                            *@

                            <!-- Items multi-select dropdown -->
                            <div class="col-12">
                                <label class="form-label fw-semibold text-body" asp-for="Items">
                                    @L["Questions_Items"]
                                </label>

                                <div class="dropdown w-100">
                                    <button class="btn dropdown-toggle w-100 d-flex justify-content-between align-items-center"
                                            type="button"
                                            id="itemsDropdownButton"
                                            data-default-text='@L["Questions_Items_Select"]'
                                            data-bs-toggle="dropdown"
                                            data-bs-auto-close="outside"
                                            aria-expanded="false">
                                        <span id="itemsDropdownLabel">
                                            @L["Questions_Items_Select"]
                                        </span>
                                        <i class="bi bi-chevron-down"></i>
                                    </button>
                                    <div class="dropdown-menu w-100 p-3 shadow" aria-labelledby="itemsDropdownButton" style="max-height: 360px; overflow-y: auto;">
                                        <div class="d-flex align-items-center justify-content-between mb-3">
                                            <div class="small text-muted">@L["Questions_Items_Help"]</div>
                                            <div class="form-check mb-0">
                                                <input class="form-check-input" type="checkbox" id="itemsSelectAll" />
                                                <label class="form-check-label" for="itemsSelectAll">@L["Select_All"]</label>
                                            </div>
                                        </div>
                                        @foreach (var option in questionItems)
                                        {
                                            var isChecked = int.TryParse(option.Value, out var itemId) && selectedItems.Contains(itemId);
                                            var inputId = $"question-item-{option.Value}";

                                            <div class="form-check mb-2">
                                                <input class="form-check-input"
                                                       type="checkbox"
                                                       name="Items"
                                                       id="@inputId"
                                                       value="@option.Value"
                                                       @(isChecked ? "checked" : null) />
                                                <label class="form-check-label text-body" for="@inputId">
                                                    @option.Text
                                                </label>
                                            </div>
                                        }
                                    </div>
                                </div>

                                <div id="itemsSelectedPreview" class="d-flex flex-wrap gap-2 mt-2" aria-live="polite"></div>

                                <span class="text-danger small d-block" asp-validation-for="Items"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Footer -->
                <div class="modal-footer border-0" style="background:var(--panel);">
                    <button type="button"
                            class="btn-pr btn-pr-outline"
                            data-bs-dismiss="modal">
                        @L["Cancel"]
                    </button>
                    <button type="submit" class="btn-pr btn-pr-primary">
                        @L["Save"]
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // لو حاب بعد الحفظ تستخدم AJAX وتغلق المودال وتعيد تحميل الجدول:
        // يمكنك في الـ Controller إرجاع JSON success،
        // وهنا تتعامل مع submit بالـ JS وتطلق event: question:upserted
        // حالياً النموذج يشتغل Submit عادي حسب الـ action.

        (() => {
            const dropdownButton = document.getElementById('itemsDropdownButton');
            if (!dropdownButton) return;

            const dropdownLabel = document.getElementById('itemsDropdownLabel');
            const defaultText = dropdownButton.dataset.defaultText?.trim() || dropdownLabel?.textContent?.trim() || '';
            const dropdown = dropdownButton.closest('.dropdown');
            const checkboxes = dropdown ? dropdown.querySelectorAll('input[name="Items"]') : [];
            const previewContainer = document.getElementById('itemsSelectedPreview');
            const selectAllCheckbox = document.getElementById('itemsSelectAll');

            const refreshLabel = () => {
                const selected = Array.from(checkboxes).filter(cb => cb.checked);
                if (!dropdownLabel) return;

                const selectedNames = selected
                    .map(cb => {
                        const label = cb.closest('.form-check')?.querySelector('label');
                        return label ? label.textContent?.trim() : cb.value;
                    })
                    .filter(Boolean);

                if (selectedNames.length === 0) {
                    dropdownLabel.textContent = defaultText;
                }
                else {
                    const preview = selectedNames.slice(0, 2).join(', ');
                    dropdownLabel.textContent = selectedNames.length > 2
                        ? `${preview} +${selectedNames.length - 2}`
                        : preview || defaultText;
                }

                if (previewContainer) {
                    previewContainer.innerHTML = '';
                    selectedNames.forEach(name => {
                        const badge = document.createElement('span');
                        badge.className = 'badge-soft';
                        badge.textContent = name;
                        previewContainer.appendChild(badge);
                    });

                    if (selectedNames.length === 0) {
                        const placeholder = document.createElement('span');
                        placeholder.className = 'muted-note';
                        placeholder.textContent = '@L["Questions_Items_Select"]';
                        previewContainer.appendChild(placeholder);
                    }
                }

                if (selectAllCheckbox) {
                    selectAllCheckbox.checked = selected.length === checkboxes.length && checkboxes.length > 0;
                    selectAllCheckbox.indeterminate = selected.length > 0 && selected.length < checkboxes.length;
                }
            };

            if (selectAllCheckbox) {
                selectAllCheckbox.addEventListener('change', (e) => {
                    const isChecked = e.target.checked;
                    checkboxes.forEach(cb => {
                        cb.checked = isChecked;
                    });
                    refreshLabel();
                });
            }

            checkboxes.forEach(cb => cb.addEventListener('change', refreshLabel));
            refreshLabel();
        })();
    </script>
}
