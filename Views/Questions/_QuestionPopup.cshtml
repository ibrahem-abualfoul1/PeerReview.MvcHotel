@model QuestionCreateDto
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.AspNetCore.Mvc.Rendering
@inject IViewLocalizer L

@{
    var id = ViewBag.Id as int?;
    var isEdit = id.HasValue && id.Value > 0;

    var types = ViewBag.QuestionTypes as SelectList
                ?? new SelectList(Enumerable.Empty<SelectListItem>());
    var categories = ViewBag.Categorys as SelectList
                ?? new SelectList(Enumerable.Empty<SelectListItem>());
    var questionItems = ViewBag.QuestionItems as SelectList
                ?? new SelectList(Enumerable.Empty<SelectListItem>());
    var selectedItems = Model?.Items ?? new List<int>();

    string url = isEdit
        ? Url.Action("Edit", "Questions", new { id = id!.Value })!
        : Url.Action("Create", "Questions")!;
}

<div class="modal fade" id="questionUpsertModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content shadow-lg" style="border-radius:1rem; overflow:hidden;">

            <!-- Header -->
            <div class="modal-header border-0" style="background:var(--panel);">
                <h5 class="modal-title fw-bold text-body">
                    @(isEdit ? L["Questions_Edit"] : L["Questions_Add"])
                </h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>

            <!-- Form -->
            <form id="questionUpsertForm" method="post" action="@url">
                @Html.AntiForgeryToken()
                @if (isEdit)
                {
                    <input type="hidden" name="Id" value="@id" />
                }

                <div class="modal-body" style="background:var(--app-bg);">
                    <div class="pr-card mb-0">
                        <div class="h-section-title mb-3">
                            @L["Questions_Details"]
                        </div>

                        <div class="row g-3">
                            <!-- Title EN -->
                            <div class="col-md-6">
                                <div class="pr-field">
                                    <input asp-for="TitleEn" placeholder=" " required />
                                    <label>@L["Questions_TitleEn"]</label>
                                    <span class="text-danger small" asp-validation-for="TitleEn"></span>
                                </div>
                            </div>

                            <!-- Title AR -->
                            <div class="col-md-6">
                                <div class="pr-field">
                                    <input asp-for="TitleAr" placeholder=" " required />
                                    <label>@L["Questions_TitleAr"]</label>
                                    <span class="text-danger small" asp-validation-for="TitleAr"></span>
                                </div>
                            </div>

                            <!-- Description EN -->
                            <div class="col-md-6">
                                <div class="pr-field">
                                    <textarea asp-for="DescriptionEn" rows="3" placeholder=" " required></textarea>
                                    <label>@L["Questions_DescEn"]</label>
                                    <span class="text-danger small" asp-validation-for="DescriptionEn"></span>
                                </div>
                            </div>

                            <!-- Description AR -->
                            <div class="col-md-6">
                                <div class="pr-field">
                                    <textarea asp-for="DescriptionAr" rows="3" placeholder=" " required></textarea>
                                    <label>@L["Questions_DescAr"]</label>
                                    <span class="text-danger small" asp-validation-for="DescriptionAr"></span>
                                </div>
                            </div>

                            <!-- Category -->
                            <div class="col-md-6">
                                <div class="pr-field">
                                    <select asp-for="CategoryId"
                                            class="form-select"
                                            asp-items="categories">
                                        <option value="">— @L["Select_Category"] —</option>
                                    </select>
                                    <label>@L["Questions_Category"]</label>
                                    <span class="text-danger small" asp-validation-for="CategoryId"></span>
                                </div>
                                <small class="text-muted-soft d-block">
                                    @L["Questions_Category_Help"]
                                </small>
                            </div>

                            <!-- SubCategory (جاهزة لو حاب تفعلها لاحقاً) -->
                            @* 
                            <div class="col-md-6">
                                <div class="pr-field">
                                    <select asp-for="SubCategoryId"
                                            class="form-select"
                                            asp-items="ViewBag.SubCategories as SelectList">
                                        <option value="">— @L["Select_SubCategory"] —</option>
                                    </select>
                                    <label>@L["Questions_SubCategory"]</label>
                                    <span class="text-danger small" asp-validation-for="SubCategoryId"></span>
                                </div>
                            </div>
                            *@

                            <!-- Items multi-select dropdown -->
                            <div class="col-12">
                                <label class="form-label fw-semibold text-body" asp-for="Items">
                                    @L["Questions_Items"]
                                </label>

                                <div class="dropdown w-100">
                                    <button class="btn btn-light border w-100 d-flex justify-content-between align-items-center"
                                            type="button"
                                            id="itemsDropdownButton"
                                            data-default-text='@L["Questions_Items_Select"]'
                                            data-bs-toggle="dropdown"
                                            data-bs-auto-close="outside"
                                            aria-expanded="false">
                                        <span id="itemsDropdownLabel">
                                            @L["Questions_Items_Select"]
                                        </span>
                                        <i class="bi bi-chevron-down"></i>
                                    </button>
                                    <div class="dropdown-menu w-100 p-3 shadow" aria-labelledby="itemsDropdownButton" style="max-height: 320px; overflow-y: auto;">
                                        <div class="small text-muted mb-2">@L["Questions_Items_Help"]</div>
                                        @foreach (var option in questionItems)
                                        {
                                            var isChecked = int.TryParse(option.Value, out var itemId) && selectedItems.Contains(itemId);
                                            var inputId = $"question-item-{option.Value}";

                                            <div class="form-check mb-2">
                                                <input class="form-check-input"
                                                       type="checkbox"
                                                       name="Items"
                                                       id="@inputId"
                                                       value="@option.Value"
                                                       @(isChecked ? "checked" : null) />
                                                <label class="form-check-label text-body" for="@inputId">
                                                    @option.Text
                                                </label>
                                            </div>
                                        }
                                    </div>
                                </div>

                                <span class="text-danger small d-block" asp-validation-for="Items"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Footer -->
                <div class="modal-footer border-0" style="background:var(--panel);">
                    <button type="button"
                            class="btn-pr btn-pr-outline"
                            data-bs-dismiss="modal">
                        @L["Cancel"]
                    </button>
                    <button type="submit" class="btn-pr btn-pr-primary">
                        @L["Save"]
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // لو حاب بعد الحفظ تستخدم AJAX وتغلق المودال وتعيد تحميل الجدول:
        // يمكنك في الـ Controller إرجاع JSON success،
        // وهنا تتعامل مع submit بالـ JS وتطلق event: question:upserted
        // حالياً النموذج يشتغل Submit عادي حسب الـ action.

        (() => {
            const dropdownButton = document.getElementById('itemsDropdownButton');
            if (!dropdownButton) return;

            const dropdownLabel = document.getElementById('itemsDropdownLabel');
            const defaultText = dropdownButton.dataset.defaultText?.trim() || dropdownLabel?.textContent?.trim() || '';
            const dropdown = dropdownButton.closest('.dropdown');
            const checkboxes = dropdown ? dropdown.querySelectorAll('input[name="Items"]') : [];

            const refreshLabel = () => {
                const selected = Array.from(checkboxes).filter(cb => cb.checked);
                if (!dropdownLabel) return;

                if (selected.length === 0) {
                    dropdownLabel.textContent = defaultText;
                    return;
                }

                const selectedNames = selected
                    .map(cb => {
                        const label = cb.closest('.form-check')?.querySelector('label');
                        return label ? label.textContent?.trim() : cb.value;
                    })
                    .filter(Boolean);

                const preview = selectedNames.slice(0, 2).join(', ');
                dropdownLabel.textContent = selectedNames.length > 2
                    ? `${preview} +${selectedNames.length - 2}`
                    : preview || defaultText;
            };

            checkboxes.forEach(cb => cb.addEventListener('change', refreshLabel));
            refreshLabel();
        })();
    </script>
}
