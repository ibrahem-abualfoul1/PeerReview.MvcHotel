
@inject Microsoft.Extensions.Localization.IStringLocalizer<PeerReview.MvcHotel.Resources.SharedResource> L
@model System.Collections.Generic.List<PeerReview.MvcHotel.Models.QuestionDto>
@{ ViewData["Title"]=@SharedResource.Questions_Title; }
<div class="d-flex justify-content-between align-items-center mb-2">
  <h3 class="m-0">@SharedResource.Questions_Title</h3>
  <a class="btn btn-gold" href="/Questions/Create">@SharedResource.Questions_Add</a>
</div>
<table class="table table-hover bg-white card-hotel">
  <thead><tr>
    <th>@SharedResource.Questions_Col_Id</th>
    <th>@SharedResource.Questions_Col_Title</th>
    <th>@SharedResource.Questions_Col_Description</th>
    <th>@SharedResource.Questions_Col_Items</th>
    <th>Actions</th>
  </tr></thead>
  <tbody>
  @foreach (var q in Model){
    <tr>
      <td>@q.id</td><td>@q.title</td><td>@q.description</td><td>@(q.items?.Count ?? 0)</td>
      <td>
        <a class="btn btn-sm btn-outline-primary" href="/Questions/Edit/@q.id">@SharedResource.Questions_Action_Edit</a> <a class="btn btn-sm btn-outline-secondary ms-1" href="/Answers/Screen/@q.id">Fill</a>
        <form method="post" action="/Questions/Delete/@q.id" style="display:inline" onsubmit="return confirm('@SharedResource.Confirm_Delete');">
          <button class="btn btn-sm btn-outline-danger">@SharedResource.Questions_Action_Delete</button>
        </form>
      </td>
    </tr>
  }
  </tbody>
</table>
