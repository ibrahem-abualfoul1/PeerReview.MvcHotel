<link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css">
<link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.bootstrap5.min.css">

<div class="card">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="m-0">الأسئلة</h3>
            <button class="btn btn-primary" id="btnAddQuestion">إضافة سؤال</button>
        </div>

        <div id="modalHost"></div>

        <div class="table-responsive-sm">
            <table id="qustions" class="table table-striped nowrap">
                <thead>
                    <tr>
                        <th>العنوان</th>
                        <th>الوصف</th>
                        <th>#</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var q in Model)
                    {
                        <tr>
                            <td>@q.TitleEn</td>
                            <td>@q.DescriptionEn</td>
                            @* <td>@(q.items?.Count ?? 0)</td> *@
                            <td>
                                <button class="btn btn-sm btn-outline-primary" type="button" onclick="openQuestionModal(@q.Id)">تعديل</button>
                                @* <a class="btn btn-sm btn-outline-secondary ms-1" href="/Answers/Screen/@q.id">Fill</a> *@
                                <form method="post" action="/Questions/Delete/@q.Id" style="display:inline" onsubmit="return confirm('@L["Confirm_Delete"]');">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-outline-danger">حذف</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/5.3.3/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/2.3.4/js/dataTables.js"></script>
    <script src="https://cdn.datatables.net/2.3.4/js/dataTables.bootstrap5.js"></script>
    <script src="https://cdn.datatables.net/staterestore/1.4.3/js/dataTables.stateRestore.js"></script>
    <script src="https://cdn.datatables.net/staterestore/1.4.3/js/stateRestore.bootstrap5.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.2.5/js/dataTables.buttons.js"></script>
    <script src=" https://cdn.datatables.net/buttons/3.2.5/js/buttons.bootstrap5.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>

    <!-- Buttons core + Bootstrap adapter -->
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.bootstrap5.min.js"></script>

    <!-- Export dependencies -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>          <!-- Excel -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/pdfmake.min.js"></script>      <!-- PDF -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/vfs_fonts.js"></script>        <!-- PDF fonts -->
    <!-- Buttons for HTML5 export (Copy/Excel/PDF) -->
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>

    <!-- (اختياري) زر الطباعة -->
    <!-- <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.print.min.js"></script> -->
    <script>
        $(function () {
          $('#qustions').DataTable({
            dom: 'Bftip', // أو 'Bfrtip'
            buttons: ['copy', 'excel', 'pdf']
          });
        });

               // فتح المودال (إنشاء)
        function openQuestionModal(id) {
          var url = '@Url.Action("UpsertPartial", "Questions")' + (id ? ('?id=' + id) : '');
          $('#modalHost').load(url, function () {
            var modalEl = document.getElementById('questionUpsertModal');
            var modal = new bootstrap.Modal(modalEl, { backdrop: 'static' });
            modal.show();
          });
        }

        $('#btnAddQuestion').on('click', function () {
            openQuestionModal(null);
        });

        // مثال: ربط زر تحرير في جدولك
        // $(document).on('click','.btn-edit-question', function(){
        //     var id = $(this).data('id');
        //     openQuestionModal(id);
        // });

        // بعد الحفظ: أعد تحميل الداتا/الجدول (DataTable مثلاً)
        $(document).on('question:upserted', function (e, res) {
            // مثال: إعادة تحميل DataTable
            // $('#myTable').DataTable().ajax.reload(null, false);
            // أو تحديث يدوي حسب بنية صفحتك
        });
    </script>
}