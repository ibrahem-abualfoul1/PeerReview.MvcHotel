@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer L
@model System.Collections.Generic.List<PeerReview.MvcHotel.Models.QuestionDto>

@{
    ViewData["Title"] = L["Questions_Title"];
    ViewBag.ActiveMenu = "Questions";
}

@section HeaderActions {
    <button type="button"
            class="btn-pr btn-pr-primary"
            id="btnAddQuestion">
        + @L["Questions_Add"]
    </button>
}

<div class="pr-card mb-3">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div class="h-section-title mb-0">
            @L["Questions_Title"]
        </div>
        <div class="text-muted-soft" style="font-size:0.85rem;">
            @L["Questions_Description"]
        </div>
    </div>

    <div id="modalHost"></div>

    <div class="table-responsive-sm mt-3">
        <table id="qustions" class="pr-table display nowrap" style="width:100%;">
            <thead>
                <tr>
                    <th>@L["Questions_Col_Title"] (@L["Arabic"])</th>
                    <th>@L["Questions_Col_Title"] (@L["English"])</th>
                    <th>@L["Questions_Col_Description"]</th>
                    <th>@L["Questions_Col_Items"]</th>
                    <th>@L["Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var q in Model)
                {
                    <tr>
                        <td>@q.TitleAr</td>
                        <td>@q.TitleEn</td>
                        <td>@q.DescriptionEn</td>
                        <td>@(q.Items?.Count ?? 0)</td>
                        <td class="text-nowrap">
                            <button class="btn-pr btn-pr-sm btn-pr-soft"
                                    type="button"
                                    onclick="openQuestionModal(@q.Id)">
                                @L["Questions_Action_Edit"]
                            </button>

                            @* زر تعبئة (إن حاب ترجع تشغّله)
                            <a class="btn-pr btn-pr-sm btn-pr-outline ms-1"
                               href="/Answers/Screen/@q.Id">
                                Fill
                            </a>
                            *@

                            <form method="post"
                                  action="/Questions/Delete/@q.Id"
                                  
                                  onsubmit="return confirm('@L["Confirm_Delete"]');">
                                @Html.AntiForgeryToken()
                                <button class="btn-pr btn-pr-sm btn-pr-outline">
                                    @L["Questions_Action_Delete"]
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Styles {
    <link rel="stylesheet"
          href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet"
          href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.bootstrap5.min.css" />
}

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>

    <!-- Buttons core + Bootstrap adapter -->
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.bootstrap5.min.js"></script>

    <!-- Export dependencies -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>          <!-- Excel -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/pdfmake.min.js"></script>      <!-- PDF -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/vfs_fonts.js"></script>        <!-- PDF fonts -->
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>
    @* <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.print.min.js"></script> *@

    <script>
        $(function () {
            $('#qustions').DataTable({
                dom: 'Bftip', // Copy / Excel / PDF + filter + table + pager
                buttons: ['copy', 'excel', 'pdf'],
                language: {
                    url: '@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar"
                                                    ? "https://cdn.datatables.net/plug-ins/1.13.8/i18n/ar.json"
                                                    : "https://cdn.datatables.net/plug-ins/1.13.8/i18n/en-GB.json")'
            }
        });
    });

        // فتح المودال (إنشاء / تعديل)
        function openQuestionModal(id) {
            var url = '@Url.Action("UpsertPartial", "Questions")' + (id ? ('?id=' + id) : '');
            $('#modalHost').load(url, function () {
                var modalEl = document.getElementById('questionUpsertModal');
                var modal = new bootstrap.Modal(modalEl, { backdrop: 'static' });
                modal.show();
            });
        }

        // زر إضافة سؤال
        $('#btnAddQuestion').on('click', function () {
            openQuestionModal(null);
        });

        // بعد الحفظ من المودال (تقدر تستخدم هذا الحدث من داخل UpsertPartial)
        $(document).on('question:upserted', function (e, res) {
            // مثال: إعادة تحميل DataTable بدون إعادة تحميل الصفحة كاملة
            var tbl = $('#qustions').DataTable();
            tbl.ajax ? tbl.ajax.reload(null, false) : location.reload();
        });
    </script>
}
