@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer L
@model System.Collections.Generic.List<PeerReview.MvcHotel.Models.QuestionDto>

@{
    ViewData["Title"] = L["Questions_Title"];
    ViewBag.ActiveMenu = "Questions";
}

@section HeaderActions {
    <button type="button"
            class="btn-pr btn-pr-primary"
            id="btnAddQuestion">
        + @L["Questions_Add"]
    </button>
}

<div class="pr-card mb-3">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div class="h-section-title mb-0">
            @L["Questions_Title"]
        </div>
        <div class="text-muted-soft" style="font-size:0.85rem;">
            @L["Questions_Description"]
        </div>
    </div>

    <div id="modalHost"></div>

    <div class="table-responsive-sm mt-3">
        <table id="qustions" class="pr-table display nowrap questions-table" style="width:100%;">
            <thead>
                <tr>
                    <th class="col-title">@L["Questions_Col_Title"] (@L["Arabic"])</th>
                    <th class="col-title">@L["Questions_Col_Title"] (@L["English"])</th>
                    <th class="col-desc">@L["Questions_Col_Description"]</th>
                    <th class="col-count text-center">@L["Questions_Col_Items"]</th>
                    <th>@L["Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var q in Model)
                {
                    <tr>
                        <td class="col-title">
                            <span class="cell-clip" title="@q.TitleAr">@q.TitleAr</span>
                        </td>
                        <td class="col-title">
                            <span class="cell-clip" title="@q.TitleEn">@q.TitleEn</span>
                        </td>
                        <td class="col-desc">
                            <span class="cell-clip" title="@q.DescriptionEn">@q.DescriptionEn</span>
                        </td>
                        <td class="col-count text-center">
                            <span class="pill-badge pill-soft">@(q.Items?.Count ?? 0)</span>
                        </td>
                        <td class="text-nowrap">
                            <button class="btn-pr btn-pr-sm btn-pr-soft"
                                    type="button"
                                    onclick="openQuestionModal(@q.Id)">
                                @L["Questions_Action_Edit"]
                            </button>

                            @* زر تعبئة (إن حاب ترجع تشغّله)
                            <a class="btn-pr btn-pr-sm btn-pr-outline ms-1"
                               href="/Answers/Screen/@q.Id">
                                Fill
                            </a>
                            *@

                            <form method="post"
                                  action="/Questions/Delete/@q.Id"
                                  onsubmit="return confirm('@L["Confirm_Delete"]');">
                                @Html.AntiForgeryToken()
                                <button class="btn-pr btn-pr-sm btn-pr-outline">
                                    @L["Questions_Action_Delete"]
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Styles {
    <style>
        .questions-table .col-title {
            max-width: 240px;
            min-width: 180px;
        }

        .questions-table .col-desc {
            max-width: 320px;
            min-width: 220px;
        }

        .questions-table .col-count {
            width: 120px;
        }

        .questions-table .cell-clip {
            display: inline-block;
            max-width: 100%;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            vertical-align: middle;
        }

        .modal-backdrop.fade.show {
            display: none;
        }
    </style>
}

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <script>


        // ========= JS الخاص بـ المودال و Select_All =========

        // فتح المودال (إنشاء / تعديل)
        function openQuestionModal(id) {
            var url = '@Url.Action("UpsertPartial", "Questions")' + (id ? ('?id=' + id) : '');
            $('#modalHost').load(url, function () {
                var modalEl = document.getElementById('questionUpsertModal');
                var modal = new bootstrap.Modal(modalEl, { backdrop: 'static' });
                modal.show();

                // بعد ما يحمل المودال فعليًا
                if (typeof initQuestionItemsMultiSelect === 'function') {
                    initQuestionItemsMultiSelect();
                }
            });
        }

        // زر إضافة سؤال
        $('#btnAddQuestion').on('click', function () {
            openQuestionModal(null);
        });

        $(document).on('question:upserted', function (e, res) {
            var tbl = $('#qustions').DataTable();
            if (tbl.ajax) {
                tbl.ajax.reload(null, false);
            } else {
                location.reload();
            }
        });

        // ======== من هنا كود Select_All (Vanilla JS + Event Delegation) ========

        (function () {

            function syncHiddenSelect() {
                var selectedValues = [];
                document.querySelectorAll('.item-checkbox:checked').forEach(function (cb) {
                    selectedValues.push(cb.value);
                });

                var select = document.getElementById('Items');
                if (!select) return;

                Array.prototype.forEach.call(select.options, function (o) {
                    o.selected = selectedValues.indexOf(o.value) !== -1;
                });

                var textSpan = document.getElementById('itemsDropdownText');
                if (!textSpan) return;

                if (selectedValues.length === 0) {
                    textSpan.textContent = '@L["Select_Items"]';
                } else if (selectedValues.length === 1) {
                    var lbl = document.querySelector('.item-checkbox:checked + label');
                    textSpan.textContent = lbl ? lbl.textContent.trim() : (selectedValues.length + ' @L["Selected"]');
                } else {
                    textSpan.textContent = selectedValues.length + ' @L["Selected"]';
                }
            }

            function updateSelectAllCheckbox() {
                var all = document.querySelectorAll('.item-checkbox').length;
                var checked = document.querySelectorAll('.item-checkbox:checked').length;
                var selectAll = document.getElementById('itemsSelectAll');
                if (!selectAll) return;
                selectAll.checked = (all > 0 && checked === all);
            }

            // event delegation عشان يشتغل حتى لو المودال انضاف بعدين
            document.addEventListener('change', function (e) {
                if (e.target && e.target.id === 'itemsSelectAll') {
                    var isChecked = e.target.checked;
                    document.querySelectorAll('.item-checkbox').forEach(function (cb) {
                        cb.checked = isChecked;
                    });
                    syncHiddenSelect();
                    return;
                }

                if (e.target && e.target.classList.contains('item-checkbox')) {
                    updateSelectAllCheckbox();
                    syncHiddenSelect();
                    return;
                }
            });

            // نستدعيها لما المودال يخلص تحميل
            window.initQuestionItemsMultiSelect = function () {
                updateSelectAllCheckbox();
                syncHiddenSelect();
            };

        })();
    </script>
}
