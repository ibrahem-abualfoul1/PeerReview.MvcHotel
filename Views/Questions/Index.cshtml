@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer L
@model System.Collections.Generic.List<PeerReview.MvcHotel.Models.QuestionDto>

@{
    ViewData["Title"] = L["Questions_Title"];
    ViewBag.ActiveMenu = "Questions";
}

@section HeaderActions {
    <button type="button"
            class="btn-pr btn-pr-primary"
            id="btnAddQuestion">
        + @L["Questions_Add"]
    </button>
}

<div class="pr-card mb-3">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div class="h-section-title mb-0">
            @L["Questions_Title"]
        </div>
        <div class="text-muted-soft" style="font-size:0.85rem;">
            @L["Questions_Description"]
        </div>
    </div>

    <div id="modalHost"></div>

    <div class="table-responsive-sm mt-3">
        <table id="qustions" class="pr-table table table-hover table-striped align-middle w-100 display nowrap questions-table">
            <thead>
                <tr>
                    <th class="col-title">@L["Questions_Col_Title"] (@L["English"])</th>
                    <th class="col-desc">@L["Questions_Col_Description"]</th>
                    <th class="col-count text-center">@L["Questions_Col_Items"]</th>
                    <th>@L["Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var q in Model)
                {
                    <tr>
                        <td class="col-title">
                            <span class="cell-clip" title="@q.TitleEn">@q.TitleEn</span>
                        </td>
                        <td class="col-desc">
                            <span class="cell-clip" title="@q.DescriptionEn">@q.DescriptionEn</span>
                        </td>
                        <td class="col-count text-center">
                            <span class="pill-badge pill-soft">@(q.CategoryName)</span>
                        </td>
                        <td class="text-nowrap d-flex gap-1">
                            <button class="btn-pr btn-pr-sm btn-pr-soft"
                                    type="button"
                                    onclick="openQuestionModal(@q.Id)">
                                @L["Questions_Action_Edit"]
                            </button>

                            <form method="post"
                                  action="/Questions/Delete/@q.Id"
                                  onsubmit="return confirm('@L["Confirm_Delete"]');">
                                @Html.AntiForgeryToken()
                                <button class="btn-pr btn-pr-sm btn-pr-outline">
                                    @L["Questions_Action_Delete"]
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Styles {
    <style>
        .questions-table .col-title {
            max-width: 240px;
            min-width: 180px;
        }

        .questions-table .col-desc {
            max-width: 320px;
            min-width: 220px;
        }

        .questions-table .col-count {
            width: 120px;
        }

        .questions-table .cell-clip {
            display: inline-block;
            max-width: 100%;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            vertical-align: middle;
        }

        /* لو حابب تلغي الـ backdrop للمودال */
        .modal-backdrop.fade.show {
            display: none;
        }
    </style>
}

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script>
        // فتح المودال (إنشاء / تعديل)
        function openQuestionModal(id) {
            var url = '@Url.Action("UpsertPartial", "Questions")' + (id ? ('?id=' + id) : '');
            $('#modalHost').load(url, function () {
                var modalEl = document.getElementById('questionUpsertModal');
                var modal = new bootstrap.Modal(modalEl, { backdrop: 'static' });
                modal.show();

                // تهيئة الـ multi-select بعد ما المودال يترندر
                if (typeof window.initQuestionItemsMultiSelect === 'function') {
                    window.initQuestionItemsMultiSelect();
                }
            });
        }

        // زر إضافة سؤال
        $('#btnAddQuestion').on('click', function () {
            openQuestionModal(null);
        });

        // لما يخلص الحفظ (لو عندك event من ajax مثلاً)
        $(document).on('question:upserted', function (e, res) {
            var tbl = $('#qustions').DataTable();
            if (tbl.ajax) {
                tbl.ajax.reload(null, false);
            } else {
                location.reload();
            }
        });

        // ============ كود الـ multi-select (يشتغل على المودال المحمَّل ديناميكياً) ============
        window.initQuestionItemsMultiSelect = function () {
            const selectEl = document.getElementById('Items');
            if (!selectEl) return;

            const checkboxes = document.querySelectorAll('.item-checkbox');
            const selectAll = document.getElementById('itemsSelectAll');
            const textSpan = document.getElementById('itemsDropdownText');
            const countBadge = document.getElementById('itemsSelectedCount');

            function syncFromCheckboxes() {
                const selectedValues = [];
                const selectedLabels = [];

                checkboxes.forEach(cb => {
                    const opt = selectEl.querySelector(`option[value="${cb.value}"]`);
                    if (cb.checked) {
                        selectedValues.push(cb.value);
                        selectedLabels.push(cb.nextElementSibling.innerText.trim());
                        if (opt) opt.selected = true;
                    } else if (opt) {
                        opt.selected = false;
                    }
                });

                // تحديث نص الزر والبادج
                if (selectedValues.length === 0) {
                    textSpan.textContent = '@L["Select_Items"]';
                    countBadge.classList.add('d-none');
                } else if (selectedValues.length <= 2) {
                    textSpan.textContent = selectedLabels.join(', ');
                    countBadge.classList.add('d-none');
                } else {
                    textSpan.textContent = '@L["Select_Items"]';
                    countBadge.textContent = selectedValues.length;
                    countBadge.classList.remove('d-none');
                }

                // حالة select all
                if (selectAll) {
                    selectAll.checked = selectedValues.length === checkboxes.length;
                    selectAll.indeterminate =
                        selectedValues.length > 0 && selectedValues.length < checkboxes.length;
                }
            }

            function bindEvents() {
                checkboxes.forEach(cb => cb.addEventListener('change', syncFromCheckboxes));

                if (selectAll) {
                    selectAll.addEventListener('change', function () {
                        checkboxes.forEach(cb => cb.checked = selectAll.checked);
                        syncFromCheckboxes();
                    });
                }
            }

            bindEvents();
            syncFromCheckboxes();
        };
    </script>
}
