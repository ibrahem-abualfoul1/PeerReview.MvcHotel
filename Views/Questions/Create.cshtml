@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer L
@model PeerReview.MvcHotel.Models.QuestionCreateDto

@{
    ViewData["Title"] = L["Questions_Create_Title"];
    ViewBag.ActiveMenu = "Questions";
}

<div class="row justify-content-center">
    <div class="col-xl-7 col-lg-8">
        <div class="pr-card">
            <div class="d-flex justify-content-between align-items-start mb-2 gap-2 flex-wrap">
                <div>
                    <div class="h-section-title mb-0">@L["Questions_Create_Title"]</div>
                    <p class="text-muted-soft mb-0">@L["Questions_Description"]</p>
                </div>
                <span class="pill-badge">@L["Field_Category"]</span>
            </div>

            <form method="post" class="pr-form-grid">
                @Html.AntiForgeryToken()

                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="pr-field">
                            <input asp-for="TitleEn" placeholder=" " required />
                            <label>@L["Field_Title"]</label>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="pr-field">
                            <input asp-for="DescriptionEn" placeholder=" " />
                            <label>@L["Field_Description"]</label>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="pr-field">
                            <input asp-for="CategoryId" type="number" placeholder=" " />
                            <label>@L["Field_Category"]</label>
                        </div>
                    </div>
                </div>

                <div class="pr-form-actions mt-1">
                    <a class="btn-pr btn-pr-outline" href="/Questions">@L["Btn_Back"]</a>
                    <button class="btn-pr btn-pr-primary" type="submit">@L["Btn_Save"]</button>
                </div>
            </form>
        </div>
    </div>
</div>
